// The sidebar's channels with their unread counts: read again when the service says a message or a channel came;
// the open channel is marked read as its messages arrive; the agent a direct message is answered by, chosen; a
// channel made, renamed, closed, archived or deleted.
@stateModel(ChannelsState)
statemanager ChannelsManager
  (channels: ChannelsComponent, events: EventsComponent)
  workspace: string = ""
  open: string = ""

  start(id: string, channel: string)
    workspace = id
    open = channel
    listen(events.watchEvents(workspace), (e) => changed(e))
    read(channel)

  changed(e: ChatEvent)
    if e.workspace == workspace and (e.type == "message" or e.type == "channels" or e.type == "agent.changed")
      if e.channel == open
        read(open)
      else
        load()

  // The user opened a channel: it is read now.
  read(channel: string)
    open = channel
    (~channels.readChannel(workspace, channel)).error((e) => print("warning: #${channel} was not marked read: ${e.message}"))
    load()

  // Who answers a direct message: one of its member's agents and its model (empty: the host's default).
  chooseAgent(channel: string, agent: string, model: string) Result<NuclearChatError, Channel>
    chosen = ~channels.chooseAgent(workspace, channel, AgentChoice(agent = agent, model = model))
    load()
    Ok(chosen)

  // A channel the user makes, with the members they chose.
  create(input: NewChannel) Result<NuclearChatError, Channel>
    ~channels.createChannel(workspace, input)

  // A conversation renamed, its topic changed, closed, archived or opened again.
  change(channel: string, changes: ChannelChanges) Result<NuclearChatError, Channel>
    ~channels.changeChannel(workspace, channel, changes)

  // A conversation deleted: its history moved to `.nuclear/chat/deleted/`.
  deleteChannel(channel: string) Result<NuclearChatError, Channel>
    ~channels.deleteChannel(workspace, channel)

  @state(ChannelsState.ready)
  load() Result<NuclearChatError, Channel[]>
    ~channels.listChannels(workspace)
