// The open channel's messages, read again when the service says one of them came or changed; what the user says,
// sends, edits, deletes, reacts or clicks goes to the service, which tells it back as an event.
@stateModel(MessagesState)
statemanager MessagesManager
  (messages: MessagesComponent, events: EventsComponent)
  workspace: string = ""
  channel: string = ""

  start(id: string)
    workspace = id
    listen(events.watchEvents(workspace), (e) => changed(e))

  changed(e: ChatEvent)
    if e.workspace == workspace and e.type == "message" and e.channel == channel
      load()

  @state(MessagesState.loading)
  loading()

  // The user opened a channel.
  open(id: string)
    channel = id
    loading()
    load()

  @state(MessagesState.ready)
  load() Result<NuclearChatError, Message[]>
    all = ~messages.history(workspace, channel)
    Ok(all.filter((m) => m.thread == null))

  // What the user says: the composer keeps the text when it fails.
  say(text: string, thread: string? = null) Result<NuclearChatError, Message>
    ~messages.say(workspace, channel, Said(text = text, thread = thread))

  sendGif(gif: Gif, thread: string? = null) Result<NuclearChatError, Message>
    ~messages.sendGif(workspace, channel, SentGif(gif = gif, thread = thread))

  // A reaction or a click the service refused is logged: the message shows what the service kept.
  react(message: string, emoji: string)
    (~messages.react(workspace, message, Reaction(emoji = emoji, by = "you"))).error((e) => print("warning: the reaction ${emoji} was not kept: ${e.message}"))

  click(message: string, button: string)
    (~messages.clickButton(workspace, message, Click(button = button))).error((e) => print("warning: the button ${button} was not clicked: ${e.message}"))

  // The user's own message edited: the service keeps a line that names it.
  edit(message: string, text: string) Result<NuclearChatError, Message>
    ~messages.updateMessage(workspace, message, Changes(text = text))

  // A message deleted (the user's or a member's): it shows "deleted", its thread stays.
  deleteMessage(message: string) Result<NuclearChatError, Message>
    ~messages.deleteMessage(workspace, message)
