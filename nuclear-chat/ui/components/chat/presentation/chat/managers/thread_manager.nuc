// The thread beside the channel: its replies, read again when the service says one came.
@stateModel(ThreadState)
statemanager ThreadManager
  (messages: MessagesComponent, events: EventsComponent)
  workspace: string = ""
  channel: string = ""
  root: string = ""

  start(id: string)
    workspace = id
    listen(events.watchEvents(workspace), (e) => changed(e))

  changed(e: ChatEvent)
    if root != "" and e.workspace == workspace and e.type == "message" and e.channel == channel
      load()

  // The user closed the thread.
  hide()
    root = ""
    closed()

  @state(ThreadState.closed)
  closed()

  // The user opened the thread of a message.
  open(inChannel: string, message: string)
    channel = inChannel
    root = message
    load()

  @state(ThreadState.ready)
  load() Result<NuclearChatError, Thread>
    // shortcut: an appcomponent's alias does not propagate a Result yet (the compiler's roadmap): kept and matched
    all: Result<NuclearChatError, Message[]> = ~messages.history(workspace, channel, root)
    match all
      Ok(list) -> thread(list)
      Err(e) -> Err(e)

  thread(list: Message[]) Result<NuclearChatError, Thread>
    first = list.find((m) => m.id == root)
    if first == null
      return Err(NuclearChatError(message = "the thread's message is gone"))
    Ok(Thread(channel = channel, root = first!, replies = list.filter((m) => m.id != root)))
