// The left of the chat: the project with the *New message* pencil, *Jump to…* (Ctrl+K), the members, its channels
// (with + to make one) and its direct messages, each with its unread count; the open one marked. A team's channel
// shows its tech lead. A closed or archived conversation is out of it (but the open one), and so is a direct message
// with a member the host no longer lists (the jump finds it: it is never deleted).
stateless Sidebar(ws: Workspace, channels: Channel[], open: string, texts: Texts, onOpen: (id: string) => void, onFind: (people: boolean) => void, onNewChannel: () => void)
  build() Element
    shown = channels.filter((c) => c.state == "open" or c.id == open)
    rooms = shown.filter((c) => c.kind != "dm")
    dms = sidebarDms(ws, shown, open)
    nav(
      className = "sidebar",
      children = [
        div(className = "ws", children = [span(className = "ws-mark", children = projectName(ws).substring(0, 1).upper()), strong(className = "ws-name", children = projectName(ws)), button(className = "head-button compose", title = texts.get("newMessage"), onClick = () => onFind(false), children = span(className = "icon icon-compose"))]),
        button(className = "jump", onClick = () => onFind(false), children = [span(className = "icon icon-search"), span(className = "jump-label", children = texts.get("jumpTo")), span(className = "kbd", children = "Ctrl K")]),
        div(
          className = "rooms",
          children = [
            button(className = "room", onClick = () => onFind(true), children = [span(className = "icon icon-people"), span(className = "room-name", children = texts.get("people")), span(className = "room-role", children = "${ws.members.count((m) => m.listed)}")]),
            div(className = "section", children = [span(children = texts.get("channels")), button(className = "section-add", title = texts.get("newChannel"), onClick = () => onNewChannel(), children = span(className = "icon icon-plus"))]),
            ...rooms.map((c) => ChannelItem(key = c.id, channel = c, ws = ws, open = c.id == open, onOpen = onOpen)),
            div(className = "section", children = [span(children = texts.get("dms")), button(className = "section-add", title = texts.get("newMessage"), onClick = () => onFind(true), children = span(className = "icon icon-plus"))]),
            ...dms.map((c) => DmItem(key = c.id, channel = c, ws = ws, open = c.id == open, onOpen = onOpen)),
          ],
        ),
      ],
    )

// The direct messages the sidebar lists: those with a listed member (Atlas, the tech leads), and the open one.
sidebarDms(ws: Workspace, channels: Channel[], open: string) Channel[]
  channels.filter((c) => c.kind == "dm" and (c.id == open or dmMember(ws, c)?.listed != false))

// The project's name: the last folder of its root.
projectName(ws: Workspace) string
  parts = ws.root.split("/").filter((p) => p != "")
  parts.length > 0 ? parts.last : ws.id

// The tech lead of a channel's team, or null.
leadOf(ws: Workspace, channel: Channel) Member?
  team = ws.teams.find((t) => t.id == channel.team or t.id == channel.id)
  if team == null
    return null
  ws.members.find((m) => m.id == team!.lead)

// The member of a direct message (`dm-<member>`), or null.
dmMember(ws: Workspace, channel: Channel) Member?
  id = channel.id.startsWith("dm-") ? channel.id.substring(3) : (channel.members.length > 0 ? channel.members.first : "")
  ws.members.find((m) => m.id == id)

// A channel's line: `# name`, its tech lead when it is a team's, its unread count.
stateless ChannelItem(channel: Channel, ws: Workspace, open: boolean, onOpen: (id: string) => void)
  build() Element
    lead = leadOf(ws, channel)
    button(
      className = "room ${open ? "open" : ""} ${channel.unread > 0 ? "unread" : ""}",
      onClick = () => onOpen(channel.id),
      children = [
        span(className = "hash", children = "#"),
        span(className = "room-name", children = channel.name != "" ? channel.name : channel.id),
        lead != null ? span(className = "room-lead", title = lead!.name, children = lead!.name.split(" ").first) : null,
        channel.unread > 0 ? span(className = "badge", children = "${channel.unread}") : null,
      ],
    )

// A direct message's line: the member's picture, name and role, its unread count.
stateless DmItem(channel: Channel, ws: Workspace, open: boolean, onOpen: (id: string) => void)
  build() Element
    member = dmMember(ws, channel)
    name = member?.name ?? (channel.name != "" ? channel.name : channel.id)
    button(
      className = "room dm ${open ? "open" : ""} ${channel.unread > 0 ? "unread" : ""}",
      onClick = () => onOpen(channel.id),
      children = [
        Avatar(member = member, author = member?.id ?? channel.id, size = "small"),
        span(className = "room-name", children = name),
        member != null and member!.role != "" ? span(className = "room-role", children = member!.role) : null,
        channel.unread > 0 ? span(className = "badge", children = "${channel.unread}") : null,
      ],
    )
