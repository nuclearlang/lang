// The text of a message as the chat shows it: paragraphs, headings, rules, tables, fenced code blocks, quotes, lists
// (bulleted, numbered, tasks, nested) and the inline marks
// (`code`, **bold**, *italic*, ~strike~, links, @mentions, #channels, spec: and run: links). Built as elements, never
// as HTML: a member's text cannot reach the page as markup.
stateless Markdown(text: string, onChannel: (id: string) => void)
  build() Element
    div(className = "md", children = blocks(text, onChannel))

// The blocks of a text: what is between ``` fences is code; the rest is paragraphs, quotes and lists.
blocks(text: string, onChannel: (id: string) => void) Element[]
  out: Element[] = []
  parts = text.split("```")
  for i in 0..parts.length
    part = parts[i]
    if i % 2 == 1 and i < parts.length - 1
      out.add(pre(key = "c${i}", className = "md-code", children = fenced(part)))
    else
      out.addAll(lines(part, "${i}", onChannel))
  out

// A fence's code without its first line when that line names the language (```ts).
fenced(part: string) string
  nl = part.indexOf("\n")
  first = nl >= 0 ? part.substring(0, nl).trim() : ""
  body = if nl >= 0 and not (" " in first) and first.length < 20
    part.substring(nl + 1)
  else
    part
  body.trimEnd()

// The blocks between fences, line by line: headings (`# `), rules (`---`), tables (`| a | b |` over `|---|---|`),
// list items (`- `, `* `, `1. `, a task `- [x] `; indented by two spaces, a level deeper), quotes (`> `) and
// paragraphs (their line breaks kept; a blank line ends one).
lines(text: string, prefix: string, onChannel: (id: string) => void) Element[]
  out: Element[] = []
  paragraph: string[] = []
  rows = text.split("\n")
  at = 0
  while at < rows.length
    line = rows[at]
    key = "${prefix}b${at}"
    heading = Regex(r"^\s{0,3}(#{1,4})\s+(.+?)\s*#*\s*$").find(line)
    item = Regex(r"^(\s*)([-*•+]|\d+[.)])\s+(.*)$").find(line)
    table = isRow(line) and at + 1 < rows.length and isRule(rows[at + 1])
    starts = line.trim().isEmpty or heading != null or item != null or table or line.trimStart().startsWith(">") or Regex(r"^\s*(?:-{3,}|\*{3,}|_{3,})\s*$").find(line) != null
    if starts and paragraph.length > 0
      out.add(div(key = "${key}p", className = "md-p", children = inline(paragraph.join("\n"), onChannel)))
      paragraph = []
    if line.trim().isEmpty
      at += 1
    else if heading != null
      level = (heading![1] ?? "#").length
      out.add(div(key = key, className = "md-h md-h${level}", children = inline(heading![2] ?? "", onChannel)))
      at += 1
    else if Regex(r"^\s*(?:-{3,}|\*{3,}|_{3,})\s*$").find(line) != null
      out.add(hr(key = key, className = "md-hr"))
      at += 1
    else if table
      head = cells(line)
      body: string[][] = []
      at += 2
      while at < rows.length and isRow(rows[at])
        body.add(cells(rows[at]))
        at += 1
      out.add(div(key = key, className = "md-table", children = [grid(head, body, key, onChannel)]))
    else if item != null
      indent = (item![1] ?? "").replaceAll("\t", "  ").length
      depth = indent >= 6 ? 3 : indent >= 4 ? 2 : indent >= 2 ? 1 : 0
      marker = item![2] ?? "-"
      rest = item![3] ?? ""
      task = Regex(r"^\[([ xX])\]\s+(.*)$").find(rest)
      kind = task != null ? "md-task" : Regex(r"^\d").find(marker) != null ? "md-ol" : "md-ul"
      done = task != null and (task![1] ?? " ") != " "
      label = task != null ? task![2] ?? "" : rest
      number = kind == "md-ol" ? [span(key = "n", className = "md-n", children = marker.replaceAll(")", "."))] : task != null ? [span(key = "n", className = done ? "md-box on" : "md-box", children = done ? "✓" : "")] : [] as Element[]
      out.add(div(key = key, className = "md-li ${kind} md-d${depth}${done ? " md-done" : ""}", children = [...number, span(key = "t", children = inline(label, onChannel))]))
      at += 1
    else if line.trimStart().startsWith(">")
      out.add(div(key = key, className = "md-quote", children = inline(line.trimStart().substring(1).trimStart(), onChannel)))
      at += 1
    else
      paragraph.add(line)
      at += 1
  if paragraph.length > 0
    out.add(div(key = "${prefix}end", className = "md-p", children = inline(paragraph.join("\n").trim(), onChannel)))
  out

// A table's row: a line that starts with `|`.
isRow(line: string) boolean
  line.trim().startsWith("|") and line.trim().length > 1

// The line under a table's header: only pipes, dashes, colons and spaces (`|---|:--:|`).
isRule(line: string) boolean
  Regex(r"^\s*\|?\s*:?-{2,}:?\s*(?:\|\s*:?-{2,}:?\s*)*\|?\s*$").find(line) != null

// A row's cells, without the outer pipes; a pipe written `\|` stays in its cell.
cells(line: string) string[]
  t = line.trim()
  if t.startsWith("|")
    t = t.substring(1)
  if t.endsWith("|") and not t.endsWith("\\|")
    t = t.substring(0, t.length - 1)
  t.replaceAll("\\|", "\0").split("|").map((c) => c.replaceAll("\0", "|").trim())

// A table: its header and its rows, every row as wide as the header.
grid(head: string[], body: string[][], key: string, onChannel: (id: string) => void) Element
  width = head.length
  table(key = "${key}t", children = [
    thead(key = "h", children = [tr(key = "r", children = (0..width).map((i) => th(key = "c${i}", children = inline(head[i], onChannel))))]),
    tbody(key = "b", children = (0..body.length).map((r) => tr(key = "r${r}", children = (0..width).map((i) => td(key = "c${i}", children = inline(i < body[r].length ? body[r][i] : "", onChannel)))))),
  ])

// The inline marks of a line, each one its element; the text between them as it is.
inline(text: string, onChannel: (id: string) => void) Element[]
  marks = Regex(r"(`[^`\n]+`)|(\*\*[^*\n]+\*\*)|(\*[^*\s][^*\n]*\*)|(_[^_\s][^_\n]*_)|(~~?[^~\n]+~~?)|(\[[^\]\n]+\]\(https?://[^)\s]+\))|(https?://[^\s<>()]+)|((?<![\w@])@[\w.-]*\w)|((?<![\w&#])#[a-z0-9][\w.-]*)|((?<![\w])(?:spec|run):[\w.-]*\w)")
  out: Element[] = []
  at = 0
  for m in marks.findAll(text)
    if m.start > at
      out.add(span(key = "t${at}", children = text.substring(at, m.start)))
    out.add(mark(m, onChannel))
    at = m.end
  if at < text.length
    out.add(span(key = "t${at}", children = text.substring(at)))
  out

// One inline mark as its element.
mark(m: Match, onChannel: (id: string) => void) Element
  t = m.text
  key = "m${m.start}"
  if m[1] != null
    span(key = key, className = "md-inline-code", children = t.substring(1, t.length - 1))
  else if m[2] != null
    strong(key = key, children = t.substring(2, t.length - 2))
  else if m[3] != null or m[4] != null
    em(key = key, children = t.substring(1, t.length - 1))
  else if m[5] != null
    span(key = key, className = "md-strike", children = t.replaceAll("~", ""))
  else if m[6] != null
    close = t.indexOf("](")
    a(key = key, href = t.substring(close + 2, t.length - 1), target = "_blank", rel = "noreferrer", children = t.substring(1, close))
  else if m[7] != null
    a(key = key, href = t, target = "_blank", rel = "noreferrer", children = t)
  else if m[8] != null
    span(key = key, className = "mention", children = t)
  else if m[9] != null
    button(key = key, className = "channel-link", onClick = () => onChannel(t.substring(1)), children = t)
  else
    span(key = key, className = "work-link", children = t)
