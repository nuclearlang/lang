// One message of a channel or a thread, as Slack shows it: the first of a group with the author's picture, name,
// chips and time; the others only their text, their time shown on hover. Its GIF, its buttons (a member's
// question), its reactions, its thread's count, and the actions on hover or focus (quick reactions, reply in thread,
// edit the user's own, delete any after a confirmation). A deleted message says so; its thread stays. `focused`: the
// message a search or a notification opened, lit and scrolled to once.
stateful MessageRow(message: Message, ws: Workspace, texts: Texts, first: boolean, inThread: boolean, onThread: (m: Message) => void, onChannel: (id: string) => void, focused: boolean = false)
  // edit or delete: the step asked on the message
  mode: string = ""
  draft: string = ""
  failed: string = ""

  build() Element
    m = message
    member = memberOf(ws, m.author)
    gone = m.deleted > 0
    div(
      className = "msg ${first ? "first" : "cont"} ${focused ? "focused" : ""} ${gone ? "gone" : ""}",
      ref = (el: any) => seen(el),
      children = [
        div(className = "gutter", children = first ? (member != null ? button(className = "profile-link", title = texts.format("profile.open", { "name": member!.name }), onClick = () => ProfileManager.show(member!.id), children = Avatar(member = member, author = m.author)) : Avatar(member = member, author = m.author, label = authorName(ws, m.author, texts))) : span(className = "hover-time", children = clock(m.at))),
        div(
          className = "body",
          children = [
            first ? MessageMeta(message = m, member = member, ws = ws, texts = texts) : null,
            gone ? span(className = "deleted", children = texts.get("deleted")) : null,
            mode == "edit" ? editor() : (m.text != "" ? Markdown(text = m.text, onChannel = onChannel) : null),
            m.edited > 0 and not gone ? span(className = "edited", children = texts.get("edited")) : null,
            m.gif != null ? GifImage(gif = m.gif!) : null,
            // a host's log folded under its one line (a run's station, a repair): closed until clicked
            m.details != "" ? LogFold(text = m.details, label = texts.get("log")) : null,
            m.buttons.length > 0 ? div(className = "actions", children = m.buttons.map((b) => button(key = b.id, className = "action ${b.style}", onClick = () => MessagesManager.click(m.id, b.id), children = b.label))) : null,
            m.reactions.length > 0 ? Reactions(message = m, ws = ws, texts = texts) : null,
            not inThread and m.replies > 0 ? ThreadSummary(message = m, texts = texts, onThread = onThread) : null,
            mode == "delete" ? confirm() : null,
            failed != "" ? p(className = "failed", children = texts.format("failed", { "error": failed })) : null,
          ],
        ),
        gone or mode != "" ? null : toolbar(),
      ],
    )

  toolbar() Element
    m = message
    div(
      className = "toolbar",
      children = [
        ...quick.map((e) => button(key = e, className = "tool-emoji", title = texts.format("react", { "emoji": e }), onClick = () => MessagesManager.react(m.id, e), children = e)),
        not inThread ? button(className = "tool-reply", title = texts.get("reply"), onClick = () => onThread(m), children = span(className = "icon icon-thread")) : null,
        m.author == "you" and m.text != "" ? button(className = "tool-edit", title = texts.get("editMessage"), onClick = () => step("edit"), children = span(className = "icon icon-edit")) : null,
        button(className = "tool-delete", title = texts.get("deleteMessage"), onClick = () => step("delete"), children = span(className = "icon icon-trash")),
      ],
    )

  // The user's own text, edited in place: Enter saves, Shift+Enter breaks the line, Escape cancels.
  editor() Element
    div(
      className = "edit-box",
      children = [
        textarea(className = "edit-input", autoFocus = true, rows = 2, value = draft, title = texts.get("editMessage"), onChange = (e) => typed(e.target.value), onKeyDown = (e) => editKey(e)),
        div(className = "edit-tools", children = [span(className = "edit-hint", children = texts.get("edit.hint")), button(className = "action", onClick = () => step(""), children = texts.get("cancel")), button(className = "action primary", disabled = draft.trim() == "", onClick = () => save(), children = texts.get("save"))]),
      ],
    )

  // Deleting asks first.
  confirm() Element
    div(className = "confirm", onKeyDown = (e) => confirmKey(e), children = [span(children = texts.get("deleteMessage.confirm")), button(className = "action", autoFocus = true, onClick = () => step(""), children = texts.get("cancel")), button(className = "action danger", onClick = () => remove(), children = texts.get("delete"))])

  // The focused message scrolls into sight once (the same row again does not).
  seen(el: any)
    if focused and el != null and el.dataset.seen != "1"
      el.dataset.seen = "1"
      el.scrollIntoView({ "block": "center" })

  step(next: string)
    setState(() =>
      mode = next
      draft = message.text
      failed = ""
    )

  typed(text: string)
    setState(() =>
      draft = text
    )

  editKey(e: KeyboardEvent)
    if e.key == "Escape"
      e.preventDefault()
      step("")
    else if e.key == "Enter" and not e.shiftKey and not e.nativeEvent.isComposing
      e.preventDefault()
      save()

  confirmKey(e: KeyboardEvent)
    if e.key == "Escape"
      e.preventDefault()
      step("")

  save()
    text = draft.trim()
    if text == "" or text == message.text
      step("")
      return
    done: Result<NuclearChatError, Message> = ~MessagesManager.edit(message.id, text)
    match done
      Ok(m) -> step("")
      Err(e) -> refused(e.message)

  remove()
    done: Result<NuclearChatError, Message> = ~MessagesManager.deleteMessage(message.id)
    match done
      Ok(m) -> step("")
      Err(e) -> refused(e.message)

  refused(why: string)
    setState(() =>
      failed = why
    )

// The reactions the toolbar offers.
quick: string[] = ["👍", "🎉", "👀", "✅", "❤️", "😂"]

// The member who wrote a message, or null (the user, the chat itself).
memberOf(ws: Workspace, author: string) Member?
  ws.members.find((m) => m.id == author)

// The name the chat shows for an author.
authorName(ws: Workspace, author: string, texts: Texts) string
  if author == "you"
    return texts.get("you")
  if author == "system"
    return texts.get("system")
  memberOf(ws, author)?.name ?? author

// Whether a member is the tech lead of a team.
leads(ws: Workspace, member: string) boolean
  ws.teams.any((t) => t.lead == member)

// The first line of a group: name, role, the tech lead's and a paid provider's chips, the time.
stateless MessageMeta(message: Message, member: Member?, ws: Workspace, texts: Texts)
  build() Element
    div(
      className = "meta",
      children = [
        member != null ? button(className = "author profile-link", title = texts.format("profile.open", { "name": member!.name }), onClick = () => ProfileManager.show(member!.id), children = authorName(ws, message.author, texts)) : strong(className = "author", children = authorName(ws, message.author, texts)),
        member != null and member!.role != "" ? span(className = "chip role", children = member!.role) : null,
        member != null and leads(ws, member!.id) ? span(className = "chip lead", children = texts.get("lead")) : null,
        member != null and member!.responder.paid ? span(className = "chip paid", children = texts.get("paid")) : null,
        span(className = "time", title = dayLabel(message.at, texts), children = clock(message.at)),
        message.costUsd != null and message.costUsd! > 0 ? span(className = "cost", children = texts.format("cost", { "usd": message.costUsd!.toFixed(2) })) : null,
      ],
    )

// A message's reactions: each emoji with how many, the user's own marked; clicking one adds or takes away the user's.
stateless Reactions(message: Message, ws: Workspace, texts: Texts)
  build() Element
    div(
      className = "reactions",
      children = message.reactions.keys.map((emoji) =>
        who = message.reactions[emoji] ?? []
        button(
          key = emoji,
          className = "reaction ${"you" in who ? "mine" : ""}",
          title = who.map((w) => authorName(ws, w, texts)).join(", "),
          onClick = () => MessagesManager.react(message.id, emoji),
          children = [span(className = "emoji", children = emoji), span(className = "count", children = "${who.length}")],
        )
      ),
    )

// The thread under a message: how many replies, and when the last one came.
stateless ThreadSummary(message: Message, texts: Texts, onThread: (m: Message) => void)
  build() Element
    count = message.replies == 1 ? texts.get("replies.one") : texts.format("replies.many", { "count": "${message.replies}" })
    button(
      className = "replies",
      onClick = () => onThread(message),
      children = [
        span(className = "icon icon-thread"),
        strong(children = count),
        message.lastReply > 0 ? span(className = "last", children = texts.format("lastReply", { "time": clock(message.lastReply) })) : null,
      ],
    )

// A message's GIF: a drawing of the pack (its SVG, from the pack read once) or a service's image.
stateless GifImage(gif: Gif)
  build() Element
    if not gif.src.startsWith("pack/")
      return img(className = "gif", src = gif.src, alt = gif.title, loading = "lazy")
    PackStateBuilder(
      ready = (pack: PackGif[]) =>
        drawing = pack.find((p) => "pack/${p.file}" == gif.src or p.file == gif.src.substring(5))
        if drawing == null
          span(className = "gif missing", children = gif.title)
        else
          img(className = "gif", src = svgSource(drawing!.svg), alt = gif.title)
      ,
      orElse = () => span(className = "gif loading"),
    )

// An SVG text as an image's source: drawn as an image, its scripts never run.
svgSource(svg: string) string
  "data:image/svg+xml;base64,${svg.toBytes().toBase64()}"

// A host's log under its message, folded: one line to open it, the log in a monospace block below.
// shortcut: no `aria-expanded` (a named argument cannot spell `aria-…`, and the runtime passes props as given); the
// caret says the state to the eye only. Upgrade when Synapsis web maps `ariaExpanded` to `aria-expanded`.
stateful LogFold(text: string, label: string)
  open: boolean = false

  build() Element
    div(
      className = "log ${open ? "open" : ""}",
      children = [
        button(className = "log-toggle", onClick = () => toggle(), children = [span(className = "log-caret", children = open ? "▾" : "▸"), span(children = label)]),
        open ? pre(className = "log-text", children = text) : null,
      ],
    )

  toggle()
    setState(() =>
      open = not open
    )
