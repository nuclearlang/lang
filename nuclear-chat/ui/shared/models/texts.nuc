// Every text the chat's page shows, in English and Spanish, in this one place: the web platform has no translations
// yet (its roadmap); when it has, these keys move to its files. `{name}` in a text is filled by `format`.
Texts
  lang: string = "en"

  get(key: string) string
    table = if lang == "es"
      spanish
    else
      english
    table[key] ?? english[key] ?? key

  format(key: string, values: <string, string>) string
    text = get(key)
    for name, value in values
      text = text.replaceAll("{${name}}", value)
    text

