// The platform this project is written for and the dialect it is built with (ADR-synapsis-0002, ADR-web-0001).
synapsis(platform = "web", dialect = "react")
app(name = "nuclear_chat_ui", title = "Nuclear Chat", description = "Nuclear Chat's page: Slack's shape over the chat service, mounted in a host's page.", version = "0.92.0")

// The chat service (../nuclear_chat): its models and a repository per controller are generated into contracts/.
contracts(nuclear_chat = "../nuclear_chat")
