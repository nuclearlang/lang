// Generated from the contract nuclear_chat 0.88.1 (nuclear contracts). Do not edit: `nuclear contracts update` rewrites it.
// A member of the factory, as its host gives it: who they are, how they speak and how they answer.
Member
  id: string
  name: string
  role: string = ""
  team: string = ""
  // the host's id of the member's portrait (a roster's employee)
  avatar: string = ""
  // the portrait the page draws: a `data:` or `https:` URL (the host reads its file), empty for the initials
  face: string = ""
  profile: Profile
  personality: Personality
  responder: Responder
  // who works the member (an agent and its model), drawn in a direct message's header
  brain: Brain
  // whether the member is one of the chat's people (the members list, #general, a direct message of their own); one not listed still writes in channels and threads and is answered when mentioned, and a direct message kept with them stays readable
  listed: boolean = true
  // the profile's temperament, skills and instructions, and whether the host can change them (none: a host that gives no card, its profile read only)
  card?: Card
