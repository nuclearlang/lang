// Generated from the contract nuclear_chat 0.89.0 (nuclear contracts). Do not edit: `nuclear contracts update` rewrites it.
// What a host registers: the project, its members and teams, the channels it opens, the language, the GIFs and the theme.
NewWorkspace
  // the project's folder (absolute): its chat is kept in `.nuclear/chat/`
  root: string
  // builder or atlas
  host: string
  members: Member[] = []
  teams: Team[] = []
  channels: Channel[] = []
  lang: string = "en"
  // where the GIF picker searches: pack, tenor or giphy (the editor's setting nuclear.chat.gifs)
  gifs: string = "pack"
  // the page's colors: auto (the editor's), light or dark (the editor's setting nuclear.chat.theme)
  theme: string = "auto"
