// Generated from the contract nuclear_chat 0.89.1 (nuclear contracts). Do not edit: `nuclear contracts update` rewrites it.
// The workspaces API: a host registers its project when it starts (again when its members change: an event `workspace`), and reads it back.
@repository(path = "workspaces", connection = "nuclear_chat")
repository WorkspacesRepository
  @post
  register(@body input: NewWorkspace) Result<NuclearChatError, Workspace>

  @get(path = ":id")
  one(id: string) Result<NuclearChatError, Workspace>

  // The page's colors chosen in the chat (auto, light, dark): told to the host as an event `action` (`theme`).
  @put(path = ":id/theme")
  theme(id: string, @body choice: ThemeChoice) Result<NuclearChatError, Workspace>
