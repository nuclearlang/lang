{
  "app": "nuclear_chat",
  "controllers": {
    "ChannelsController": {
      "component": "channels",
      "description": "The channels API: the channels and direct messages of a workspace with their unread counts, a new channel, a channel opened (read), the agent a direct message is answered by.",
      "guards": [],
      "path": "channels",
      "routes": [
        {
          "error": "Error",
          "name": "list",
          "params": [
            {
              "in": "path",
              "name": "workspace",
              "type": "string"
            }
          ],
          "path": "{workspace}",
          "returns": "Channel[]",
          "verb": "get"
        },
        {
          "error": "Error",
          "name": "create",
          "params": [
            {
              "in": "path",
              "name": "workspace",
              "type": "string"
            },
            {
              "in": "body",
              "name": "input",
              "type": "NewChannel"
            }
          ],
          "path": "{workspace}",
          "returns": "Channel",
          "status": 201,
          "verb": "post"
        },
        {
          "error": "Error",
          "name": "read",
          "params": [
            {
              "in": "path",
              "name": "workspace",
              "type": "string"
            },
            {
              "in": "path",
              "name": "channel",
              "type": "string"
            }
          ],
          "path": "{workspace}/{channel}/read",
          "returns": "Channel",
          "verb": "post"
        },
        {
          "error": "Error",
          "name": "chooseAgent",
          "params": [
            {
              "in": "path",
              "name": "workspace",
              "type": "string"
            },
            {
              "in": "path",
              "name": "channel",
              "type": "string"
            },
            {
              "in": "body",
              "name": "input",
              "type": "AgentChoice"
            }
          ],
          "path": "{workspace}/{channel}/agent",
          "returns": "Channel",
          "verb": "put"
        },
        {
          "error": "Error",
          "name": "changeChannel",
          "params": [
            {
              "in": "path",
              "name": "workspace",
              "type": "string"
            },
            {
              "in": "path",
              "name": "channel",
              "type": "string"
            },
            {
              "in": "body",
              "name": "changes",
              "type": "ChannelChanges"
            }
          ],
          "path": "{workspace}/{channel}",
          "returns": "Channel",
          "verb": "patch"
        },
        {
          "error": "Error",
          "name": "deleteChannel",
          "params": [
            {
              "in": "path",
              "name": "workspace",
              "type": "string"
            },
            {
              "in": "path",
              "name": "channel",
              "type": "string"
            }
          ],
          "path": "{workspace}/{channel}",
          "returns": "Channel",
          "verb": "delete"
        }
      ],
      "transports": [
        "http",
        "websocket"
      ]
    },
    "EventsController": {
      "component": "events",
      "description": "The events API: what happened in a workspace after the event `since` (the number of the last one read).",
      "guards": [],
      "path": "events",
      "routes": [
        {
          "error": "Error",
          "name": "since",
          "params": [
            {
              "in": "path",
              "name": "workspace",
              "type": "string"
            },
            {
              "default": 0,
              "in": "query",
              "name": "since",
              "type": "int"
            }
          ],
          "path": "{workspace}",
          "returns": "ChatEvent[]",
          "verb": "get"
        }
      ],
      "transports": [
        "http",
        "websocket"
      ]
    },
    "GifsController": {
      "component": "gifs",
      "description": "The GIFs API: the pack made for the project, the picker's search, the project's one answer.",
      "guards": [],
      "path": "gifs",
      "routes": [
        {
          "error": "Error",
          "name": "pack",
          "params": [],
          "path": "pack",
          "returns": "PackGif[]",
          "verb": "get"
        },
        {
          "error": "Error",
          "name": "search",
          "params": [
            {
              "in": "path",
              "name": "workspace",
              "type": "string"
            },
            {
              "default": "",
              "in": "query",
              "name": "q",
              "type": "string"
            }
          ],
          "path": "{workspace}/search",
          "returns": "GifResults",
          "verb": "get"
        },
        {
          "error": "Error",
          "name": "consent",
          "params": [
            {
              "in": "path",
              "name": "workspace",
              "type": "string"
            },
            {
              "in": "body",
              "name": "consent",
              "type": "Consent"
            }
          ],
          "path": "{workspace}/consent",
          "returns": "Consent",
          "verb": "post"
        }
      ],
      "transports": [
        "http",
        "websocket"
      ]
    },
    "MembersController": {
      "component": "members",
      "description": "The members API: the user's answer to a member's question (an event `ask`), a member changed from their profile.",
      "guards": [],
      "path": "members",
      "routes": [
        {
          "error": "Error",
          "name": "answer",
          "params": [
            {
              "in": "path",
              "name": "workspace",
              "type": "string"
            },
            {
              "in": "body",
              "name": "answer",
              "type": "Answer"
            }
          ],
          "path": "{workspace}/answers",
          "returns": "Answer",
          "verb": "post"
        },
        {
          "description": "A member changed from their profile (name, model, instructions, temperament, GIFs): told to the host as an event `action` (`member`), which applies it and registers the workspace again.",
          "error": "Error",
          "name": "edit",
          "params": [
            {
              "in": "path",
              "name": "workspace",
              "type": "string"
            },
            {
              "in": "path",
              "name": "member",
              "type": "string"
            },
            {
              "in": "body",
              "name": "edit",
              "type": "MemberEdit"
            }
          ],
          "path": "{workspace}/{member}/edit",
          "returns": "ChatEvent",
          "verb": "post"
        }
      ],
      "transports": [
        "http",
        "websocket"
      ]
    },
    "MessagesController": {
      "component": "messages",
      "description": "The messages API: a channel's history (or one thread), what the user says and sends, what a host posts and changes, reactions, buttons and the search.",
      "guards": [],
      "path": "messages",
      "routes": [
        {
          "error": "Error",
          "name": "search",
          "params": [
            {
              "in": "path",
              "name": "workspace",
              "type": "string"
            },
            {
              "in": "query",
              "name": "words",
              "type": "string"
            }
          ],
          "path": "{workspace}/search",
          "returns": "Found[]",
          "verb": "get"
        },
        {
          "error": "Error",
          "name": "history",
          "params": [
            {
              "in": "path",
              "name": "workspace",
              "type": "string"
            },
            {
              "in": "path",
              "name": "channel",
              "type": "string"
            },
            {
              "in": "query",
              "name": "thread",
              "optional": true,
              "type": "string"
            }
          ],
          "path": "{workspace}/{channel}",
          "returns": "Message[]",
          "verb": "get"
        },
        {
          "error": "Error",
          "name": "say",
          "params": [
            {
              "in": "path",
              "name": "workspace",
              "type": "string"
            },
            {
              "in": "path",
              "name": "channel",
              "type": "string"
            },
            {
              "in": "body",
              "name": "said",
              "type": "Said"
            }
          ],
          "path": "{workspace}/{channel}",
          "returns": "Message",
          "status": 201,
          "verb": "post"
        },
        {
          "error": "Error",
          "name": "gif",
          "params": [
            {
              "in": "path",
              "name": "workspace",
              "type": "string"
            },
            {
              "in": "path",
              "name": "channel",
              "type": "string"
            },
            {
              "in": "body",
              "name": "sent",
              "type": "SentGif"
            }
          ],
          "path": "{workspace}/{channel}/gif",
          "returns": "Message",
          "status": 201,
          "verb": "post"
        },
        {
          "error": "Error",
          "name": "hostPost",
          "params": [
            {
              "in": "path",
              "name": "workspace",
              "type": "string"
            },
            {
              "in": "path",
              "name": "channel",
              "type": "string"
            },
            {
              "in": "body",
              "name": "posted",
              "type": "Posted"
            }
          ],
          "path": "{workspace}/{channel}/post",
          "returns": "Message",
          "status": 201,
          "verb": "post"
        },
        {
          "error": "Error",
          "name": "update",
          "params": [
            {
              "in": "path",
              "name": "workspace",
              "type": "string"
            },
            {
              "in": "path",
              "name": "id",
              "type": "string"
            },
            {
              "in": "body",
              "name": "changes",
              "type": "Changes"
            }
          ],
          "path": "{workspace}/message/{id}",
          "returns": "Message",
          "verb": "patch"
        },
        {
          "error": "Error",
          "name": "react",
          "params": [
            {
              "in": "path",
              "name": "workspace",
              "type": "string"
            },
            {
              "in": "path",
              "name": "id",
              "type": "string"
            },
            {
              "in": "body",
              "name": "reaction",
              "type": "Reaction"
            }
          ],
          "path": "{workspace}/message/{id}/reactions",
          "returns": "Message",
          "verb": "post"
        },
        {
          "error": "Error",
          "name": "click",
          "params": [
            {
              "in": "path",
              "name": "workspace",
              "type": "string"
            },
            {
              "in": "path",
              "name": "id",
              "type": "string"
            },
            {
              "in": "body",
              "name": "click",
              "type": "Click"
            }
          ],
          "path": "{workspace}/message/{id}/click",
          "returns": "ChatEvent",
          "verb": "post"
        },
        {
          "error": "Error",
          "name": "deleteMessage",
          "params": [
            {
              "in": "path",
              "name": "workspace",
              "type": "string"
            },
            {
              "in": "path",
              "name": "id",
              "type": "string"
            }
          ],
          "path": "{workspace}/message/{id}",
          "returns": "Message",
          "verb": "delete"
        }
      ],
      "transports": [
        "http",
        "websocket"
      ]
    },
    "WorkspacesController": {
      "component": "workspaces",
      "description": "The workspaces API: a host registers its project when it starts (again when its members change: an event `workspace`), and reads it back.",
      "guards": [],
      "path": "workspaces",
      "routes": [
        {
          "error": "Error",
          "name": "register",
          "params": [
            {
              "in": "body",
              "name": "input",
              "type": "NewWorkspace"
            }
          ],
          "path": "",
          "returns": "Workspace",
          "verb": "post"
        },
        {
          "error": "Error",
          "name": "one",
          "params": [
            {
              "in": "path",
              "name": "id",
              "type": "string"
            }
          ],
          "path": "{id}",
          "returns": "Workspace",
          "verb": "get"
        },
        {
          "description": "The page's colors chosen in the chat (auto, light, dark): told to the host as an event `action` (`theme`).",
          "error": "Error",
          "name": "theme",
          "params": [
            {
              "in": "path",
              "name": "id",
              "type": "string"
            },
            {
              "in": "body",
              "name": "choice",
              "type": "ThemeChoice"
            }
          ],
          "path": "{id}/theme",
          "returns": "Workspace",
          "verb": "put"
        }
      ],
      "transports": [
        "http",
        "websocket"
      ]
    }
  },
  "dialect": "fastapi",
  "env": [
    {
      "client": false,
      "default": "https://api.giphy.com/v1",
      "name": "NUCLEAR_CHAT_GIPHY_URL",
      "required": false,
      "uses": [
        {
          "file": "config/project_config.nuc",
          "line": 11
        }
      ]
    },
    {
      "client": false,
      "default": "https://tenor.googleapis.com/v2",
      "name": "NUCLEAR_CHAT_TENOR_URL",
      "required": false,
      "uses": [
        {
          "file": "config/project_config.nuc",
          "line": 10
        }
      ]
    },
    {
      "client": false,
      "name": "NUCLEAR_CHAT_TOKEN",
      "required": true,
      "uses": [
        {
          "file": "config/project_config.nuc",
          "line": 13
        }
      ]
    }
  ],
  "events": {
    "chat.event": {
      "component": "events",
      "payload": "any"
    }
  },
  "guards": [
    {
      "guard": "noOrigin"
    },
    {
      "guard": "token",
      "header": "X-Chat-Token"
    }
  ],
  "models": {
    "AgentChoice": {
      "description": "The agent a direct message is answered by: a choice of its member (empty: the host's default) and its model.",
      "fields": [
        {
          "default": "",
          "name": "agent",
          "rules": {
            "maxLength": 64
          },
          "type": "string"
        },
        {
          "default": "",
          "name": "model",
          "rules": {
            "maxLength": 200
          },
          "type": "string"
        }
      ],
      "key": null
    },
    "Answer": {
      "description": "The user's answer to a member's question (a responder's `ask`), by the question's id.",
      "fields": [
        {
          "name": "id",
          "rules": {
            "minLength": 1
          },
          "type": "string"
        },
        {
          "name": "answer",
          "rules": {
            "maxLength": 20000
          },
          "type": "string"
        }
      ],
      "key": null
    },
    "Brain": {
      "description": "What answers as a member, as its host gives it, shown under the member's name: the agent, its kind (local, agent, api), its provider and model, and whether it spends money.",
      "fields": [
        {
          "default": "",
          "name": "agent",
          "type": "string"
        },
        {
          "default": "",
          "name": "kind",
          "type": "string"
        },
        {
          "default": "",
          "name": "provider",
          "type": "string"
        },
        {
          "default": "",
          "name": "model",
          "type": "string"
        },
        {
          "default": false,
          "name": "paid",
          "type": "boolean"
        }
      ],
      "key": null
    },
    "Button": {
      "description": "A button under a message (a member's question): clicking it is the host's action.",
      "fields": [
        {
          "name": "id",
          "rules": {
            "minLength": 1
          },
          "type": "string"
        },
        {
          "name": "label",
          "rules": {
            "minLength": 1
          },
          "type": "string"
        },
        {
          "default": "",
          "description": "primary, danger or empty",
          "name": "style",
          "type": "string"
        }
      ],
      "key": null
    },
    "Card": {
      "description": "What a member's profile shows and changes, as its host gives it: their temperament (and the ones to choose from), skills and instructions, and whether the host can change them (a member of a team that is not saved cannot).",
      "fields": [
        {
          "default": false,
          "name": "editable",
          "type": "boolean"
        },
        {
          "default": "",
          "name": "temperament",
          "rules": {
            "maxLength": 64
          },
          "type": "string"
        },
        {
          "default": [],
          "name": "temperaments",
          "type": "Temperament[]"
        },
        {
          "default": [],
          "name": "skills",
          "type": "string[]"
        },
        {
          "default": "",
          "name": "instructions",
          "rules": {
            "maxLength": 20000
          },
          "type": "string"
        }
      ],
      "key": null
    },
    "Changes": {
      "description": "What a host changes of a message it posted: its text, its buttons (a question answered has none).",
      "fields": [
        {
          "name": "text",
          "optional": true,
          "rules": {
            "maxLength": 20000
          },
          "type": "string"
        },
        {
          "name": "buttons",
          "optional": true,
          "type": "Button[]"
        }
      ],
      "key": null
    },
    "Channel": {
      "description": "A channel of the project: `general`, a team's, one the user made, or a direct message (`dm-<member>`).",
      "fields": [
        {
          "name": "id",
          "rules": {
            "pattern": "^[a-z0-9][a-z0-9_.-]{0,79}$"
          },
          "type": "string"
        },
        {
          "default": "",
          "name": "name",
          "type": "string"
        },
        {
          "default": "",
          "name": "topic",
          "type": "string"
        },
        {
          "default": "channel",
          "description": "channel or dm",
          "name": "kind",
          "rules": {
            "pattern": "^(channel|dm)$"
          },
          "type": "string"
        },
        {
          "default": [],
          "name": "members",
          "type": "string[]"
        },
        {
          "default": "",
          "description": "the team the channel is of: its tech lead answers a message without a mention",
          "name": "team",
          "type": "string"
        },
        {
          "default": 0,
          "description": "the time (ms) of the last message the user read",
          "name": "lastRead",
          "type": "int"
        },
        {
          "default": 0,
          "name": "unread",
          "type": "int"
        },
        {
          "default": "",
          "description": "the choice of its member's responder that answers it (a direct message), and its model; empty: the default",
          "name": "agent",
          "type": "string"
        },
        {
          "default": "",
          "name": "model",
          "type": "string"
        },
        {
          "default": "open",
          "description": "open; closed (out of the sidebar until it is opened again or a message comes); archived (read only)",
          "name": "state",
          "rules": {
            "pattern": "^(open|closed|archived)$"
          },
          "type": "string"
        }
      ],
      "key": null
    },
    "ChannelChanges": {
      "description": "What the user changes of a conversation: a channel's name (its id stays: its history is kept by the id) and topic, and its state: open, closed (out of the sidebar until it is opened again or a message comes) or archived (kept, read only, out of the sidebar).",
      "fields": [
        {
          "name": "name",
          "optional": true,
          "rules": {
            "maxLength": 80,
            "minLength": 1
          },
          "type": "string"
        },
        {
          "name": "topic",
          "optional": true,
          "rules": {
            "maxLength": 500
          },
          "type": "string"
        },
        {
          "name": "state",
          "optional": true,
          "rules": {
            "pattern": "^(open|closed|archived)$"
          },
          "type": "string"
        }
      ],
      "key": null
    },
    "ChatEvent": {
      "description": "What happened in a workspace, for whoever shows it: a message (new or changed), the channels, a member typing or using a tool, a member's question, a button clicked or a command for the host (`action`). `n` orders them.",
      "fields": [
        {
          "name": "n",
          "type": "int"
        },
        {
          "name": "workspace",
          "type": "string"
        },
        {
          "description": "message, channels, typing, tool, ask, action, error",
          "name": "type",
          "type": "string"
        },
        {
          "default": "",
          "name": "channel",
          "type": "string"
        },
        {
          "default": {},
          "name": "data",
          "type": "<string, any>"
        },
        {
          "default": 0,
          "name": "at",
          "type": "int"
        }
      ],
      "key": null
    },
    "Choice": {
      "description": "One agent a member's conversation can be answered by, as its host gives it (the dropdown of a direct message): the command the chat runs (with `--model <model>` added when a model is chosen), its models and whether it is on this machine. What each one is, is the host's.",
      "fields": [
        {
          "name": "id",
          "rules": {
            "pattern": "^[A-Za-z0-9][\\w.-]{0,63}$"
          },
          "type": "string"
        },
        {
          "name": "label",
          "rules": {
            "minLength": 1
          },
          "type": "string"
        },
        {
          "default": "",
          "description": "local, agent or api: the page's icon",
          "name": "kind",
          "type": "string"
        },
        {
          "default": [],
          "name": "command",
          "type": "string[]"
        },
        {
          "default": false,
          "name": "paid",
          "type": "boolean"
        },
        {
          "default": [],
          "description": "the models it offers; none: its own default, or one written by hand",
          "name": "models",
          "type": "string[]"
        },
        {
          "default": "",
          "description": "the model it starts with (empty: the agent's own default)",
          "name": "defaultModel",
          "type": "string"
        },
        {
          "default": true,
          "name": "available",
          "type": "boolean"
        },
        {
          "default": "",
          "description": "why it is not available (or what to know about it)",
          "name": "why",
          "type": "string"
        }
      ],
      "key": null
    },
    "Click": {
      "description": "A button of a message clicked.",
      "fields": [
        {
          "name": "button",
          "rules": {
            "minLength": 1
          },
          "type": "string"
        }
      ],
      "key": null
    },
    "Consent": {
      "description": "The project's answer to the one question: may its GIF searches leave the machine?",
      "fields": [
        {
          "name": "online",
          "type": "boolean"
        }
      ],
      "key": null
    },
    "Found": {
      "description": "A message a search found, with its channel.",
      "fields": [
        {
          "name": "channel",
          "type": "string"
        },
        {
          "name": "message",
          "type": "Message"
        }
      ],
      "key": null
    },
    "Gif": {
      "description": "A GIF of a message: a drawing of the pack (`pack/<file>`) or a service's image (its URL).",
      "fields": [
        {
          "name": "src",
          "rules": {
            "maxLength": 2000,
            "minLength": 1
          },
          "type": "string"
        },
        {
          "default": "",
          "name": "title",
          "type": "string"
        },
        {
          "default": "pack",
          "description": "pack, tenor or giphy",
          "name": "source",
          "rules": {
