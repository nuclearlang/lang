// Generated from the contract nuclear_chat 0.80.0 (nuclear contracts). Do not edit: `nuclear contracts update` rewrites it.
// The events API: what happened in a workspace after the event `since` (the number of the last one read).
@repository(path = "events", connection = "nuclear_chat")
repository EventsRepository
  @get(path = ":workspace")
  since(workspace: string, since: int = 0) Result<NuclearChatError, ChatEvent[]>
