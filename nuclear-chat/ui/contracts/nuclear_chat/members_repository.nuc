// Generated from the contract nuclear_chat 0.84.1 (nuclear contracts). Do not edit: `nuclear contracts update` rewrites it.
// The members API: the user's answer to a member's question (an event `ask`).
@repository(path = "members", connection = "nuclear_chat")
repository MembersRepository
  @post(path = ":workspace/answers")
  answer(workspace: string, @body answer: Answer) Result<NuclearChatError, Answer>
