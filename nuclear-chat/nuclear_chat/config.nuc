// The platform this project is written for and the dialect it is built with (ADR-synapsis-0002).
synapsis(platform = "backend", dialect = "fastapi")
app(name = "nuclear_chat", description = "Nuclear Chat: the factory's workplace, its channels, members, threads, reactions and GIFs, as a local service.", version = "0.84.1")

// The optional parts this project uses (nuclear help backend): the events a component publishes, and the app's
// WebSocket, which serves the same controllers and pushes the events to the clients subscribed to them.
plugins(events = true, websocket = true)

// What the chat needs of the machine: its files, the responders' commands, the keyring, the GIF pack (../system,
// typed by defs/).
dependencies(nuclear_chat_system = "../system")

// The environment the tests run with: their own token, never the one the keyring keeps (ADR-synapsis-0010).
testEnv(NUCLEAR_CHAT_TOKEN = "test-chat-token")
