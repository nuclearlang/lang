// The user deletes a conversation: its history is moved to `.nuclear/chat/deleted/` (never destroyed) and the
// channel leaves the workspace; a direct message stays, empty and closed (its member is still in the team).
// `#general` is the whole project's and is never deleted.
usecase DeleteChannel(workspaces: WorkspacesAppComponent, messages: MessagesAppComponent, events: EventsAppComponent)
  exec(workspace: string, channel: string) Result<Error, Channel>
    // shortcut: an appcomponent alias's Result does not propagate yet (nuclearlang roadmap), so it is checked here
    found: Result<Error, Workspace> = workspaces.workspace(workspace)
    if found.isErr
      return Err(found.error)
    ws = found.value
    shown = ws.channel(channel)
    if shown == null
      return Err(NotFound("no channel ${channel} in this workspace"))
    if channel == "general"
      return Err(Invalid("#general is the whole project's: it is never deleted"))
    moved: Result<Error, string> = messages.forgetChannel(ws, channel)
    if moved.isErr
      return Err(moved.error)
    if shown!.kind == "dm"
      shown!.state = "closed"
      shown!.lastRead = 0
      shown!.unread = 0
    else
      ws.channels.remove(shown!)
    workspaces.keepChannels(ws)
    ~events.emit(ws.id, "channels", channel, { "deleted": channel })
    Ok(shown!)
