// The channels and direct messages of a workspace, each with its unread count.
usecase ListChannels(workspaces: WorkspacesAppComponent, messages: MessagesAppComponent)
  exec(workspace: string) Result<Error, Channel[]>
    // shortcut: an appcomponent alias's Result does not propagate yet (nuclearlang roadmap), so it is checked here
    found: Result<Error, Workspace> = workspaces.workspace(workspace)
    if found.isErr
      return Err(found.error)
    ws = found.value
    counts: Result<Error, <string, int>> = messages.unread(ws)
    if counts.isErr
      return Err(counts.error)
    for c in ws.channels
      c.unread = counts.value[c.id] ?? 0
    Ok(ws.channels)
