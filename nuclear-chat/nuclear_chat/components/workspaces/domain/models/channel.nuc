// A channel of the project: `general`, a team's, one the user made, or a direct message (`dm-<member>`).
Channel
  @pattern(r"^[a-z0-9][a-z0-9_.-]{0,79}$")
  id: string
  name: string = ""
  topic: string = ""
  // channel or dm
  @pattern(r"^(channel|dm)$")
  kind: string = "channel"
  members: string[] = []
  // the team the channel is of: its tech lead answers a message without a mention
  team: string = ""
  // the time (ms) of the last message the user read
  lastRead: int = 0
  unread: int = 0
  // the choice of its member's responder that answers it (a direct message), and its model; empty: the default
  agent: string = ""
  model: string = ""
  // open; closed (out of the sidebar until it is opened again or a message comes); archived (read only)
  @pattern(r"^(open|closed|archived)$")
  state: string = "open"
