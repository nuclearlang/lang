// A message of a channel, as the chat shows it: its edits and reactions folded in, and, when it opened a thread, how
// many replies it has and when the last one came.
Message
  id: string
  at: int
  // a member's id, you or system
  author: string
  text: string = ""
  // the message whose thread this one is in
  thread?: string
  gif?: Gif
  // who reacted with each emoji
  reactions: <string, string[]> = {}
  buttons: Button[] = []
  // the factory's work it names: spec, run
  links: <string, string> = {}
  costUsd?: double
  // a log folded under the message, shown closed (an accordion); empty when it has none
  details: string = ""
  // the time of its last edit, 0 when never edited
  edited: int = 0
  // the time it was deleted (its text, GIF, buttons and reactions are gone; its thread stays), 0 when it is not
  deleted: int = 0
  replies: int = 0
  lastReply: int = 0
