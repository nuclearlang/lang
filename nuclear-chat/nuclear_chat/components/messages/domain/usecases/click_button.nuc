// A button of a message clicked: an action for the host (what a button does is the host's).
usecase ClickButton(store: MessageStore, events: EventsAppComponent)
  exec(workspace: string, id: string, click: Click) Result<Error, ChatEvent>
    ws = store.workspace(workspace)
    channel = store.locate(ws, id)
    shown = store.message(ws, channel, id)
    buttons = (shown["buttons"] ?? []) as <string, any>[]
    if not buttons.any((b) => b["id"] == click.button)
      return Err(Invalid("the message ${id} has no button ${click.button}"))
    // shortcut: an appcomponent alias's Result does not propagate yet (nuclearlang roadmap), so it is returned whole
    told: Result<Error, ChatEvent> = ~events.emit(ws.id, "action", channel, { "action": "button", "message": id, "button": click.button })
    told
