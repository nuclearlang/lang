// The platform this project is written for and the dialect it is built with (ADR-synapsis-0002, ADR-web-0001).
synapsis(platform = "web", dialect = "react")
app(name = "tasks_live", description = "Synapsis web example: the tasks of tasks_api over its WebSocket, pushed as they are created; also mounted in a host page.", version = "0.1.0")
