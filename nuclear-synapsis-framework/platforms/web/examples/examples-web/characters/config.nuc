// The platform this project is written for and the dialect it is built with (ADR-synapsis-0002, ADR-web-0001).
synapsis(platform = "web", dialect = "react")

// The project's package.json: synapsis writes build/app/package.json from it (react, react-router, vite,
// vitest and synapsis-web are added by itself).
app(
  name = "characters",
  description = "Synapsis web example: the characters of an API, their state and tests.",
  version = "1.0.0",
)
