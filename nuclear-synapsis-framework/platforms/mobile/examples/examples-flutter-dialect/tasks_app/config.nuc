// A mobile app over the tasks_api backend (examples/examples-backend/tasks_api): its models and the client of its
// routes come from the backend's contract (ADR-synapsis-0006), generated into contracts/tasks_api/ by the build.
synapsis(platform = "mobile", dialect = "flutter")
app(name = "tasks_app", description = "Synapsis example: a client generated from a backend's contract.", version = "1.0.0+1")
contracts(tasks_api = "../../../../backend/examples/examples-backend/tasks_api")
