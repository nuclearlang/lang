// The cases of lodash's own tests and documentation for its Object and Lang categories.
entries(m: <string, int>) string = m.keys.map((k) => "${k}=${m[k]}").join(",")

main() void
  abc = { "a": 1, "b": 2, "c": 3 }
  check("pick", entries(pick(abc, ["a", "c"])), "a=1,c=3")
  check("pick a missing key", entries(pick(abc, ["z", "b"])), "b=2")
  check("pick keeps the order asked", entries(pick(abc, ["c", "a"])), "c=3,a=1")
  check("omit", entries(omit(abc, ["a", "c"])), "b=2")
  check("omit nothing", entries(omit(abc, [])), "a=1,b=2,c=3")
  check("pickBy", entries(pickBy(abc, (v, k) => v > 1)), "b=2,c=3")
  check("pickBy the key", entries(pickBy(abc, (v, k) => k != "b")), "a=1,c=3")
  check("omitBy", entries(omitBy(abc, (v, k) => v > 1)), "a=1")
  check("pick and omit leave the map", entries(abc), "a=1,b=2,c=3")
  check("mapValues", entries(mapValues(abc, (v, k) => v * 10)), "a=10,b=20,c=30")
  texts = mapValues(abc, (v, k) => "${k}${v}")
  check("mapValues to another type", texts.values.join(","), "a1,b2,c3")
  check("mapKeys", entries(mapKeys(abc, (v, k) => "${k}${v}")), "a1=1,b2=2,c3=3")
  flipped = invert({ "a": "1", "b": "2", "c": "1" })
  check("invert", "${flipped["1"]} ${flipped["2"]} ${flipped.length}", "c b 2")
  grouped = invertBy({ "a": "1", "b": "2", "c": "1" })
  check("invertBy", "${grouped["1"]!.join("")} ${grouped["2"]!.join("")}", "ac b")
  check("defaults", entries(defaults({ "a": 1 }, { "b": 2, "a": 3 })), "b=2,a=1")
  check("findKey", "${findKey(abc, (v) => v > 1)} ${findKey(abc, (v) => v > 9)}", "b null")
  check("findLastKey", "${findLastKey(abc, (v) => v > 1)} ${findLastKey(abc, (v) => v > 9)}", "c null")
  pairs = toPairs(abc)
  check("toPairs", pairs.map((p) => "${p.first}${p.second}").join(","), "a1,b2,c3")
  check("fromPairs", entries(fromPairs(pairs.reversed())), "c=3,b=2,a=1")
  check("pathKeys", pathKeys("a[0].b.c").join("|"), "a|0|b|c")
  data: <string, any> = { "a": [{ "b": { "c": 3 } }], "n": null, "zero": 0, "text": "" }
  check("get", "${get(data, "a[0].b.c")}", "3")
  check("get with dots only", "${get(data, "a.0.b.c")}", "3")
  check("get a missing path", "${get(data, "a.b.c", "default")}", "default")
  check("get past the list", "${get(data, "a[5].b", "none")} ${get(data, "a[-1]", "none")}", "none none")
  check("get through a value", "${get(data, "zero.x", "none")}", "none")
  check("get a null", "${get(data, "n", "was null")} ${get(data, "n")}", "was null null")
  check("get a falsy value", "${get(data, "zero", 9)} [${get(data, "text", "x")}]", "0 []")
  check("has", "${has(data, "a[0].b.c")} ${has(data, "a[0].b.z")} ${has(data, "n")} ${has(data, "a[1]")} ${has(data, "zero.x")}", "true false true false false")
  made: <string, any> = { "a": { "x": 1 } }
  set(made, "a.b.c", 4)
  set(made, "top", "t")
  check("set", Json.encode(made), "{\"a\":{\"x\":1,\"b\":{\"c\":4}},\"top\":\"t\"}")
  set(made, "a.x.y", 2)
  check("set through a value", Json.encode(made), "{\"a\":{\"x\":{\"y\":2},\"b\":{\"c\":4}},\"top\":\"t\"}")
  check("set returns the map", "${get(set(made, "k", 1), "k")}", "1")
  check("unset", "${unset(made, "a.b.c")} ${unset(made, "a.b.c")} ${unset(made, "no.path")} ${Json.encode(made)}", "true false false {\"a\":{\"x\":{\"y\":2},\"b\":{}},\"top\":\"t\",\"k\":1}")
  original: <string, any> = { "list": [1, { "deep": [2] }], "name": "n" }
  copy: <string, any> = cloneDeep(original)
  set(copy, "name", "changed")
  deep: any[] = get(copy, "list[1].deep")
  deep.add(3)
  check("cloneDeep", "${Json.encode(original)} ${Json.encode(copy)}", "{\"list\":[1,{\"deep\":[2]}],\"name\":\"n\"} {\"list\":[1,{\"deep\":[2,3]}],\"name\":\"changed\"}")
  check("cloneDeep of a value", "${cloneDeep(7)} ${cloneDeep("x")} ${cloneDeep(null)}", "7 x null")
  target: <string, any> = { "a": { "x": 1, "y": 1 }, "list": [1], "keep": true }
  source: <string, any> = { "a": { "y": 2, "z": { "w": 3 } }, "list": [9, 8], "b": "new" }
  merge(target, source)
  check("merge", Json.encode(target), "{\"a\":{\"x\":1,\"y\":2,\"z\":{\"w\":3}},\"list\":[9,8],\"keep\":true,\"b\":\"new\"}")
  set(source, "a.z.w", 99)
  check("merge copies what it takes", "${get(target, "a.z.w")}", "3")
