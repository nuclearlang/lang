// The cases of lodash's own tests and documentation for its Array category, as far as they apply to Nuclear.
Item(id: int, name: string)

names(xs: Item[]) string = xs.map((i) => i.name).join(",")

main() void
  check("chunk even", groups(chunk([1, 2, 3, 4], 2)), "[1,2][3,4]")
  check("chunk remainder", groups(chunk([0, 1, 2, 3, 4, 5], 4)), "[0,1,2,3][4,5]")
  check("chunk larger than the list", groups(chunk([1, 2], 5)), "[1,2]")
  check("chunk of nothing", "${chunk<int>([], 3).length}", "0")
  check("chunk size below one", "${chunk([1, 2], 0).length}", "0")
  some: int?[] = [0, null, 1, null, 2]
  check("compact", ints(compact(some)), "0,1,2")
  check("difference", ints(difference([2, 1], [2, 3])), "1")
  check("difference keeps order and repeats", ints(difference([1, 2, 1, 3, 1], [2])), "1,1,3,1")
  check("difference of nothing", ints(difference([1, 2], [])), "1,2")
  items = [Item(1, "a"), Item(2, "b"), Item(3, "c")]
  check("differenceBy", names(differenceBy(items, [Item(9, "b")], (i) => i.name)), "a,c")
  check("differenceWith", names(differenceWith(items, [Item(2, "x")], (a, b) => a.id == b.id)), "a,c")
  check("dropRight", ints(dropRight([1, 2, 3])), "1,2")
  check("dropRight two", ints(dropRight([1, 2, 3], 2)), "1")
  check("dropRight more than the list", ints(dropRight([1, 2, 3], 5)), "")
  check("dropRight none", ints(dropRight([1, 2, 3], 0)), "1,2,3")
  check("dropWhile", ints(dropWhile([1, 2, 3, 1], (x) => x < 3)), "3,1")
  check("dropRightWhile", ints(dropRightWhile([1, 2, 3, 4], (x) => x > 2)), "1,2")
  check("takeWhile", ints(takeWhile([1, 2, 3, 1], (x) => x < 3)), "1,2")
  check("takeRight", ints(takeRight([1, 2, 3])), "3")
  check("takeRight two", ints(takeRight([1, 2, 3], 2)), "2,3")
  check("takeRight more than the list", ints(takeRight([1, 2, 3], 5)), "1,2,3")
  check("takeRight none", ints(takeRight([1, 2, 3], 0)), "")
  check("takeRightWhile", ints(takeRightWhile([1, 2, 3, 4], (x) => x > 2)), "3,4")
  check("fill all", ints(fill([1, 2, 3], 9)), "9,9,9")
  check("fill a range", ints(fill([4, 6, 8, 10], 0, 1, 3)), "4,0,0,10")
  filled = [1, 2, 3]
  fill(filled, 7, 2)
  check("fill in place", ints(filled), "1,2,7")
  check("findLastIndex", "${findLastIndex([1, 2, 3, 4], (x) => x % 2 == 1)}", "2")
  check("findLastIndex none", "${findLastIndex([1, 2], (x) => x > 5)}", "-1")
  check("findLast", "${findLast([1, 2, 3, 4], (x) => x % 2 == 1)}", "3")
  check("findLast none", "${findLast([1, 2], (x) => x > 5)}", "null")
  check("initial", ints(initial([1, 2, 3])), "1,2")
  check("initial of nothing", ints(initial([])), "")
  check("tail", ints(tail([1, 2, 3])), "2,3")
  check("tail of nothing", ints(tail([])), "")
  check("nth", "${nth([10, 20, 30], 1)}", "20")
  check("nth from the end", "${nth([10, 20, 30], -2)}", "20")
  check("nth out of the list", "${nth([10, 20, 30], 3)} ${nth([10, 20, 30], -4)}", "null null")
  check("intersection", ints(intersection([2, 1], [2, 3])), "2")
  check("intersection once each", ints(intersection([1, 1, 2, 3], [3, 1, 1])), "1,3")
  check("intersectionBy", names(intersectionBy(items, [Item(7, "c"), Item(8, "a")], (i) => i.name)), "a,c")
  check("intersectionWith", names(intersectionWith(items, [Item(3, "z")], (a, b) => a.id == b.id)), "c")
  check("union", ints(union([2], [1, 2])), "2,1")
  check("union once each", ints(union([1, 1, 2], [2, 3, 3])), "1,2,3")
  check("unionBy", names(unionBy(items, [Item(5, "a"), Item(6, "d")], (i) => i.name)), "a,b,c,d")
  check("unionWith", names(unionWith(items, [Item(1, "q"), Item(4, "d")], (a, b) => a.id == b.id)), "a,b,c,d")
  check("uniqBy", names(uniqBy([Item(1, "a"), Item(2, "a"), Item(3, "b")], (i) => i.name)), "a,b")
  check("uniqBy keeps the first", "${uniqBy([Item(1, "a"), Item(2, "a")], (i) => i.name)[0].id}", "1")
  check("uniqWith", ints(uniqWith([1, 2, 11, 3, 12], (a, b) => a % 10 == b % 10)), "1,2,3")
  check("xor", ints(xor([2, 1], [2, 3])), "1,3")
  check("xor once each", ints(xor([1, 1, 2], [2, 3, 3])), "1,3")
  check("xorBy", names(xorBy(items, [Item(9, "a"), Item(8, "z")], (i) => i.name)), "b,c,z")
  check("without", ints(without([2, 1, 2, 3], [1, 2])), "3")
  pulled = [1, 2, 3, 1, 2, 3]
  check("pull returns the list", ints(pull(pulled, [2, 3])), "1,1")
  check("pull in place", ints(pulled), "1,1")
  at = [5, 10, 15, 20]
  check("pullAt", ints(pullAt(at, [1, 3])), "10,20")
  check("pullAt in place", ints(at), "5,15")
  order = [5, 10, 15, 20]
  check("pullAt keeps the order asked", ints(pullAt(order, [3, 0])), "20,5")
  check("pullAt out of the list", ints(pullAt([1, 2], [5, -1])), "")
  evens = [1, 2, 3, 4]
  check("remove", ints(remove(evens, (x) => x % 2 == 0)), "2,4")
  check("remove in place", ints(evens), "1,3")
  check("sortedIndex", "${sortedIndex([30, 50], 40)}", "1")
  check("sortedIndex of an equal value", "${sortedIndex([4, 5, 5, 5, 6], 5)}", "1")
  check("sortedIndex past the end", "${sortedIndex([1, 2], 9)} ${sortedIndex([], 9)}", "2 0")
  check("sortedLastIndex", "${sortedLastIndex([4, 5, 5, 5, 6], 5)}", "4")
  check("sortedIndexBy", "${sortedIndexBy([Item(4, "a"), Item(8, "b")], Item(5, "x"), (i) => i.id.toDouble())}", "1")
  check("sortedIndexOf", "${sortedIndexOf([4, 5, 5, 5, 6], 5)} ${sortedIndexOf([4, 6], 5)}", "1 -1")
  check("sortedUniq", ints(sortedUniq([1, 1, 2, 2, 2, 3])), "1,2,3")
  pairs = zip(["a", "b", "c"], [1, 2])
  check("zip", pairs.map((p) => "${p.first}${p.second}").join(","), "a1,b2")
  back = unzip(pairs)
  check("unzip", "${back.first.join("")} ${ints(back.second)}", "ab 1,2")
  check("zipWith", ints(zipWith([1, 2], [10, 20], (a, b) => a + b)), "11,22")
  made = zipObject(["a", "b"], [1, 2])
  check("zipObject", "${made["a"]} ${made["b"]} ${made.length}", "1 2 2")
  check("zipObject of fewer values", "${zipObject(["a", "b"], [1]).keys.join(",")}", "a")
