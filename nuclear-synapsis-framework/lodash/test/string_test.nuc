// The cases of lodash's own tests and documentation for its String category.
main() void
  check("words", words("fred, barney, & pebbles").join("|"), "fred|barney|pebbles")
  check("words of a camel case text", words("fooBarBaz").join("|"), "foo|Bar|Baz")
  check("words of nothing", "${words("").length} ${words("  --  ").length}", "0 0")
  check("words keep digits", words("item 42 x9").join("|"), "item|42|x9")
  for text in ["Foo Bar", "--foo-bar--", "__FOO_BAR__", "fooBar", "foo bar"]
    check("camelCase ${text}", camelCase(text), "fooBar")
    check("kebabCase ${text}", kebabCase(text), "foo-bar")
    check("snakeCase ${text}", snakeCase(text), "foo_bar")
    check("lowerCase ${text}", lowerCase(text), "foo bar")
    check("upperCase ${text}", upperCase(text), "FOO BAR")
  check("camelCase of nothing", "[${camelCase("")}]", "[]")
  check("startCase", "${startCase("--foo-bar--")}|${startCase("fooBar")}|${startCase("__FOO_BAR__")}", "Foo Bar|Foo Bar|FOO BAR")
  check("capitalize", "${capitalize("FRED")} ${capitalize("fred")} [${capitalize("")}]", "Fred Fred []")
  check("upperFirst", "${upperFirst("fred")} ${upperFirst("FRED")} [${upperFirst("")}]", "Fred FRED []")
  check("lowerFirst", "${lowerFirst("Fred")} ${lowerFirst("FRED")} [${lowerFirst("")}]", "fred fRED []")
  long = "hi-diddly-ho there, neighborino"
  check("truncate", truncate(long), "hi-diddly-ho there, neighbo...")
  check("truncate to a length", truncate(long, 24), "hi-diddly-ho there, n...")
  check("truncate with an omission", truncate(long, 24, " [...]"), "hi-diddly-ho there [...]")
  check("truncate a short text", truncate("short"), "short")
  check("truncate to the text's length", truncate("12345", 5), "12345")
  check("truncate shorter than the omission", truncate("abcdef", 2), "...")
  check("pad", "[${pad("abc", 8)}]", "[  abc   ]")
  check("pad with a fill", pad("abc", 8, "_-"), "_-abc_-_")
  check("pad a long text", pad("abc", 3), "abc")
  check("pad with nothing", pad("abc", 6, ""), "abc")
  check("escape", escape("fred, barney, & pebbles"), "fred, barney, &amp; pebbles")
  check("escape every character", escape("<a href=\"x\">it's</a>"), "&lt;a href=&quot;x&quot;&gt;it&#39;s&lt;/a&gt;")
  check("escape an escaped text", escape("&amp;"), "&amp;amp;")
  check("unescape", unescape("fred, barney, &amp; pebbles"), "fred, barney, & pebbles")
  check("unescape is the opposite of escape", unescape(escape("<b>'&\"</b>")), "<b>'&\"</b>")
  check("unescape once", unescape("&amp;lt;"), "&lt;")
  check("escapeRegExp", escapeRegExp("[lodash](https://lodash.com/)"), "\\[lodash\\]\\(https://lodash\\.com/\\)")
  check("escapeRegExp every character", escapeRegExp("^\$.*+?()[]{}|\\"), "\\^\\\$\\.\\*\\+\\?\\(\\)\\[\\]\\{\\}\\|\\\\")
  check("an escaped text matches itself", "${Regex(escapeRegExp("a.b*c")).test("a.b*c")} ${Regex(escapeRegExp("a.b*c")).test("aXbbc")}", "true false")
  check("trimChars", trimChars("-_-abc-_-", "_-"), "abc")
  check("trimCharsStart", trimCharsStart("-_-abc-_-", "_-"), "abc-_-")
  check("trimCharsEnd", trimCharsEnd("-_-abc-_-", "_-"), "-_-abc")
  check("trimChars of only those characters", "[${trimChars("----", "-")}]", "[]")
