[
  {
    "label": "Nuclear: generated code of $ZED_FILENAME",
    "command": "nuclear",
    "args": [
      "build",
      "$ZED_FILE",
      "--dialect",
      "flutter"
    ],
    "use_new_terminal": false,
    "reveal": "always"
  },
  {
    "label": "Nuclear: check $ZED_FILENAME",
    "command": "nuclear",
    "args": [
      "check",
      "$ZED_FILE",
      "--dialect",
      "flutter"
    ],
    "reveal": "always"
  },
  {
    "label": "Synapsis: run (r = hot reload, R = hot restart)",
    "command": "nuclear",
    "args": [
      "run"
    ],
    "cwd": "$ZED_DIRNAME",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": [
      "synapsis-main"
    ]
  },
  {
    "label": "Synapsis: device (own window, like an emulator)",
    "command": "nuclear",
    "args": [
      "device"
    ],
    "cwd": "$ZED_DIRNAME",
    "use_new_terminal": true,
    "reveal": "always",
    "tags": [
      "synapsis-main"
    ]
  },
  {
    "label": "Synapsis: terminal device (inside this terminal)",
    "command": "nuclear",
    "args": [
      "terminal-device"
    ],
    "cwd": "$ZED_DIRNAME",
    "use_new_terminal": true,
    "reveal": "always",
    "tags": [
      "synapsis-main"
    ]
  },
  {
    "label": "Synapsis: test \"$ZED_CUSTOM_test_name\"",
    "command": "nuclear",
    "args": [
      "test",
      "--",
      "--plain-name",
      "$ZED_CUSTOM_test_name"
    ],
    "cwd": "$ZED_DIRNAME",
    "reveal": "always",
    "tags": [
      "synapsis-test"
    ]
  },
  {
    "label": "Synapsis: build",
    "command": "nuclear",
    "args": [
      "build"
    ],
    "cwd": "$ZED_DIRNAME",
    "reveal": "always"
  },
  {
    "label": "Synapsis: watch (build on every save)",
    "command": "nuclear",
    "args": [
      "watch"
    ],
    "cwd": "$ZED_DIRNAME",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "never"
  },
  {
    "label": "Synapsis: test",
    "command": "nuclear",
    "args": [
      "test"
    ],
    "cwd": "$ZED_DIRNAME",
    "reveal": "always",
    "tags": [
      "synapsis-test"
    ]
  },
  {
    "label": "Synapsis: analyze",
    "command": "nuclear",
    "args": [
      "analyze"
    ],
    "cwd": "$ZED_DIRNAME",
    "reveal": "always"
  },
  {
    "label": "Synapsis: repair",
    "command": "nuclear",
    "args": [
      "repair"
    ],
    "cwd": "$ZED_DIRNAME",
    "reveal": "always"
  },
  {
    "label": "Synapsis: explain the error in the clipboard",
    "command": "sh",
    "args": [
      "-c",
      "(wl-paste 2>/dev/null || xclip -o -selection clipboard 2>/dev/null) | nuclear explain"
    ],
    "cwd": "$ZED_DIRNAME",
    "reveal": "always"
  }
]
