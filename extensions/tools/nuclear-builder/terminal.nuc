use os
use sys
use json

// What every command of `nuclear-builder` shares in a terminal: its options, a question, a JSON answer.

// `--name value` of the arguments, or null.
option(args: string[], name: string) string?
  at = args.indexOf(name)
  at >= 0 and at + 1 < args.length ? args[at + 1] : null

// Every `--name value` of the arguments (a repeatable option), in order.
options(args: string[], name: string) string[]
  found: string[] = []
  for i in 0..args.length - 1
    if args[i] == name
      found.add(args[i + 1])
  found

// A question in the terminal; without one (or with no answer) the fallback.
ask(question: string, fallback: string) string
  if not sys.stdin.isatty()
    return fallback
  try
    answer = input(question).trim()
    answer.length > 0 ? answer : fallback
  catch e
    if not isinstance(e, EOFError)
      throw e
    fallback

// Text in one of `nuclear`'s colors (its header, tools/cli/src/framework/landing.rs): `yellow`, `purple`, `green`,
// `red`, `bold` or `dim`. Only on a terminal and without NO_COLOR; 24-bit where the terminal says so (COLORTERM),
// else the closest of the 256 (macOS Terminal).
paint(text: string, color: string) string
  if not sys.stdout.isatty() or (os.environ.get("NO_COLOR") ?? "").length > 0 or (os.environ.get("TERM") ?? "dumb") == "dumb"
    return text
  deep = (os.environ.get("COLORTERM") ?? "") in ["truecolor", "24bit"]
  code = match color
    "yellow" -> deep ? "38;2;253;216;63" : "38;5;220"
    "purple" -> deep ? "38;2;176;84;255" : "38;5;135"
    "green" -> deep ? "38;2;120;230;150" : "38;5;114"
    "red" -> deep ? "38;2;255;95;95" : "38;5;203"
    "bold" -> "1"
    "dim" -> "2"
    _ -> "0"
  "\u{1b}[${code}m${text}\u{1b}[0m"

yes(answer: string) boolean
  answer.lower().startsWith("y")

// Prints a value as the editors read it.
printJson(value: any) void
  print(json.dumps(value, indent = 1, ensureAscii = false))
