use json
use pathlib{ Path }

// The OpenCode adapter (`opencode run`, its flags checked against OpenCode 2.2.7's `--help`: `--standalone`, `--agent`, `--format
// json`, `--model provider/model`, `--auto`). The role is rendered as OpenCode's own agent, `.opencode/agent/<role>.md`
// in the run's temporary folder (`OPENCODE_CONFIG_DIR`), and the configuration there (`OPENCODE_CONFIG`) gives the
// Nuclear MCP server and the Builder's (`nuclear_builder`) and denies the shell (commands are data: `.nuclear/builder.json`). OpenCode brings its own
// login; the cost and the tokens are the sums of what its steps report. The lines of `--format json` were read from OpenCode's
// documentation, not yet from a real run (no paid call was made).

// What an agent of the factory may do in OpenCode: no shell (commands are data), its edits; and none of OpenCode's own
// tools the factory does not use (spec 025: each one is in every request): its skills (the role's are in its text),
// the web (the MCP server's `web_search` and `web_read` are the oracle's), images, subagents and questions (the
// factory asks the user itself).
OPENCODE_PERMISSION: <string, string> = { "bash": "deny", "edit": "allow", "skill": "deny", "websearch": "deny", "webfetch": "deny", "experimental_image_generate": "deny", "subagent": "deny", "question": "deny" }

renderOpenCode(role: Role, work: Work, at: Path) <string, string>
  dir = at.joinpath(".opencode")
  dir.joinpath("agent").mkdir(parents = true)
  dir.joinpath("agent", "${role.id}.md").writeText("---\ndescription: The ${role.title} of the software factory\nmode: primary\npermission:\n  bash: deny\n  edit: allow\n---\n\n${role.text()}\n")
  config = at.joinpath("opencode.json")
  config.writeText(json.dumps({ "$schema": "https://opencode.ai/config.json", "mcp": { "nuclear": { "type": "local", "command": [work.mcpCommand, ...nuclearMcpArgs(work)], "enabled": true }, "nuclear_builder": { "type": "local", "command": [builderMcpCommand(), ...builderMcpArgs(work)], "enabled": true } }, "permission": OPENCODE_PERMISSION }, indent = 2))
  env = toolEnv()
  env["OPENCODE_CONFIG"] = "${config}"
  env["OPENCODE_CONFIG_DIR"] = "${dir}"
  // never the user's own agent files (`~/.claude/CLAUDE.md`, its skills): only the installation's and the project's
  // context reaches the model (root rule 14, spec 025)
  env["OPENCODE_DISABLE_CLAUDE_CODE"] = "1"
  env

openCodeArgs(role: Role, prompt: string, work: Work) string[]
  // `--standalone`: a private server that reads this run's configuration (OPENCODE_CONFIG, OPENCODE_CONFIG_DIR); the
  // background service OpenCode 2.2 connects to by default reads its own, and answers `Agent not found` for the role
  args = ["opencode", "run", "--standalone", "--agent", role.id, "--format", "json", "--auto"]
  if work.model.length > 0
    args.addAll(["--model", work.model])
  [...args, prompt]

// One line of `--format json`: a text, a tool call (with its state when it ended), the end of a step with its cost.
openCodeLine(ev: <string, any>, emit: (e: <string, any>) => void, found: <string, any>) void
  part: <string, any> = ev["part"] ?? ({} as <string, any>)
  kind = "${ev["type"] ?? part["type"] ?? ""}"
  if kind == "text"
    found["text"] = part["text"] ?? ""
    emit({ "type": "text", "text": found["text"] })
  else if kind == "tool_use" or kind == "tool"
    state: <string, any> = part["state"] ?? ({} as <string, any>)
    emit({ "type": "tool", "id": part["callID"] ?? part["id"], "tool": "${part["tool"] ?? ""}".replace("nuclear_builder_", "").replace("nuclear_", ""), "input": json.dumps(state["input"] ?? {}).substring(0, 4000) })
    if state["status"] == "completed" or state["status"] == "error"
      emit({ "type": "tool-result", "id": part["callID"] ?? part["id"], "ok": state["status"] == "completed", "text": "${state["output"] ?? state["error"] ?? ""}".substring(0, 20000) })
  else if kind == "step_finish" or kind == "step-finish"
    cost: double = part["cost"] ?? 0
    // one step of OpenCode is one turn of the model
    addTokens(found, "turns", 1)
    found["cost"] = (found["cost"] as double) + cost
    // its tokens: the input with the cache's, the output with the reasoning's
    tokens: <string, any> = part["tokens"] ?? ({} as <string, any>)
    cache: <string, any> = tokens["cache"] ?? ({} as <string, any>)
    for n in [tokens["input"], cache["read"], cache["write"]]
      addTokens(found, "inTokens", n)
    for n in [tokens["output"], tokens["reasoning"]]
      addTokens(found, "outTokens", n)
    emit({ "type": "cost", "usd": cost })
  else if kind == "error"
    found["failed"] = true
    found["text"] = json.dumps(ev["error"] ?? ev)

openCodeAdapter(role: Role, station: string, work: Work, emit: (e: <string, any>) => void) Outcome
  at = renderDir("opencode")
  events: <string, any>[] = []
  found: <string, any> = { "text": "", "cost": 0.0, "failed": false }
  say = (e: <string, any>) =>
    events.add(e)
    emit(e)
  try
    env = renderOpenCode(role, work, at)
    ran = streamCommand(openCodeArgs(role, stationPrompt(role, station, work, false), work), work.root, env, (line) => onOpenCodeLine(line, say, found), work.timeoutMs)
    agentOutcome("OpenCode", ran, found, events, work)
  finally
    dropRenderDir(at)

onOpenCodeLine(line: string, emit: (e: <string, any>) => void, found: <string, any>) void
  ev = jsonLine(line)
  if ev != null
    openCodeLine(ev!, emit, found)

// The model the local kind's OpenCode (`opencode-local`) runs: the member's, as OpenCode names it (`ollama/<tag>`), else
// the first Ollama has (`installed`, OpenCode's names): never OpenCode's own default, which may be a paid one. Empty:
// Ollama has none.
localOpenCodeModel(model: string, installed: string[]) string
  if model.isEmpty
    return installed.isEmpty ? "" : installed[0]
  model.startsWith(OLLAMA_PREFIX) ? model : "${OLLAMA_PREFIX}${model}"

// The local kind's OpenCode: OpenCode on one of Ollama's models, free.
localOpenCodeAdapter(role: Role, station: string, work: Work, emit: (e: <string, any>) => void) Outcome
  installed = work.model.isEmpty ? (openCodeLocalModels(machineMemory())["models"] as <string, any>[]).map((m) => "${m["id"]}") : ([] as string[])
  work.model = localOpenCodeModel(work.model, installed)
  if work.model.isEmpty
    return Outcome(false, "", {}, [], 0, [], "no local model: Ollama has none (ollama pull <model>), or it does not answer")
  openCodeAdapter(role, station, work, emit)
