use os
use sys
use json
use time
use shutil
use getpass
use subprocess
use pathlib{ Path }

// `nuclear-builder`: the set-up of the AI services, the software factory's teams, vault and line, in a terminal and
// for the editors, which run it as a process and draw what it prints (line.nuc has the line's commands).

USAGE = """
  nuclear-builder setup [--profile remote] [--yes]
                                  the AI services of this machine, step by step: the Smart Graph and its model, the
                                  MCP server in your AI clients, the knowledge base and Nuclear Chat, started now and
                                  at every login (--yes: no questions). The local models are on standby
                                  (ADR-platform-0013): the profiles lite, medium and hard are refused, and a machine
                                  that has them loses what NuclearLang put there (the Developer's service, the models
                                  it downloaded, Ollama when it installed it), told with the GB freed
  nuclear-builder setup --status [--json]      what is installed and running
  nuclear-builder setup --clients              adds the MCP server to every AI client of this machine (Claude Code,
                                  Codex, Grok Build, Cursor, OpenCode, Gemini CLI): after installing a client
  nuclear-builder setup --remove               takes the services away (Ollama, its models and the graph's data stay)
  nuclear-builder setup --remove --all         also what the set-up installed and made: its models, Ollama when it
                                               installed it, the graph's and the chat's data and secrets, its folder
  nuclear-builder setup --plan --json          this machine, the profiles and how each sits on it, the requirements
  nuclear-builder setup --events --profile <id> [--from <step>]
                                  the steps of a profile, one JSON line per event (what the editors draw)
  nuclear-builder setup --restart graph|chat   a service again, through the system's manager
  nuclear-builder setup --set KEY=value ...    writes the machine's choice (ai.env)
  nuclear-builder setup --ports                chooses the services' ports again (at each login, before they start)

  nuclear-builder team list|show <id>|save|delete <id>|default <id>|export <id> <file>|import <file>|roster [--lang en|es]|temperaments [--json]
                                  the teams of the software factory (~/.config/nuclearlang/factory/teams): JSON on
                                  stdout, an error as {"error": "..."} with exit code 1; `save` reads the team on stdin
  nuclear-builder team screen [--lang en|es] [--json]
                                  everything the company screen draws, in one call: {teams (as list), shown (each
                                  team as show, or {error}), roster, temperaments, vault (as vault list, or null),
                                  library and agents (as skills list, each with its markdown)}
  nuclear-builder team create [--json]         a new team from the wizard's draft on stdin: {name, description,
                                  purpose, skills, budgetUsd, techLead, logoFile, members: [{role, employee, kind,
                                  provider, model, name}]} (who works a member not said: the local defaults)
  nuclear-builder team suggest [--purpose <text>] [--skills a,b] [--lang en|es] [--limit <n>] [--json]
                                  the employees of each role that fit the purpose and skills, each with why
  nuclear-builder team name-suggest [--purpose <text>] [--lang en|es] [--json]
                                  five satirical names for a team
  nuclear-builder team runnable <id> [--json]  whether the team has a member of each role the project's stations need
  nuclear-builder team update <id> [--name …] [--description …] [--purpose …] [--skills a,b] [--lead <member id>] [--budget <usd>] | duplicate <id> [--name …] [--json]
  nuclear-builder team member add <id> --role <role> [--employee …] [--kind …] [--provider …] [--model …] [--name …] [--count <n>] [--json]
                                  members hired (several: --count, or a JSON list of members on stdin without --role)
  nuclear-builder team member remove <id> <member> | member update <id> <member> [--kind …] [--provider …] [--model …] [--employee …] [--name …] [--skills a,b] [--extra-skills <json>] [--instructions …] [--temperament …] [--gifs …] [--on …] [--note …] [--agent <library agent>] [--json]
                                  a member let go, or changed (by its id in the team); who works a member is one
                                  this machine has (agents --json), else it is refused with why
  nuclear-builder team skills set <id> [--member <m>] --skills a,b [--json]
                                  the library skills of the team (every member inherits them) or of a member
                                  (beside its role skills switched on): skills list gives their ids
  nuclear-builder team logo <id> <image> | logo <id> --clear [--json]
                                  the team's logo: a .png, .svg or .jpg of 1 MB at most, copied beside the team as
                                  <id>.logo.<kind>; --clear takes it away

  nuclear-builder skills list [--team <id>] [--member <m>] [--lang en|es] [--json]
                                  the library of skills and agents (nuclear-agents/skills, nuclear-agents/agents);
                                  with a team, its skills and its own; with a member, its own, its base agent and
                                  every skill it gets (composed: from library, team or member; what it overrides)
  nuclear-builder skills show <id> [--team <id>] [--member <m>] [--lang en|es] [--json]
                                  a skill's SKILL.md as that place sees it (the member's own, the team's own, the
                                  library's, the role's), where it comes from and whether it can be changed there
  nuclear-builder skills clone <id> --team <id> [--member <m>] [--json]
                                  a copy of the skill as the team's own (every member inherits it) or the member's,
                                  with the same id: it wins over the one it came from
  nuclear-builder skills create|update <id>|delete <id> --team <id> [--member <m>] [--json]
                                  an own skill of the team or the member: create and update read its SKILL.md on
                                  stdin (front matter name, title, description, title_es, description_es, kind,
                                  tags); a library skill is read-only (clone it to change it)

  nuclear-builder vault set <provider> | remove <provider> | list [--json]
                                  the API keys of anthropic, openai, google, openrouter in the system's keyring
                                  (service nuclear-factory); `set` reads the key on stdin (asked for, hidden, in a
                                  terminal), never from the command line

  nuclear-builder run [spec.md] [--team <id>] [--events] [--confirm-spending] [--force-confirm]
                                  the software factory: the spec through Analysis, Design, Tests first, Code,
                                  Quality and Delivery, each station worked by its role as the team assigned it (no
                                  file: the spec of specs/ changed last); it stops at the gates for you; --events:
                                  JSON lines on stdout, the answers as JSON lines on stdin (what the editors use)
  nuclear-builder run ... --detach             the run in a process of its own (no stdin: it waits at the first
                                  question): {run, detached, log}; with a paid provider, waiting: spending
  nuclear-builder run --resume <id>            a run that waits for you, from where it waits
  nuclear-builder run answer <id> --answer approve|change|stop|yes|no [--text …] [--events] [--detach]
                                  the answer to the question a run waits on (its process gets it, or the run goes
                                  on with it); never the spending: that is confirmed twice where you answer
  nuclear-builder run stop <id> | show <id> | journal <id>
                                  a run's process stopped (a run that asks waits) · its file (JSON) · its journal
  nuclear-builder retry <id> [--from <station>]   a run again from the station that failed (or --from that one)
  nuclear-builder retry <id> --step <step>        a run again from one step (it and every step after it)
  nuclear-builder restart <id>                 the whole run again: every file it wrote goes back first
  nuclear-builder runs [--json]                the runs of this project
  nuclear-builder metrics [--project <name|dir>] [--team <id>] [--member <id>] [--from YYYY-MM-DD] [--to YYYY-MM-DD] [--by day|week] [--view bill|throughput|cycle|burndown|flow|waiting|quality|people|indicators] [--json]
                                  the reports of the factory from its ledger (~/.config/nuclearlang/factory/ledger), every
                                  project of this machine: the bill (tokens in and out, USD, local against paid, the
                                  budget used), throughput and velocity, cycle time, burndown, cumulative flow, the gates
                                  waiting for you, quality, each member's work, the indicators (spec 017)
  nuclear-builder checks <id> [list|on <check>|off <check>|add --title … --station … [--by user|role] [--prompt …]|mark <check> passed|failed|skipped] [--json]
                                  the run's checks (checks.json in the spec's folder): QA's plan, yours
  nuclear-builder spec new --title … --component <name>|_global [--layer presentation|domain|data] [--use-case …] [--description …] [--criteria …]... [--stdin] [--json]
                                  the base of a spec in specs/<component>/[<layer>/]<id>/spec.md, with its acceptance
                                  criteria (--criteria, repeated; --stdin: the whole markdown on stdin): {id, path, spec}
  nuclear-builder spec show <id> | delete <id> [--json]
                                  a spec's markdown, its draft and its run · its folder to .nuclear/builder/deleted/
  nuclear-builder spec list [--json]           the specs by component and layer, with their runs
  nuclear-builder spec move <id> --component … [--layer …] [--json]
                                  a spec's folder to another component or layer (its run follows)
  nuclear-builder spec migrate [--json]        the specs of the flat specs/<id>/ to their component
  nuclear-builder spec accept <id> | discard <id> [--json]
                                  a spec's draft (spec.draft.md, written by a member in Nuclear Chat) over the spec,
                                  or thrown away
  nuclear-builder member --team <id> --role analyst|architect|developer|qa|devops|chat --events [--root <dir>]
                                  a member of a team answers once in Nuclear Chat (its responder): the conversation as
                                  one JSON line on stdin ({member, channel, thread, messages, said, lang}), the answer
                                  as JSON lines on stdout (typing, text, tool, ask, done); the role's provider with
                                  the factory's tools, the spending confirmed twice; --role chat is the general agent
                                  ([--provider <p>] [--model <m>] [--kind …], the local Nuclear Developer by default)
  nuclear-builder chat-host --json [--root <dir>] [--lang en|es]
                                  the host file of Nuclear Chat for this project: the members of its team (the run's
                                  team), their responders, the general agent `atlas` with its choices (the
                                  agents below), the channels general and the team's
  nuclear-builder agents [--json] [--root <dir>]
                                  the agents that can answer a conversation on this machine: the local Nuclear
                                  Developer (always), each agent whose command is on the PATH, each API provider with
                                  a key in the vault ({id, kind, provider, label, models, defaultModel, available, why})
  nuclear-builder models [--provider <id>] [--fresh] [--json] [--root <dir>]
                                  the models of each provider that can work here (one when asked), from the provider:
                                  Claude Code's aliases and ids, opencode models, an API's list (a key in the vault),
                                  Ollama's installed models with their memory need and fit (fits, tight, too-big)
                                  plus the small ones it can pull; and this machine's memory (lists kept 10 minutes)
  nuclear-builder ci [check|test|security|artifacts|deploy ...]   the commands of .nuclear/builder.json
  nuclear-builder export github|gitlab|bitbucket [--json]   writes the CI file that runs `nuclear-builder ci`
  nuclear-builder line show | set KEY=<json> ...   the project's line (.nuclear/builder.json): read, or keys set
  nuclear-builder connections [--team <id>] [--json]   Check the connections of a team
  nuclear-builder read <path> [--json]         a file of the project as text (a PDF by pdftotext, a .pptx, markdown)
  nuclear-builder mcp [--root <dir>] | mcp tools   the Builder's MCP server on stdio: every action above as a tool
                                  (docs/02-architecture/actions.md) · its instructions and tools as JSON
"""

event(value: <string, any>) void
  print(json.dumps(value), flush = true)

showStatus(asJson: boolean) int
  st = status()
  machine: <string, string> = st["machine"]!
  ready = st["graph"] == true and st["developer"] == true and st["ollama"] == true and (st["missingModels"] as string[]).isEmpty
  if asJson
    print(json.dumps(st, indent = 1))
    return 0
  mode = machine["NUCLEAR_AI_MODE"] ?? ""
  if mode.isEmpty
    print("not set up: nuclear-builder setup")
    return 1
  print("profile ${machine["NUCLEAR_AI_PROFILE"] ?? ""} (${st["file"]})")
  if mode != "local"
    return 0
  on = (ok: any) => ok == true ? "running" : "not running"
  missing: string[] = st["missingModels"]!
  print("Smart Graph        ${on(st["graph"])}")
  print("Nuclear Developer  ${on(st["developer"])}")
  print("Ollama             ${on(st["ollama"])}")
  print("models             ${missing.isEmpty ? "installed" : "missing ${missing.join(", ")}"}")
  print("at login           ${st["atLogin"] == true ? "yes" : "no"}")
  ready ? 0 : 1

// This machine, the profiles with how each sits on it, and the requirements of both modes: what the editors' set-up
// page draws, its texts in `lang` (setup.json's `<field>_<lang>` beside each English field; `localized`).
// `localModels`: false while the local models are on standby (ADR-platform-0013): only `remote` is offered, and its
// requirements are the local ones too.
plan(lang: string = "en") <string, any>
  hw = hardware()
  offered = offeredProfiles()
  onMachine = offered.map((p) => localized(profileOnMachine(p, hw), lang))
  {
    "localModels": localModels(),
    "hw": hw.asMap(),
    "platform": sys.platform,
    "suggested": recommend(hw, offered),
    "profiles": onMachine,
    "machine": readMachine(),
    "root": aiRoot(),
    "requirements": { "local": localized(requirements(localModels()), lang), "remote": localized(requirements(false), lang) }
  }

profileOnMachine(p: Profile, hw: Hardware) <string, any>
  shown: <string, any> = dict(p.data)
  f = fit(p, hw)
  shown["fit"] = f.fit
  shown["note"] = f.note
  shown["noteKey"] = f.key
  shown["noteArgs"] = f.args
  shown

// The steps of a profile as JSON lines, from the step `from` on: `steps`, then `step` (running, a line, done or
// failed), then `done`. The requirements are the caller's (the page installs them in a terminal the user sees).
setupEvents(args: string[]) int
  asked = option(args, "--profile") ?? ""
  p = profileOf(asked)
  root = aiRoot()
  standby = onStandby(asked)
  if p == null or root == null or standby != null
    event({ "type": "failed", "line": p == null ? "no such profile" : standby ?? "NuclearLang is installed without the AI services: run its installer again" })
    return 2
  first = (option(args, "--from") ?? "0").toInt() ?? 0
  all = steps(p, standbyPending())
  // `ids`: each step's kind, said by the editors in their language (`models`: what the `models` step downloads)
  event({ "type": "steps", "titles": all.map((s) => s.title), "ids": all.map((s) => s.id), "models": modelsOf(p).join(", "), "from": first })
  for i in 0..all.length
    if i < first
      continue
    event({ "type": "step", "index": i, "status": "running", "line": "" })
    try
      runStep(all[i].id, p, root, (line) => event({ "type": "step", "index": i, "status": "running", "line": line }))
    catch e
      event({ "type": "step", "index": i, "status": "failed", "line": "${e}" })
      return 1
    event({ "type": "step", "index": i, "status": "done", "line": "" })
  event({ "type": "done", "profile": p.id, "local": p.coder != null })
  0

describeProfiles(hw: Hardware, suggested: string) void
  box("This machine", ["${hw.cpu} · ${hw.cores} threads · ${hw.ram} GB of memory", "${hw.gpu.isEmpty ? "no GPU with memory of its own" : hw.gpu} · ${hw.disk} GB of disk free"], "slate")
  print("")
  if localModels()
    print("  ${paint("◆", "yellow")} ${paint("Where the agents run", "bold")}: on this machine (local models, fewer paid tokens) or remote only.")
  else
    print("  ${paint("◆", "yellow")} ${paint("The local models are on standby", "bold")} (ADR-platform-0013): the AI work is done by the agents and API providers you choose.")
  print("")
  for p in offeredProfiles()
    f = fit(p, hw)
    chosen = p.id == suggested
    lines: string[] = painted(p.data["summary"], "dim")
    if p.coder != null
      lines.addAll(f.fit == "no" ? bullet("✗", "red", "not for this machine: ${f.note}") : f.fit == "tight" ? bullet("!", "yellow", "tight on this machine: ${f.note}") : bullet("✓", "green", "fits this machine: ${f.note}"))
    for w in p.data["works"] as string[]
      lines.addAll(bullet("✓", "green", w))
    for l in p.data["limits"] as string[]
      lines.addAll(bullet("✗", "red", l, "dim"))
    if p.coder != null
      lines.addAll(painted("measured: ${p.data["measured"]}", "dim"))
    box("${p.id} · ${p.title} · ${p.data["gb"]} GB${chosen ? " · suggested" : ""}", lines, chosen ? "yellow" : "dim")
  print("")

// What a profile needs, found or installed by its own installer, one at a time; false when it is still missing.
haveRequirements(p: Profile, always: boolean) boolean
  local = p.coder != null
  while true
    missing = requirements(local).find((r) => r["found"] != true)
    if missing == null
      return true
    command: string? = (missing["install"] as <string, string>)[sys.platform]
    print("\n  ${paint("!", "yellow")} ${paint(missing["title"], "bold")} is needed (${missing["why"]}): ${missing["detail"]}.")
    other = missing["local"] == true ? ", or choose the profile `remote`" : ""
    by = "Install it from ${missing["url"]} and run `nuclear-builder setup` again${other}."
    // installed but stopped: started here, then used as it is
    if missing["id"] == "ollama" and "${missing["detail"]}".startsWith("installed, not running")
      print("Ollama is installed: starting it...")
      if startOllama()
        continue
      print("Ollama does not answer. Start it (its app, or `ollama serve`) and run `nuclear-builder setup` again.")
      return false
    if command == null
      print(by)
      return false
    notes: <string, string> = missing["note"] ?? ({} as <string, string>)
    if notes[sys.platform] != null
      print(notes[sys.platform])
    if not yes(always ? "y" : ask("Install it now with `${command}`? [Y/n]: ", "y"))
      print(by)
      return false
    // in the terminal the user sees: an installer may ask for a password
    subprocess.run(command, shell = true, env = toolEnv())
    // `--remove --all` takes away what the set-up installed, and only that
    if missing["id"] == "ollama"
      writeMachine({ "NUCLEAR_INSTALLED_OLLAMA": "1" })
    found = false
    for i in 0..20
      found = requirements(local).any((r) => r["id"] == missing["id"] and r["found"] == true)
      if found
        break
      time.sleep(1.5)
    if not found
      print("${missing["title"]} is still not found. ${by}")
      return false
  true

// The models of a local profile: the ones Ollama already has are used as they are; the others are downloaded only when
// the user says so (`always`: yes). False when they stay missing.
haveModels(p: Profile, always: boolean) boolean
  wanted = modelsOf(p)
  if wanted.isEmpty
    return true
  missing = missingOf(wanted, installedModels(urls()["ollama"]!))
  here = wanted.filter((m) => not (m in missing))
  if not here.isEmpty
    print("\n  ${paint("✓", "green")} Already in Ollama, used as they are: ${here.join(", ")}.")
  if missing.isEmpty
    return true
  if yes(always ? "y" : ask("\n  ${paint("Download", "bold")} ${missing.join(", ")} ${paint("(up to ${p.gb} GB)", "dim")}? ${paint("[Y/n]", "yellow")}: ", "y"))
    return true
  print("Nothing is downloaded. Run `nuclear-builder setup` again when you want the models, or choose the profile `remote`.")
  false

// The profile `remote`, said: the local agents are left out, the Smart Graph and the MCP server go on.
withoutLocalAgents() Profile?
  print("  ${paint("○", "dim")} No local agents: the Smart Graph and the MCP server are installed with the profile ${paint("remote", "bold")} (the local agents later: nuclear-builder setup).")
  profileOf("remote")

// The AI services of this machine, in a terminal: the same steps as the editors' set-up page.
setup(args: string[]) int
  if "--help" in args or "-h" in args
    print(USAGE)
    return 0
  if "--remove" in args
    everything = "--all" in args
    remove((line) => print(line), everything)
    print(everything ? "The AI services are removed, with everything their set-up installed and made. What was on this machine before stays." : "The AI services are removed. Ollama, its models and the graph's data stay (--all takes them away too).")
    return 0
  if "--clients" in args
    connectClients((line) => print(line))
    return 0
  // at login, before the services start: a port a program took since the set-up is replaced by a free one
  if "--ports" in args
    choice = readMachine()
    for k, v in servicePorts((line) => print(line))
      choice[k] = v
    writeMachine(choice)
    return 0
  if "--status" in args
    return showStatus("--json" in args)
  if "--plan" in args
    print(json.dumps(plan(option(args, "--lang") ?? "en"), indent = 1))
    return 0
  if "--events" in args
    return setupEvents(args)
  restart = option(args, "--restart")
  if restart != null
    return restartService(restart) ? 0 : 1
  if "--set" in args
    values: <string, string> = {}
    for a in args.skip(args.indexOf("--set") + 1)
      at = a.indexOf("=")
      if at > 0
        values[a.substring(0, at)] = a.substring(at + 1)
    writeMachine(values)
    return 0
  always = "--yes" in args
  standby = onStandby(option(args, "--profile") ?? "")
  if standby != null
    print(standby!, file = sys.stderr)
    return 2
  hw = hardware()
  suggested = recommend(hw, offeredProfiles())
  describeProfiles(hw, suggested)
  names = offeredProfiles().map((x) => x.id).join(", ")
  // the local agents are optional and asked (ADR-installer-0006): the answer by default is `remote`, no local model;
  // the Smart Graph and the MCP server are installed in every profile
  if localModels()
    print("  ${paint("Local agents", "bold")} are optional: ${paint("remote", "bold")} adds no local model (${suggested} suits this machine).")
  // on standby there is nothing to choose: `remote`
  p = profileOf(option(args, "--profile") ?? (always or not localModels() ? "remote" : ask("  ${paint("Which one?", "bold")} ${names} ${paint("[remote]", "yellow")}: ", "remote")))
  if p == null
    print("no such profile: ${names}", file = sys.stderr)
    return 2
  f = fit(p, hw)
  // a local profile not taken (not for this machine, Ollama or its models declined) leaves the required part: `remote`
  if f.fit == "no" and not yes(always ? "y" : ask("${p.title} is not for this machine (${f.note}). Install it anyway? [y/N]: ", "n"))
    p = withoutLocalAgents()
  if not haveRequirements(p!, always)
    p = withoutLocalAgents()
    if not haveRequirements(p!, always)
      return 1
  if not haveModels(p!, always)
    p = withoutLocalAgents()
  root = aiRoot()
  if root == null
    print("NuclearLang is installed without the AI services: run its installer again (without --no-ai).", file = sys.stderr)
    return 1
  all = steps(p!, standbyPending())
  log = setupLog()
  log.parent.mkdir(parents = true, existOk = true)
  log.writeText("# nuclear-builder setup, profile ${p.id}\n", encoding = "utf-8")
  print("")
  for i in 0..all.length
    step = all[i]
    work = Spinner("${step.title}", "${paint("${i + 1} of ${all.length}", "yellow")}  ${STEP_ABOUT[step.id] ?? ""}")
    work.start()
    said: string[] = []
    // every line a step says goes to the log; the spinner shows the last one
    note = (line: string) =>
      said.add(line)
      log.open("a", encoding = "utf-8").write("${step.id}: ${line}\n")
      work.update(line)
    try
      runStep(step.id, p, root, note)
      work.finish(true, step.title)
    catch e
      work.finish(false, step.title)
      print("")
      box("Could not finish: ${step.title}", [...said.slice(Math.max(0, said.length - 5)), "", "${e}", "", "Run nuclear-builder setup again: what is done stays, it goes on from this step. Everything it said is in ${log}."], "red")
      return 1
  m = readMachine()
  graph = "127.0.0.1:${m["NUCLEAR_GRAPH_PORT"] ?? "7878"}"
  print("")
  if p.coder != null
    box("The AI services are running", ["${paint("Profile", "dim")}        ${p.id} · ${modelsOf(p).join(", ")}", "${paint("Smart Graph", "dim")}    ${graph}", "${paint("Developer", "dim")}      127.0.0.1:${m["NUCLEAR_DEVELOPER_PORT"] ?? "7879"}", "", clientsLine(), "", "${paint("nuclear-builder setup --status", "yellow")}  what runs · ${paint("--remove", "yellow")}  takes them away"], "green")
  else
    later = localModels() ? "The local agents later: nuclear-builder setup again, with a local profile." : "The local models are on standby (ADR-platform-0013): your agents and API providers do the AI work."
    box("The Smart Graph and Nuclear Chat are running", ["${paint("Profile", "dim")}        remote · no local model, no Ollama", "${paint("Smart Graph", "dim")}    ${graph}", "${paint("Nuclear Chat", "dim")}   127.0.0.1:${m["NUCLEAR_CHAT_PORT"] ?? "7880"}", "", clientsLine(), "", later], "green")
  0

// Where the set-up writes everything its steps say: `~/.local/state/nuclearlang/setup.log` (`%LOCALAPPDATA%` on
// Windows), so a failure can be read whole.
setupLog() Path
  if sys.platform == "win32"
    return Path(os.environ.get("LOCALAPPDATA") ?? "${Path.home()}", "nuclearlang", "setup.log")
  state: string = os.environ.get("XDG_STATE_HOME") ?? ""
  (state.length > 0 ? Path(state) : Path.home().joinpath(".local", "state")).joinpath("nuclearlang", "setup.log")

// A list option (`--skills a,b`): its items trimmed, none empty; null when it is not given.
listOption(args: string[], name: string) string[]?
  given = option(args, name)
  given == null ? null : given!.split(",").map((x: string) => x.trim()).filter((x: string) => not x.isEmpty)

// Each role's employees (each with `face` and `thumb`), the names of its skills (what a member can switch on) and what
// the screens show of each skill in `lang` (`skillTexts`).
rosterByRole(lang: string) <string, any>
  people = rosters(lang)
  byRole: <string, any> = {}
  for r in ROLES
    byRole[r] = { "employees": people[r], "skills": roleSkills(r), "skillTexts": skillTexts(r, lang) }
  byRole

// Everything the company screen draws, in one process (`team screen`): the teams, each one shown (its members and the
// roles it lacks; a file that cannot be read, its error), the hiring pool, the temperaments and which keys the vault
// keeps (null when the keyring cannot be asked).
teamScreen(lang: string) <string, any>
  found = listTeams()
  shown: <string, any> = {}
  for t in found
    id = "${t["id"]}"
    try
      shown[id] = teamShown(loadTeam(id))
    catch e
      if not isinstance(e, ValueError) and not isinstance(e, OSError)
        throw e
      shown[id] = { "error": "${e}" }
  vault: <string, boolean>? = null
  try
    vault = vaultList()
  catch e
    if not isinstance(e, RuntimeError) and not isinstance(e, OSError)
      throw e
  // every team's warnings in one list, each with its team's name (ADR-platform-0013: the local members converted)
  warnings: string[] = []
  for t in found
    for w in (t["warnings"] ?? []) as string[]
      warnings.add("${t["name"]}: ${w}")
  // the library of skills and agents with their files: the wizard's chips, the previews, the editor's clones
  { "localModels": localModels(), "warnings": warnings, "teams": found, "shown": shown, "roster": rosterByRole(lang), "temperaments": temperaments(), "vault": vault, "library": librarySkills(lang), "agents": libraryAgents(lang) }

// The teams' commands: one call per action, JSON on stdout (the editors' contract, design.md "Teams").
team(args: string[]) int
  what = args.isEmpty ? "list" : args[0]
  valued = ["--role", "--count", "--purpose", "--extra-skills", "--limit", "--seed", "--name", "--lang", "--description", "--lead", "--budget", "--kind", "--provider", "--model", "--employee", "--instructions", "--temperament", "--gifs", "--note", "--skills", "--on", "--member", "--agent"]
  rest = args.skip(1).filter((a) => not a.startsWith("--")).filter((a) => not (args.indexOf(a) > 0 and args[args.indexOf(a) - 1] in valued))
  asJson = "--json" in args
  need = (n: int) => rest.length >= n
  try
    if what == "list"
      found = listTeams()
      if asJson
        printJson(found)
      else
        for t in found
          print("${t["default"] == true ? "*" : " "} ${"${t["id"]}".padEnd(24)} ${t["name"]}")
    else if what == "show" and need(1)
      printJson(teamShown(loadTeam(rest[0])))
    else if what == "save"
      printJson(saveTeam(json.loads(sys.stdin.read())))
    else if what == "delete" and need(1)
      deleteTeam(rest[0])
      printJson({ "deleted": rest[0] })
    else if what == "default" and need(1)
      loadTeam(rest[0])
      setDefaultTeam(rest[0])
      printJson({ "default": rest[0] })
    else if what == "export" and need(2)
      exportTeam(rest[0], rest[1])
      printJson({ "exported": rest[0], "file": rest[1] })
    else if what == "import" and need(1)
      printJson(importTeam(rest[0]))
    else if what == "logo" and need(1) and ("--clear" in args or need(2))
      printJson(teamShown(setLogo(rest[0], "--clear" in args ? null : rest[1])))
    else if what == "roster"
      printJson(rosterByRole(option(args, "--lang") ?? "en"))
    else if what == "screen"
      printJson(teamScreen(option(args, "--lang") ?? "en"))
    else if what == "temperaments"
      printJson(temperaments())
    else if what == "create"
      draft = json.loads(sys.stdin.read())
      workableAll(isinstance(draft, dict) ? (draft as <string, any>)["members"] : null)
      printJson(withWarnings(teamShown(createTeam(draft)), isinstance(draft, dict) ? (draft as <string, any>)["members"] : null))
    else if what == "suggest"
      limit = (option(args, "--limit") ?? "3").toInt() ?? 3
      printJson(suggestMembers(option(args, "--purpose") ?? "", listOption(args, "--skills") ?? ([] as string[]), rosters(option(args, "--lang") ?? "en"), limit))
    else if what == "name-suggest"
      seed = option(args, "--seed")
      printJson(suggestNames(option(args, "--lang") ?? "en", option(args, "--purpose") ?? "", 5, seed == null ? null : seed!.toInt()))
    else if what == "runnable" and need(1)
      root = projectRoot("${Path.cwd()}")
      line = readLine(root, "${projectCard(root)["platform"] ?? ""}")
      printJson(runnable(loadTeam(rest[0]), line["stations"] ?? STATIONS))
    else if what == "update" and need(1)
      fields: <string, any> = { "name": option(args, "--name"), "description": option(args, "--description"), "purpose": option(args, "--purpose"), "skills": listOption(args, "--skills"), "techLead": option(args, "--lead") }
      budget = option(args, "--budget")
      if budget != null
        fields["budgetUsd"] = budget!.toDouble() ?? -1.0
      printJson(teamShown(updateTeam(rest[0], fields)))
    else if what == "member" and need(2) and rest[0] == "add"
      role = option(args, "--role")
      given: <string, any>[] = []
      if role == null
        found = json.loads(sys.stdin.read())
        given = isinstance(found, list) ? found : [found]
      else
        one: <string, any> = { "role": role, "employee": option(args, "--employee"), "kind": option(args, "--kind"), "provider": option(args, "--provider"), "model": option(args, "--model"), "name": option(args, "--name") }
        given = (0..Math.max(1, (option(args, "--count") ?? "1").toInt() ?? 1)).map((i) => dict(one))
      workableAll(given)
      printJson(withWarnings(teamShown(addMembers(rest[1], given)), given))
    else if what == "member" and need(3) and rest[0] == "remove"
      printJson(teamShown(removeMember(rest[1], rest[2])))
    else if what == "member" and need(3) and rest[0] == "update"
      member: <string, any> = { "kind": option(args, "--kind"), "provider": option(args, "--provider"), "model": option(args, "--model"), "employee": option(args, "--employee"), "name": option(args, "--name"), "instructions": option(args, "--instructions"), "temperament": option(args, "--temperament"), "gifs": option(args, "--gifs"), "note": option(args, "--note"), "skills": listOption(args, "--skills"), "on": listOption(args, "--on"), "agent": option(args, "--agent") }
      extra = option(args, "--extra-skills")
      if extra != null
        member["extraSkills"] = json.loads(extra!)
      workableChange(rest[2], member)
      changed = teamShown(updateMember(rest[1], rest[2], member))
      printJson(withWarnings(changed, ((changed["members"] ?? []) as <string, any>[]).filter((m) => m["id"] == rest[2])))
    else if what == "skills" and need(2) and rest[0] == "set"
      printJson(setSkills(rest[1], listOption(args, "--skills") ?? ([] as string[]), option(args, "--member")))
    else if what == "duplicate" and need(1)
      printJson(teamShown(duplicateTeam(rest[0], option(args, "--name"))))
    else
      printJson({ "error": "usage: nuclear-builder team list|show <id>|screen|save|create|suggest|name-suggest|runnable <id>|delete <id>|default <id>|export <id> <file>|import <file>|logo <id> <image>|logo <id> --clear|roster [--lang en|es]|temperaments|update <id> [--name …] [--description …] [--purpose …] [--skills a,b] [--lead <member id>] [--budget <usd>]|member add <id> --role <role> [--employee …] [--count <n>] …|member remove <id> <member>|member update <id> <member> [--kind …] [--provider …] [--model …] …|duplicate <id> [--name …] (nuclear-builder --help)" })
      return 1
  catch e
    if not isinstance(e, ValueError) and not isinstance(e, OSError)
      throw e
    printJson({ "error": "${e}" })
    return 1
  0

// The vault's commands: the key of `set` comes on stdin (hidden in a terminal); nothing prints a key.
vault(args: string[]) int
  what = args.isEmpty ? "list" : args[0]
  rest = args.skip(1).filter((a) => not a.startsWith("--"))
  try
    if what == "list"
      printJson(vaultList())
    else if what == "set" and rest.length >= 1
      key = sys.stdin.isatty() ? getpass.getpass("The API key of ${rest[0]}: ") : sys.stdin.read()
      vaultSet(rest[0], key)
      printJson({ "kept": rest[0] })
    else if what == "remove" and rest.length >= 1
      vaultRemove(rest[0])
      printJson({ "removed": rest[0] })
    else
      printJson({ "error": "usage: nuclear-builder vault set <provider> | remove <provider> | list" })
      return 1
  catch e
    if not isinstance(e, RuntimeError) and not isinstance(e, OSError)
      throw e
    printJson({ "error": "${e}" })
    return 1
  0

usageError(command: string) int
  print("nuclear-builder: no command `${command}`\n${USAGE}", file = sys.stderr)
  2

main(argv: string[]? = null) void
  args: string[] = argv ?? sys.argv.slice(1)
  if args.isEmpty or args[0] == "help" or args[0] == "--help" or args[0] == "-h"
    print("nuclear-builder — the Nuclear Builder without the editor\n${USAGE}")
    return
  try
    rest = args.skip(1)
    // `member` and `mcp` load the `mcp` library (some 300 ms): `lazy_imports` (nuclear.toml) imports each in its
    // arm, so every other command starts without it
    code = match args[0]
      "setup" -> setup(rest)
      "team" -> team(rest)
      "skills" -> skillsLine(rest)
      "vault" -> vault(rest)
      "run" -> runLine(rest)
      "retry" -> retryLine(rest, false)
      "restart" -> retryLine(rest, true)
      "runs" -> runsLine(rest)
      "metrics" -> metricsLine(rest)
      "checks" -> checksLine(rest)
      "spec" -> specLine(rest)
      "member" -> memberLine(rest)
      "chat-host" -> chatHostLine(rest)
      "agents" -> agentsLine(rest)
      "models" -> modelsLine(rest)
      "ci" -> ciLine(rest)
      "export" -> exportLine(rest)
      "line" -> lineLine(rest)
      "read" -> readLineCommand(rest)
      "connections" -> connectionsLine(rest)
      "mcp" -> mcpLine(rest)
      _ -> usageError(args[0])
    sys.exit(code)
  catch e
    if not isinstance(e, RuntimeError) and not isinstance(e, OSError)
      throw e
    print("nuclear-builder: ${e}", file = sys.stderr)
    sys.exit(1)

// What the set-up's last line says of the AI clients: they have the MCP server only when one was found.
clientsLine() string
  anyAiClient() ? "Your AI clients have the MCP server (nuclear-mcp); a client installed later: nuclear-builder setup --clients." : "No AI client was found (Claude Code, Codex, Grok Build, Cursor, OpenCode, Gemini CLI): after installing one, nuclear-builder setup --clients."
