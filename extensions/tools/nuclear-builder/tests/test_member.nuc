use io
use sys
use json
use asyncio
use httpx
use pathlib{ Path }

// A member in Nuclear Chat (spec 013, design.md "The responder" and "The process"): one answer as the member's
// profile, in the responder's protocol, with the factory's tools and the spending confirmed twice; the host file of
// a project. The Nuclear Developer is an httpx stub, Claude Code a fake command: no paid call.

// A project with a team whose developer is Neo of the roster (in Spanish too) and whose analyst is Claude Code.
memberProject(tmpPath: Path, monkeypatch: any) string
  root = chatProject(tmpPath, monkeypatch)
  monkeypatch.setenv("NUCLEAR_FACTORY_HOME", "${tmpPath.joinpath("factory")}")
  roster = tmpPath.joinpath("roles", "developer", "roster")
  roster.mkdir(parents = true)
  roster.joinpath("en.json").writeText(json.dumps({ "role": "developer", "employees": [{ "id": "dev-017", "name": "Neo", "bio": "Writes tests at night.", "hrNote": "Never late, never early.", "temperament": "grumpy" }] }))
  roster.joinpath("es.json").writeText(json.dumps({ "role": "developer", "employees": [{ "id": "dev-017", "name": "Neo", "bio": "Escribe tests de noche.", "hrNote": "Nunca tarde, nunca temprano.", "temperament": "grumpy" }] }))
  roster.joinpath("faces").mkdir()
  roster.joinpath("faces", "dev-017.webp").writeText("RIFF----WEBP")
  roster.joinpath("faces", "thumb").mkdir()
  roster.joinpath("faces", "thumb", "dev-017.webp").writeText("RIFF----WEBP")
  tmpPath.joinpath("roles", "temperaments.json").writeText(json.dumps({ "temperaments": [{ "id": "grumpy", "name": { "en": "Grumpy", "es": "Gruñón" }, "voice": "You are grumpy: terse, blunt messages." }, { "id": "shy", "name": { "en": "Shy", "es": "Tímido" }, "voice": "You are shy: short, quiet messages." }] }))
  saveTeam({ "id": "night-shift", "name": "Night shift", "description": "We ship at dawn.", "budgetUsd": 2, "techLead": "developer", "roles": { "developer": { "employee": "dev-017", "kind": "local", "provider": "nuclear-developer", "model": "qwen2.5-coder:3b", "instructions": "Tests before code.", "personality": { "gifs": "often", "on": ["failure", "success"], "note": "Dry humour." } }, "analyst": { "kind": "agent", "provider": "claude-code", "model": "haiku", "name": "Ana" } } })
  Path(root, ".nuclear", "builder.json").writeText(json.dumps({ "team": "night-shift", "specLanguage": "en" }))
  root

memberOf(root: string, role: string, ask: <string, any>, lines: string[], events: <string, any>[], options: <string, any> = {}) Member
  team = loadTeam("night-shift")
  given: <string, any> = memberFor(team, role)!
  opts: <string, any> = { "events": true, "budgetUsd": 2.0 }
  for k, v in options
    opts[k] = v
  id = memberChatId("night-shift", role, "${ask["channel"]}", "${ask["thread"] ?? ""}")
  protocol = MemberLines((x: <string, any>) => events.add(x))
  Member(root, id, given, readLine(root, "backend"), () => nextLine(lines), (e: <string, any>) => protocol.on(e), opts, team, role, ask)

testAMemberAnswersAsTheirProfileWithTheFactorysTools(tmpPath: Path, monkeypatch: any) void
  localOn(monkeypatch)
  root = memberProject(tmpPath, monkeypatch)
  bodies: <string, any>[] = []
  first = "Voy.\n--- tool: spec_new ---\n{\"title\": \"Book a room\", \"component\": \"booking\", \"criteria\": [\"a booked room is not free\"]}"
  local = assistant(bodies, [first, "Listo: specs/booking/book-a-room."])
  events: <string, any>[] = []
  ask: <string, any> = { "member": "night-shift-developer", "channel": "night-shift", "thread": "", "messages": [{ "author": "you", "text": "hola equipo" }], "said": "escribe la base de una spec para reservar", "lang": "es" }
  code = memberOf(root, "developer", ask, [], events, { "transport": local }).respond()
  expect(code == 0)
  expect(events.map((e) => e["type"]) == ["typing", "text", "tool", "tool", "text", "done"], json.dumps(events))
  expect(events[2] == { "type": "tool", "id": "turn-1-1-1", "tool": "spec_new", "input": "{\"title\": \"Book a room\", \"component\": \"booking\", \"criteria\": [\"a booked room is not free\"]}" } and events[3]["ok"] == true)
  expect(events.last == { "type": "done", "costUsd": 0 } and Path(root, "specs", "booking", "book-a-room", "spec.md").isFile())
  // the member's own prompt: their name, role, profile in the conversation's language, personality, the team's
  // instructions, the factory's tools, the chat's conversation; the tools' results in the second call
  message = "${bodies[0]["message"]}"
  for part in ["You are Neo, the Developer of the team Night shift", "#night-shift", "Escribe tests de noche.", "Nunca tarde, nunca temprano.", "Dry humour.", "- Temperament: Grumpy", "## How you write\n\nYou are grumpy: terse, blunt messages.", "Tests before code.", "You are the team's tech lead", "speak for everyone", "accountable for the team's work", "`spec_new`", "- booking", "you: hola equipo", "you: escribe la base", "answer in Spanish", "Responde en español.", "your first answer is the plan", "size it first", "is no run of the factory", "who of your team does each part", "run_start", "## Your team, by station", "- analysis: Ana, the Analyst", "- tests first: Neo, the Developer", "- quality: nobody (the team has no QA)"]
    expect(part in message, part)
  expect(not ("spec_new (failed)" in "${bodies[1]["message"]}") and "## The tools answered" in "${bodies[1]["message"]}" and "book-a-room" in "${bodies[1]["message"]}")

testAMembersGifIsALastLineNeverShownAndTheLanguageRuleIsFirstAndLast(tmpPath: Path, monkeypatch: any) void
  localOn(monkeypatch)
  root = memberProject(tmpPath, monkeypatch)
  bodies: <string, any>[] = []
  local = assistant(bodies, ["¡Jaja, me lo quedo!\n**gif:** Laugh"])
  events: <string, any>[] = []
  messages: <string, any>[] = [{ "author": "you", "text": "", "gif": "Atom dance" }, { "author": "you", "text": "jaja es tu nuevo nombre" }]
  ask: <string, any> = { "member": "night-shift-developer", "channel": "night-shift", "thread": "", "messages": messages, "said": "jaja es tu nuevo nombre", "lang": "en", "gifTags": ["laugh", "success", "failure"] }
  expect(memberOf(root, "developer", ask, [], events, { "transport": local }).respond() == 0)
  expect(events.filter((e) => e["type"] == "text") == [{ "type": "text", "text": "¡Jaja, me lo quedo!" }], json.dumps(events))
  expect(events.last == { "type": "done", "costUsd": 0, "gif": "laugh" })
  message = "${bodies[0]["message"]}"
  // the language: first, and again with the message to answer; the language the user wrote in wins
  expect(message.startsWith("Language: answer in Spanish: the user chose English, but wrote this message in Spanish. Responde en español."), message.substring(0, 200))
  expect(message.split("Language: answer in Spanish").length == 3)
  for part in ["## GIFs", "`gif: <tag>`", "laugh, success, failure", "You like GIFs", "at a failure, a success", "you: [a GIF: Atom dance]", "The user just sent a GIF (\"Atom dance\")"]
    expect(part in message, part)

testTheAnswersLanguageIsTheMessagesWhenItTellsElseTheChosenOne() void
  expect(messageLanguage("jaja es tu nuevo nombre") == "es" and messageLanguage("Hi! What is your job in this team?") == "en" and messageLanguage("ok") == "")
  expect(languageRuleIn("es", "Hi! What is your job in this team?").startsWith("Language: answer in English: the user chose Spanish, but wrote this message in English. Answer in English."))
  expect(languageRuleIn("en", "¿qué haces?").endsWith("Responde en español."))
  expect(languageRuleIn("es", "ok") == languageRuleIn("es", "hola") and "But when the user's message is written in another language" in languageRuleIn("es", "ok"))

testAMemberWritingItsGifLineNeverStreamsIt() void
  out: <string, any>[] = []
  lines = MemberLines((e: <string, any>) => out.add(e))
  for piece in ["Ha", "ha, ", "nice!", "\ng", "if", ": ", "laugh", "\n"]
    lines.on({ "type": "event", "event": { "type": "text-delta", "text": piece } })
  lines.on({ "type": "event", "event": { "type": "text", "text": "Haha, nice! gif: laugh" } })
  lines.on({ "type": "done", "costUsd": 0.0 })
  shown = out.filter((e) => e["type"] == "text-delta").map((e) => "${e["text"]}").join("")
  expect(shown == "Haha, nice!", shown)
  expect(out.filter((e) => e["type"] == "text") == [{ "type": "text", "text": "Haha, nice!" }] and out.last["gif"] == "laugh", json.dumps(out))
  // a word that only starts like it is told once it is whole; no GIF without the line
  other: <string, any>[] = []
  plain = MemberLines((e: <string, any>) => other.add(e))
  for piece in ["a gi", "ft for you"]
    plain.on({ "type": "event", "event": { "type": "text-delta", "text": piece } })
  plain.on({ "type": "done", "costUsd": 0.0 })
  expect(other.filter((e) => e["type"] == "text-delta").map((e) => "${e["text"]}").join("") == "a gift for you" and not ("gif" in other.last))

testAPaidMemberIsConfirmedTwiceOnceForTheConversation(tmpPath: Path, monkeypatch: any) void
  root = memberProject(tmpPath, monkeypatch)
  log = fakeAgent(tmpPath, monkeypatch, "claude", [{ "type": "result", "result": "Two runs passed.", "total_cost_usd": 0.02, "is_error": false }])
  // an agent's subscription is not asked (spec 023 requirement 4): forceConfirm asks it, as an API's is asked
  free: <string, any>[] = []
  memberOf(root, "analyst", { "member": "night-shift-analyst", "channel": "night-shift", "thread": "m0", "messages": [], "said": "hi", "lang": "en" }, [], free).respond()
  expect(not free.any((e) => e["type"] == "ask") and free.last == { "type": "done", "costUsd": 0.02 }, json.dumps(free))
  log.unlink()
  forcing: <string, any> = { "forceConfirm": true }
  ask: <string, any> = { "member": "night-shift-analyst", "channel": "night-shift", "thread": "m1", "messages": [], "said": "what was done?", "lang": "en" }
  refused: <string, any>[] = []
  memberOf(root, "analyst", ask, [json.dumps({ "answer": "no" })], refused, forcing).respond()
  expect(refused.map((e) => e["type"]) == ["typing", "ask", "done"] and refused.last["error"] == "the spending was not confirmed" and not log.exists())
  events: <string, any>[] = []
  memberOf(root, "analyst", ask, [json.dumps({ "answer": "yes" }), json.dumps({ "answer": "yes" })], events, forcing).respond()
  asks = events.filter((e) => e["type"] == "ask")
  expect(asks.map((a) => a["id"]) == ["spending-1", "spending-2"] and asks[1]["budgetUsd"] == 2.0 and asks[0]["kind"] == "spending", json.dumps(events))
  expect(events.last == { "type": "done", "costUsd": 0.02 } and events.any((e) => e == { "type": "text", "text": "Two runs passed." }))
  files = Path("${log}.files")
  sent = log.readText() + (files.exists() ? files.readText() : "")
  expect("You are Ana, the Analyst of the team Night shift" in sent and "## Your tech lead\n\nNeo, the Developer, answers for the team" in sent and not ("You are the team's tech lead" in sent))
  // every member follows the team's method (Scrum: the team wrote none) and its instructions
  expect("## How the team Night shift works" in sent and "The method: Scrum." in sent)
  // the same conversation does not ask again; another thread does
  again: <string, any>[] = []
  memberOf(root, "analyst", ask, [], again, forcing).respond()
  expect(not again.any((e) => e["type"] == "ask") and again.last["costUsd"] == 0.02)
  other: <string, any>[] = []
  ask["thread"] = "m2"
  memberOf(root, "analyst", ask, [], other, forcing).respond()
  expect(other.map((e) => e["type"]) == ["typing", "ask", "done"])

// Runs `nuclear-builder member <args>` with `stdin`; gives its exit code and the JSON lines it printed.
memberCall(args: string[], monkeypatch: any, capsys: any, stdin: string) <string, any>
  monkeypatch.setattr(sys, "stdin", io.StringIO(stdin))
  code = memberLine(args)
  out: string = capsys.readouterr().out
  { "code": code, "lines": out.trim().split("\n").filter((l) => not l.isEmpty).map((l) => json.loads(l)) }

testTheResponderRefusesWhatItCannotAnswer(tmpPath: Path, monkeypatch: any, capsys: any) void
  root = memberProject(tmpPath, monkeypatch)
  ok = json.dumps({ "channel": "general", "said": "hi" })
  cases = [[["--team", "night-shift", "--events"], ok, "--role"], [["--team", "night-shift", "--role", "developer"], ok, "--events"], [["--role", "qa", "--events"], ok, "--team"], [["--team", "nobody", "--role", "qa", "--events"], ok, "no team"], [["--team", "night-shift", "--role", "qa", "--events"], ok, "has no qa"], [["--team", "night-shift", "--role", "developer", "--events"], "not json", "one JSON line"], [["--role", "chat", "--provider", "nobody", "--events"], ok, "no provider"], [["--team", "night-shift", "--member", "nobody", "--events"], ok, "no member `nobody`"]]
  for c in cases
    got = memberCall(c[0], monkeypatch, capsys, c[1])
    lines: <string, any>[] = got["lines"]!
    expect(got["code"] == 2 and lines.length == 1 and lines[0]["type"] == "done" and c[2] in "${lines[0]["error"]}", json.dumps(got))
  expect(root.length > 0)

testTheHostFileGivesTheProjectsTeamAsMembersAndChannels(tmpPath: Path, monkeypatch: any, capsys: any) void
  localOn(monkeypatch)
  root = memberProject(tmpPath, monkeypatch)
  host = chatHost(root, "es", httpx.MockTransport((request: httpx.Request) => httpx.Response(503)))
  expect(host["host"] == "builder" and host["lang"] == "es" and host["teams"] == [{ "id": "night-shift", "name": "Night shift", "lead": "night-shift-developer" }])
  members: <string, any>[] = host["members"]!
  expect(members.map((m) => m["id"]) == ["night-shift-developer", "night-shift-analyst", "atlas"])
  // only the tech lead and Atlas are listed (spec 023 requirement 2): the people of the chat, each a direct message
  expect(members.map((m) => m["listed"]) == [true, false, true])
  // the profile's card: the temperament, the skills by title, the instructions; a saved team's member can be changed
  card: <string, any> = members[0]["card"]!
  expect(card == { "editable": true, "temperament": "grumpy", "temperaments": [{ "id": "grumpy", "name": "Gruñón" }, { "id": "shy", "name": "Tímido" }], "skills": [] as string[], "instructions": "Tests before code." }, json.dumps(card))
  expect(members[0] == { "card": card, "id": "night-shift-developer", "name": "Neo", "role": "developer", "member": "developer", "team": "night-shift", "listed": true, "avatar": "dev-017", "face": "${tmpPath.joinpath("roles", "developer", "roster", "faces", "thumb", "dev-017.webp")}", "temperament": "grumpy", "profile": { "bio": "Escribe tests de noche.", "hrNote": "Nunca tarde, nunca temprano.", "lang": "es" }, "personality": { "gifs": "often", "on": ["failure", "success"], "note": "Dry humour.", "temperament": "grumpy" }, "brain": { "agent": "Nuclear Developer", "kind": "local", "provider": "nuclear-developer", "model": "qwen2.5-coder:3b", "paid": false }, "responder": { "command": ["nuclear-builder", "member", "--team", "night-shift", "--member", "developer"], "paid": false } }, json.dumps(members[0]))
  // a member without an employee: the name given, the team's id as the avatar's seed, the default personality
  expect(members[1]["name"] == "Ana" and members[1]["avatar"] == "night-shift-analyst" and (members[1]["responder"] as <string, any>)["paid"] == true and members[1]["personality"] == { "gifs": "sometimes", "on": ["failure"], "note": "" } and members[1]["face"] == null and members[1]["temperament"] == null)
  expect(members[1]["brain"] == { "agent": "Claude Code", "kind": "agent", "provider": "claude-code", "model": "haiku", "paid": true })
  expect(host["assigned"] == "night-shift")
  expect(host["channels"] == [{ "id": "home", "name": "app", "topic": "app", "members": ["night-shift-developer"], "team": "night-shift" }, { "id": "general", "name": "general", "topic": "The project app", "members": ["night-shift-developer"] }, { "id": "night-shift", "name": "night-shift", "topic": "We ship at dawn.", "members": ["night-shift-developer"] }], json.dumps(host["channels"]))
  expect(chatHostLine(["--json", "--root", root]) == 0 and json.loads(capsys.readouterr().out)["lang"] == "en")

// Every member of the team is in the chat, any number per role (`<team>-<member id>`, answered by `--member`).
testEveryMemberOfTheTeamIsInTheChat(tmpPath: Path, monkeypatch: any) void
  root = memberProject(tmpPath, monkeypatch)
  addMembers("night-shift", [{ "role": "developer", "id": "dev-2" }])
  host = chatHost(root, "en", httpx.MockTransport((request: httpx.Request) => httpx.Response(503)))
  members: <string, any>[] = host["members"]!
  expect(members.map((m) => m["id"]) == ["night-shift-developer", "night-shift-analyst", "night-shift-dev-2", "atlas"])
  expect((members[2]["responder"] as <string, any>)["command"] == ["nuclear-builder", "member", "--team", "night-shift", "--member", "dev-2"])

// Every saved team is in the chat (spec 023 requirement 2), the project's first: several and none chosen are no error,
// never the unsaved local team; a team without members has no tech lead and nobody listed.
testEveryTeamIsInTheChatWithItsTechLead(tmpPath: Path, monkeypatch: any, capsys: any) void
  root = memberProject(tmpPath, monkeypatch)
  saveTeam({ "id": "day-shift", "name": "Day shift", "members": [{ "id": "qa", "role": "qa", "kind": "agent", "provider": "codex" }, { "id": "arch", "role": "architect", "kind": "agent", "provider": "codex" }] })
  saveTeam({ "id": "empty", "name": "Empty", "members": [] as any[] })
  host = chatHost(root, "en", httpx.MockTransport((request: httpx.Request) => httpx.Response(503)))
  // the project's team first, then the others; a team naming no tech lead is led by its Architect
  expect(host["teams"] == [{ "id": "night-shift", "name": "Night shift", "lead": "night-shift-developer" }, { "id": "day-shift", "name": "Day shift", "lead": "day-shift-arch" }, { "id": "empty", "name": "Empty", "lead": "" }], json.dumps(host["teams"]))
  members: <string, any>[] = host["members"]!
  expect(members.filter((m) => m["listed"] == true).map((m) => m["id"]) == ["night-shift-developer", "day-shift-arch", "atlas"])
  expect((host["channels"] as <string, any>[]).map((c) => c["id"]) == ["home", "general", "night-shift", "day-shift", "empty"])
  setDefaultTeam(null)
  Path(root, ".nuclear", "builder.json").writeText("{}")
  expect(chatHostLine(["--json", "--root", root]) == 0)
  said = json.loads(capsys.readouterr().out)
  expect(not ("error" in said) and (said["teams"] as <string, any>[]).map((t) => t["id"]) == ["day-shift", "empty", "night-shift"], json.dumps(said["teams"]))

// No saved team: the chat makes none up (the local team a run takes could not be changed by anybody): Atlas alone, the
// folder's channel with nobody in it and `assigned` null, for the editor to offer the teams or making one.
testWithNoSavedTeamTheChatHasNoTeamAndItsChannelWaitsForOne(tmpPath: Path, monkeypatch: any) void
  root = chatProject(tmpPath, monkeypatch)
  monkeypatch.setenv("NUCLEAR_FACTORY_HOME", "${tmpPath.joinpath("factory")}")
  host = chatHost(root, "en", httpx.MockTransport((request: httpx.Request) => httpx.Response(503)))
  expect((host["members"] as <string, any>[]).map((m) => m["id"]) == ["atlas"] and host["teams"] == [] and host["assigned"] == null, json.dumps(host["members"]))
  channels: <string, any>[] = host["channels"]!
  expect(channels.map((c) => c["id"]) == ["home", "general"] and channels[0]["members"] == [] and channels[0]["team"] == "", json.dumps(channels))

// A team assigned to a workspace (`line set team=` in its folder) works each of its apps, and the workspace's chat
// names its channel after the workspace; an app's own assignment wins.
testATeamAssignedToAWorkspaceWorksItsApps(tmpPath: Path, monkeypatch: any) void
  memberProject(tmpPath, monkeypatch)
  ws = tmpPath.joinpath("Rick Workspace")
  ws.joinpath(".workspace").mkdir(parents = true)
  ws.joinpath(".workspace", "workspace.nuc").writeText("workspace(name = \"Rick Workspace\")\napp(folder = \"api\", platform = \"backend\")\n")
  ws.joinpath(".nuclear").mkdir()
  ws.joinpath(".nuclear", "builder.json").writeText(json.dumps({ "team": "night-shift" }))
  saveTeam({ "id": "day-shift", "name": "Day shift", "members": [{ "id": "arch", "role": "architect", "kind": "agent", "provider": "codex" }] })
  app = ws.joinpath("api")
  app.mkdir()
  expect(assignedTeamId("${app}") == "night-shift" and runTeam("${app}")!["id"] == "night-shift")
  host = chatHost("${ws}", "en", httpx.MockTransport((request: httpx.Request) => httpx.Response(503)))
  home: <string, any> = (host["channels"] as <string, any>[])[0]
  expect(home["name"] == "rick-workspace" and home["members"] == ["night-shift-developer"] and home["team"] == "night-shift" and host["assigned"] == "night-shift", json.dumps(home))
  app.joinpath(".nuclear").mkdir()
  app.joinpath(".nuclear", "builder.json").writeText(json.dumps({ "team": "day-shift" }))
  expect(assignedTeamId("${app}") == "day-shift")
  // a folder of no workspace reads no folder above it
  loose = tmpPath.joinpath("loose")
  loose.mkdir()
  expect(assignedTeamId("${loose}") == null)

// Nuclear Atlas only informs (spec 023 requirement 1): its prompt sends a task to a free team's tech lead (or offers to
// make a team), and its tools are those that read and teach: no spec written, no run started.
testAtlasOnlyInformsAndNamesTheFreeTeamsWithTheirTechLead(tmpPath: Path, monkeypatch: any) void
  root = memberProject(tmpPath, monkeypatch)
  log = fakeAgent(tmpPath, monkeypatch, "claude", [{ "type": "result", "result": "Talk to Neo.", "total_cost_usd": 0.0, "is_error": false }])
  ask: <string, any> = { "member": "atlas", "channel": "dm-atlas", "thread": "", "messages": [], "said": "write me a login screen", "lang": "en" }
  events: <string, any>[] = []
  protocol = MemberLines((x: <string, any>) => events.add(x))
  atlas = Member(root, "atlas-test", { "kind": "agent", "provider": "claude-code" }, readLine(root, "backend"), () => null, (e: <string, any>) => protocol.on(e), { "events": true }, loadTeam("night-shift"), "chat", ask)
  atlas.respond()
  expect(not events.any((e) => e["type"] == "ask") and events.last == { "type": "done", "costUsd": 0.0 }, json.dumps(events))
  sent = log.readText()
  for part in ["You only inform", "a team's tech lead does it", "offer to make one here", "team_create", "## The teams", "- Night shift (`night-shift`): free; its tech lead Neo, the Developer", "costs no more tokens", "task-size", "## Your tools"]
    expect(part in sent, part)
  expect(not ("every action of Nuclear Builder" in sent))
  // its tools: the informing ones of both MCP servers
  names = asyncio.run(builderMcpServer(root, true).listTools()).map((t: any) => "${t.name}")
  expect("team_list" in names and "project_read" in names and not ("spec_new" in names) and not ("run_start" in names) and not ("team_create" in names), json.dumps(names))
  expect(chatTool(root, "spec_new", { "title": "x" }, true)["error"] == true and "no tool" in "${chatTool(root, "run_start", {}, true)["text"]}")
  work = Work(root, root, "", {}, [], "", 0.0, "nuclear-mcp", 1000, { "informs": true })
  servers = mcpServers(work)
  expect((servers["nuclear"] as <string, any>)["args"] == ["--informs"] and "--informs" in ((servers["nuclear_builder"] as <string, any>)["args"] as string[]))
  expect((mcpServers(Work(root, root, "", {}, [], "", 0.0))["nuclear"] as <string, any>)["args"] == [])
  // a team with a run in progress is busy; with none, Atlas offers to make one
  run = newRun(root, { "name": "app" }, { "id": "s1", "title": "S" }, loadTeam("night-shift"), ["design"], "specs/s1")
  run["status"] = "waiting"
  saveRun(run)
  expect("busy (runs in progress: s1)" in atlas.teamsSection())
  deleteTeam("night-shift")
  expect("There is no team yet" in atlas.teamsSection())
