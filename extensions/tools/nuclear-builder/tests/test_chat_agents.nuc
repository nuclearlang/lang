use os
use json
use httpx
use pathlib{ Path }

// The agents a conversation can choose (spec 013 requirement 17): the local Nuclear Developer always, an agent when
// its command is on the PATH, an API provider when the vault notes its key and it has a priced model; a chat's turn
// with Claude Code streams its text. The commands are fakes and the Developer an httpx stub: no paid call.

FAKE_OPENCODE = "#!/bin/sh\nif [ \"$1\" = models ]; then echo 'anthropic/claude-x'; echo 'ollama/qwen2.5-coder:3b'; echo 'not a model'; fi\n"

// A project, a vault that notes anthropic's and openai's keys, a price of the project for openai, and on the PATH
// only a fake `claude` and `opencode`.
agentsProject(tmpPath: Path, monkeypatch: any) string
  root = chatProject(tmpPath, monkeypatch)
  monkeypatch.setenv("NUCLEAR_FACTORY_HOME", "${tmpPath.joinpath("factory")}")
  monkeypatch.setenv("HOME", "${tmpPath}")
  tmpPath.joinpath("factory").mkdir()
  tmpPath.joinpath("factory", "vault.json").writeText(json.dumps(["anthropic", "openai"]))
  Path(root, ".nuclear", "builder.json").writeText(json.dumps({ "prices": { "openai/gpt-x": [1.0, 2.0] } }))
  bin = tmpPath.joinpath("bin")
  bin.mkdir()
  for name, body in { "claude": "#!/bin/sh\necho claude\n", "opencode": FAKE_OPENCODE }
    bin.joinpath(name).writeText(body)
    bin.joinpath(name).chmod(493)
  monkeypatch.setenv("PATH", "${bin}")
  root

down() httpx.MockTransport
  httpx.MockTransport((request: httpx.Request) => httpx.Response(503))

testTheAgentsOfThisMachineAreOfferedWithWhyNot(tmpPath: Path, monkeypatch: any) void
  localOn(monkeypatch)
  root = agentsProject(tmpPath, monkeypatch)
  found = agentsHere(root, down())
  ids = found.map((a) => "${a["id"]}")
  expect(ids == ["nuclear-developer", "opencode-local", "claude-code", "opencode", "codex", "gemini-cli", "cursor", "grok", "anthropic", "openai", "google", "openrouter"], json.dumps(ids))
  byId: <string, any> = {}
  for a in found
    byId["${a["id"]}"] = a
  local: <string, any> = byId["nuclear-developer"]!
  // the local agent is always there, told when its service does not answer
  expect(local["available"] == true and local["kind"] == "local" and local["paid"] == false and "does not answer" in "${local["why"]}" and local["whyKey"] == "noAnswer", json.dumps(local))
  expect(byId["claude-code"] == { "id": "claude-code", "kind": "agent", "provider": "claude-code", "label": "Claude Code", "models": ["haiku", "sonnet", "opus"], "defaultModel": "", "available": true, "paid": true }, json.dumps(byId["claude-code"]))
  // Ollama's models are the local kind's OpenCode, never OpenCode's as an agent; Ollama does not answer here
  expect((byId["opencode"] as <string, any>)["models"] == ["anthropic/claude-x"])
  ocLocal: <string, any> = byId["opencode-local"]!
  expect(ocLocal["kind"] == "local" and ocLocal["paid"] == false and ocLocal["available"] == false and ocLocal["whyKey"] == "noLocalModel" and "Ollama does not answer" in "${ocLocal["why"]}", json.dumps(ocLocal))
  codex: <string, any> = byId["codex"]!
  expect(codex["available"] == true or "not on the PATH" in "${codex["why"]}")
  anthropic: <string, any> = byId["anthropic"]!
  expect(anthropic["available"] == true and anthropic["defaultModel"] == "claude-sonnet-5-5" and "claude-haiku-5-5" in (anthropic["models"] as string[]))
  expect((byId["openai"] as <string, any>)["available"] == true and (byId["openai"] as <string, any>)["models"] == ["gpt-x"])
  expect((byId["google"] as <string, any>)["available"] == false and "vault set google" in "${(byId["google"] as <string, any>)["why"]}")
  // the screens say why in their language: its kind and arguments beside the English
  expect((byId["google"] as <string, any>)["whyKey"] == "noKey" and (byId["google"] as <string, any>)["whyArgs"] == ["google"])
  // the general agent's choices: each with the command that answers as it
  // the local one offers only the machine's chat model
  local = chatChoices(found)[0]
  expect(local["id"] == "nuclear-developer" and local["models"] == [local["defaultModel"]] and "${local["defaultModel"]}".length > 0)
  choice = chatChoices(found)[2]
  expect(choice["command"] == ["nuclear-builder", "member", "--role", "chat", "--kind", "agent", "--provider", "claude-code"])

testTheHostFileGivesTheGeneralAgentItsChoices(tmpPath: Path, monkeypatch: any) void
  localOn(monkeypatch)
  root = agentsProject(tmpPath, monkeypatch)
  host = chatHost(root, "es", down())
  members: <string, any>[] = host["members"]!
  atlas = members.last
  responder: <string, any> = atlas["responder"]!
  expect(atlas["id"] == "atlas" and atlas["role"] == "chat" and atlas["listed"] == true and "tech lead" in "${(atlas["profile"] as <string, any>)["bio"]}")
  expect(responder["choice"] == "nuclear-developer" and responder["paid"] == false and responder["command"] == ["nuclear-builder", "member", "--role", "chat", "--kind", "local", "--provider", "nuclear-developer"])
  expect((responder["choices"] as <string, any>[]).length == 12)

// The local models on standby (ADR-platform-0013): the local Nuclear Developer is not offered nor listed with models
// (the local kind is OpenCode on Ollama's models), and the default choice is the first agent installed, else the first
// API provider with a key, else none (a provider is chosen).
testOnStandbyNoLocalAgentIsOfferedAndTheDefaultIsTheFirstExternalOne(tmpPath: Path, monkeypatch: any) void
  root = agentsProject(tmpPath, monkeypatch)
  expect(not localModels())
  ids = agentsHere(root, down()).map((a) => "${a["id"]}")
  expect(ids == AGENT_ORDER.filter((x) => x != "nuclear-developer"), json.dumps(ids))
  // Claude Code is installed: it comes first
  expect(externalWorker() == { "kind": "agent", "provider": "claude-code" }, json.dumps(externalWorker()))
  host = chatHost(root, "en", down())
  responder: <string, any> = (host["members"] as <string, any>[]).last["responder"]!
  expect(responder["choice"] == "claude-code" and responder["paid"] == true and responder["command"] == ["nuclear-builder", "member", "--role", "chat", "--kind", "agent", "--provider", "claude-code"] and responder["why"] == null, json.dumps(responder))
  expect(not (responder["choices"] as <string, any>[]).any((c) => c["id"] == "nuclear-developer"))
  models = modelsHere(root)
  expect(not ("nuclear-developer" in (models["providers"] as <string, any>)))
  asked: <string, any> = (modelsHere(root, "nuclear-developer")["providers"] as <string, any>)["nuclear-developer"]!
  expect(asked["models"] == [] and asked["why"] == STANDBY, json.dumps(asked))
  expect("no longer runs local models" in whyNotHere("nuclear-developer"))
  // no agent on the PATH: the API provider whose key the vault notes, with its default model
  empty = tmpPath.joinpath("empty")
  empty.mkdir()
  monkeypatch.setenv("PATH", "${empty}")
  expect(externalWorker() == { "kind": "api", "provider": "anthropic", "model": "claude-sonnet-5-5" }, json.dumps(externalWorker()))
  // nothing at all: none, and the host says a provider must be chosen
  tmpPath.joinpath("factory", "vault.json").writeText("[]")
  expect(externalWorker() == null)
  none: <string, any> = (chatHost(root, "en", down())["members"] as <string, any>[]).last["responder"]!
  expect(none["choice"] == "" and none["why"] == NO_PROVIDER, json.dumps(none))

testAChatTurnWithClaudeCodeStreamsItsText(tmpPath: Path) void
  told: <string, any>[] = []
  found: <string, any> = { "text": "", "cost": 0.0, "failed": false }
  claudeLine({ "type": "stream_event", "event": { "type": "content_block_delta", "delta": { "type": "text_delta", "text": "Hel" } } }, (e: <string, any>) => told.add(e), found)
  claudeLine({ "type": "stream_event", "event": { "type": "message_start" } }, (e: <string, any>) => told.add(e), found)
  expect(told == [{ "type": "text-delta", "text": "Hel" }], json.dumps(told))
  work = Work("${tmpPath}", "${tmpPath}", "hi", {}, [], "", 0, "nuclear-mcp", 1000, { "stream": true })
  role = Role("chat", "general agent", "You are the general agent.", {}, {}, [], [])
  for name in ["a", "b"]
    tmpPath.joinpath(name).mkdir()
  expect("--include-partial-messages" in claudeArgs(role, "hi", work, tmpPath.joinpath("a")))
  work.inputs = {}
  expect(not ("--include-partial-messages" in claudeArgs(role, "hi", work, tmpPath.joinpath("b"))))
  // the member's protocol carries them
  out: <string, any>[] = []
  MemberLines((e: <string, any>) => out.add(e)).on({ "type": "event", "event": { "type": "text-delta", "text": "lo" } })
  expect(out == [{ "type": "text-delta", "text": "lo" }])

testASpendingConfirmedHoldsOnlyForTheAgentItNamed(tmpPath: Path, monkeypatch: any) void
  root = agentsProject(tmpPath, monkeypatch)
  file = Path(root, CHAT_DIR, "member-x-chat-dm-atlas.jsonl")
  file.parent.mkdir(parents = true, existOk = true)
  file.writeText(json.dumps({ "role": "spending", "confirmed": true, "by": "you", "budgetUsd": 5.0, "providers": ["claude-code"] }) + "\n")
  same = Chat(root, "member-x-chat-dm-atlas", { "provider": "claude-code", "kind": "agent" }, {}, () => null, (e: <string, any>) => print(e))
  same.load()
  other = Chat(root, "member-x-chat-dm-atlas", { "provider": "opencode", "kind": "agent" }, {}, () => null, (e: <string, any>) => print(e))
  other.load()
  expect(same.confirmed and not other.confirmed)

// The local kind's OpenCode (`opencode-local`): the models Ollama has installed, as OpenCode names them, free, with
// what each needs of the memory; the embedding models left out; OpenCode as an agent never lists them.
testOpenCodeLocalOffersOnlyOllamasModels(tmpPath: Path, monkeypatch: any) void
  root = agentsProject(tmpPath, monkeypatch)
  tags = { "models": [{ "name": "qwen2.5-coder:3b", "size": 1_900_000_000, "details": { "family": "qwen2", "parameter_size": "3.1B", "quantization_level": "Q4_K_M" } }, { "name": "embeddinggemma:300m", "details": { "family": "gemma3" } }] }
  ollama = httpx.MockTransport((request: httpx.Request) => httpx.Response(200, json = tags))
  found = agentsHere(root, ollama)
  ocLocal: <string, any> = found.find((a) => a["id"] == "opencode-local")!
  expect(ocLocal["available"] == true and ocLocal["kind"] == "local" and ocLocal["paid"] == false and ocLocal["models"] == ["ollama/qwen2.5-coder:3b"] and ocLocal["defaultModel"] == "ollama/qwen2.5-coder:3b", json.dumps(ocLocal))
  models: <string, any>[] = openCodeLocalModels({ "totalGb": 16.0, "availableGb": 8.0 }, ollama)["models"]!
  expect(models.length == 1 and models[0]["id"] == "ollama/qwen2.5-coder:3b" and models[0]["needGb"] != null, json.dumps(models))
  expect(whyNotHere("opencode-local") == "" and providerKind("opencode-local") == "local" and not asksSpending("local", true))
  none = openCodeLocalModels({ "totalGb": 16.0, "availableGb": 8.0 }, httpx.MockTransport((request: httpx.Request) => httpx.Response(200, json = { "models": [] })))
  expect(none["models"] == [] and "ollama pull" in "${none["why"]}", json.dumps(none))
  // a member worked by it is the local kind, never the Developer
  expect(onDeveloper({ "kind": "local" }) and not onDeveloper({ "kind": "local", "provider": "opencode-local" }))
