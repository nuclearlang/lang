use os
use json
use socket
use httpx
use hashlib
use subprocess
use pathlib{ Path }

// The set-up of the AI services (ADR-installer-0002): what a machine is suggested, what a profile writes, the files
// that start the services at login on each system, the ports and the AI archive.

machine(ram: int, disk: int = 200, gpu: string = "", vram: int = 0) Hardware
  Hardware("linux", "x86_64", "test", 8, ram, gpu, vram, disk)

testTheProfilesGoFromNothingLocalToTheHeaviestAndEachSaysHowFarItWorks() void
  all = PROFILES
  expect(all.map((p) => p.id) == ["remote", "lite", "medium", "hard"])
  for p in all
    works: string[] = p.data["works"]!
    limits: string[] = p.data["limits"]!
    expect(works.length > 0 and limits.length > 0)
    expect((p.coder != null) == (p.id != "remote"))
    if p.coder != null
      expect(p.gb > 0 and p.minRam <= p.ram)
  sizes = all.map((p) => p.gb)
  expect(sizes == sizes.sorted())

// The set-up page's texts in Spanish: setup.json's `<field>_es` beside each English field takes its place, no `_es`
// field is left; a machine's fit says its kind and arguments for the page's dictionary.
testThePlanSaysItsTextsInTheLanguageAsked() void
  for p in PROFILES
    for key in ["title", "summary", "works", "limits", "measured"]
      expect(p.data["${key}_es"] != null, "${p.id}: ${key}_es")
  es = localized(profileOnMachine(PROFILES[1], machine(16)), "es") as <string, any>
  en = localized(profileOnMachine(PROFILES[1], machine(16)), "en") as <string, any>
  expect(es["title"] == "Ligero" and en["title"] == "Lite" and not ("title_es" in es) and not ("works_es" in en))
  expect(es["noteKey"] == "noGpu" and fit(PROFILES[1], machine(2)).key == "noMemory" and fit(PROFILES[1], machine(2)).args == ["4", "2"])
  for r in REQUIREMENTS
    expect(r["why_es"] != null, "${r["id"]}: why_es")

testTheGuideSaysOfEachProfileWhatItsDataSays() void
  // only in the working tree: installer/docs/08-guides/ai-setup.md
  page = Path(__file__).resolve().parents[5].joinpath("installer", "docs", "08-guides", "ai-setup.md")
  if not page.exists()
    return
  text = page.readText(encoding = "utf-8")
  for p in PROFILES.filter((x) => x.coder != null)
    works: string[] = p.data["works"]!
    limits: string[] = p.data["limits"]!
    said = ["| `${p.id}` |", "`${p.coder}`", "`${p.assistant}`", "| ${p.data["gb"]} GB |", "${p.data["ram"]} GB (${p.data["minRam"]} GB at least)", "${p.data["measured"]}", ...works, ...limits]
    for line in said
      expect(line in text, "installer/docs/08-guides/ai-setup.md lacks, for ${p.id}: ${line}")

testAMachineIsSuggestedTheHeaviestProfileThatFitsIt() void
  lite = profileOf("lite")!
  medium = profileOf("medium")!
  hard = profileOf("hard")!
  expect(recommend(machine(hard.ram.round())) == "hard")
  expect(recommend(machine(medium.ram.round())) == "medium")
  expect(recommend(machine(lite.ram.round())) == "lite")
  // too little for the lightest to run well: it is still the suggestion while its models load
  expect(recommend(machine(lite.minRam.round())) == "lite")
  expect(fit(lite, machine(lite.minRam.round())).fit == (lite.minRam < lite.ram ? "tight" : "fits"))
  // nothing local loads: only the remote agents
  expect(recommend(machine(lite.minRam.round() - 1)) == "remote")
  expect(fit(hard, machine(lite.minRam.round() - 1)).fit == "no")
  // a full disk rules a profile out, whatever the memory
  full = fit(hard, machine(64, disk = 3))
  expect(full.fit == "no" and "disk" in full.note)
  // a GPU that holds the models is said
  expect("GPU (RTX)" in fit(lite, machine(32, gpu = "RTX", vram = 24)).note)

testTheChoiceIsKeptInTheMachineFileAndReadBack(tmpPath: Path) void
  file = "${tmpPath.joinpath("nuclearlang", "ai.env")}"
  medium = profileOf("medium")!
  writeMachine(machineOf(medium), file)
  expect(readMachine(file) == { "NUCLEAR_AI_MODE": "local", "NUCLEAR_AI_PROFILE": "medium", "CODER_MODEL": medium.coder!, "ASSISTANT_MODEL": medium.assistant!, "CHAT_MODEL": CHAT_MODEL })
  // the chat's small model is downloaded with every local profile
  expect(CHAT_MODEL in modelsOf(medium))
  // lite has one model for everything, the chat too
  lite = profileOf("lite")!
  expect(machineOf(lite)["CHAT_MODEL"] == lite.coder and modelsOf(lite) == [lite.coder!])
  // a later write keeps what it does not name
  writeMachine({ "CODER_MODEL": "other:1b" }, file)
  expect(readMachine(file)["CODER_MODEL"] == "other:1b" and readMachine(file)["NUCLEAR_AI_PROFILE"] == "medium")
  expect(machineOf(profileOf("remote")!) == { "NUCLEAR_AI_MODE": "remote", "NUCLEAR_AI_PROFILE": "remote" })
  expect(readMachine("${tmpPath.joinpath("no-such-file")}").isEmpty)

testEachSystemGetsTheFilesThatStartTheServicesAtLogin() void
  linux = serviceFiles("linux", "/home/u", "/home/u/.local/bin", "/home/u/.config/nuclearlang/ai.env", "/usr/bin")
  expect(linux.map((f) => f.path) == ["/home/u/.config/systemd/user/nuclear-graph.service", "/home/u/.config/systemd/user/nuclear-developer.service", "/home/u/.config/systemd/user/nuclear-chat.service"])
  expect("ExecStart=/home/u/.local/bin/nuclear-chat serve\n" in linux[2].text)
  expect("ExecStart=/home/u/.local/bin/nuclear-graph serve\n" in linux[0].text)
  expect("EnvironmentFile=-/home/u/.config/nuclearlang/ai.env" in linux[0].text)
  expect("After=nuclear-graph.service" in linux[1].text and "WantedBy=default.target" in linux[1].text)
  // the ports are chosen again at each login, before any service reads them (spec 018 F2)
  expect("ExecStartPre=-/home/u/.local/bin/nuclear-builder setup --ports\n" in linux[0].text and not ("ExecStartPre" in linux[1].text))
  expect("After=nuclear-graph.service" in linux[2].text)
  mac = serviceFiles("darwin", "/Users/u", "/Users/u/.local/bin", "/Users/u/.config/nuclearlang/ai.env", "/usr/bin")
  expect(mac[0].path == "/Users/u/Library/LaunchAgents/io.github.nuclearlang.graph.plist")
  expect("<key>RunAtLoad</key><true/>" in mac[0].text and "exec '/Users/u/.local/bin/nuclear-developer'" in mac[1].text)
  expect(mac[0].text.startsWith("<?xml"))
  expect("nuclear-builder' setup --ports" in mac[0].text and not ("--ports" in mac[1].text))
  windows = serviceFiles("win32", "C:\\Users\\u", "C:\\n\\bin", "C:\\Users\\u\\AppData\\Roaming\\nuclearlang\\ai.env", "")
  expect(windows.length == 1 and windows[0].path.endsWith("Startup\\nuclear-ai.cmd"))
  expect(windows[0].text.indexOf("setup --ports") < windows[0].text.indexOf("for /f"))
  expect("nuclear-graph.exe\" serve" in windows[0].text and "nuclear-developer.cmd\"" in windows[0].text and "nuclear-chat.exe\" serve" in windows[0].text)
  expect(serviceFiles("freebsd", "/home/u", "/b", "/m", "").isEmpty)
  // a service runs with the tools' folders, not with the PATH of whoever ran the set-up
  unit = serviceFiles("linux", "/home/u", "/home/u/.local/bin", "/m")[0].text
  expect("Environment=PATH=/home/u/.local/bin:/home/u/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin\n" in unit)

testTheLauncherTakesTheMachineModelsUnlessTheCallerGivesItsOwn(tmpPath: Path) void
  sh = launcher("/opt/ai", "/home/u/.config/nuclearlang/ai.env", "linux")
  expect(sh.path == "nuclear-developer" and sh.text.startsWith("#!/bin/sh\n"))
  expect("cd \"/opt/ai/nuclear-agents/nuclear_developer/build\" && exec .venv/bin/uvicorn app.main:app" in sh.text)
  // run for real: a value of the file fills what is unset, a value of the caller stays
  env = tmpPath.joinpath("ai.env")
  env.writeText("# comment\nCODER_MODEL=from-file\nASSISTANT_MODEL=from-file\n")
  lines = launcher("${tmpPath}", "${env}", "linux").text.split("\n").map((l) => l.startsWith("cd ") ? "echo \"$CODER_MODEL $ASSISTANT_MODEL\"" : l)
  script = tmpPath.joinpath("run.sh")
  script.writeText(lines.join("\n"))
  out = subprocess.run(["sh", "${script}"], captureOutput = true, text = true, env = { "PATH": os.environ["PATH"]!, "CODER_MODEL": "from-caller" })
  expect(out.stdout.trim() == "from-caller from-file")
  expect(launcher("C:\\ai", "C:\\m\\ai.env", "win32").path == "nuclear-developer.cmd")

testAProfileIsInstalledInItsStepsAndRemoteAgentsAloneTakeTwo() void
  // the Smart Graph in every profile (the MCP server reads it), with its own model: Ollama only for the local agents
  expect(steps(profileOf("remote")!).map((s) => s.id) == ["graph", "clients", "graph-model", "graph-service", "knowledge"])
  expect(servicesOf(profileOf("remote")!).map((s) => s.name) == ["graph"] and servicesOf(profileOf("medium")!).length == 3)
  expect(modelsOf(profileOf("remote")!).isEmpty and not (EMBEDDINGS in modelsOf(profileOf("hard")!)))
  expect(steps(profileOf("lite")!).map((s) => s.id) == ["graph", "clients", "graph-model", "developer", "models", "graph-service", "knowledge", "developer-service", "chat-service"])
  expect(EMBEDDINGS in steps(profileOf("hard")!)[2].title)

testEveryRequirementCanBeInstalledOnTheThreeSystemsOrByHand() void
  expect(REQUIREMENTS.map((r) => "${r["id"]}") == ["nuclearlang", "uv", "ollama"])
  for r in REQUIREMENTS
    install: <string, string> = r["install"]!
    expect("${r["url"]}".startsWith("https://"))
    for system in ["linux", "darwin", "win32"]
      expect(install[system] != null, "${r["id"]} on ${system}")
  // Ollama only for the local agents: the Smart Graph runs its model itself
  expect(REQUIREMENTS.find((r) => r["id"] == "ollama")!["local"] == true)
  expect(hasModel(["embeddinggemma:latest"], "embeddinggemma") and hasModel(["a:3b"], "a:3b") and not hasModel(["a:3b"], "a"))
  // what Ollama already has is used; only the rest would be downloaded
  expect(missingOf(["embeddinggemma", "a:3b", "b:2b"], ["embeddinggemma:latest", "a:3b"]) == ["b:2b"])
  expect(missingOf(["a:3b"], ["a:3b"]).isEmpty)

// `--remove --all` takes away what the set-up made (its folders) and leaves the rest of the machine as it was.
testAnUninstallTakesAwayWhatTheSetUpMadeAndOnlyThat(tmpPath: Path) void
  saved = dict(os.environ)
  try
    os.environ["XDG_DATA_HOME"] = "${tmpPath.joinpath("data")}"
    os.environ["XDG_CONFIG_HOME"] = "${tmpPath.joinpath("config")}"
    os.environ.pop("NUCLEAR_GRAPH_HOME", null)
    for name in ["nuclear-graph", "nuclear-chat", "someone-else"]
      tmpPath.joinpath("data", name).mkdir(parents = true)
    writeMachine({ "NUCLEAR_AI_PROFILE": "remote" })
    said: string[] = []
    purge({}, (line) => said.add(line), secrets = false)
    expect(not dataFolder("nuclear-graph").exists() and not dataFolder("nuclear-chat").exists())
    expect(not Path(machineFile()).parent.exists())
    expect(tmpPath.joinpath("data", "someone-else").exists(), "what the set-up did not make stays")
    expect(said.length == 3, "${said}")
  finally
    os.environ.clear()
    os.environ.update(saved)
  // Ollama is taken away the way it came; on Linux its installer put it in the system
  expect(ollamaRemoval("darwin") == ["brew services stop ollama", "brew uninstall ollama"])
  expect(ollamaRemoval("linux").all((s) => s.startsWith("sudo ")))

// Colors only on a terminal: what the editors read and CI logs stay plain text.
testThePaintIsPlainTextWithoutATerminal() void
  expect(paint("Hard", "yellow") == "Hard" and paint("✓", "green") == "✓")

// Without a terminal a step is its title and what it says, a percent only every tenth: CI logs stay short.
testASpinnerWithoutATerminalSaysItsWorkInFewLines(capsys: any) void
  work = Spinner("Download the models", "the local agents' models")
  work.start()
  for p in 0..101
    work.update("qwen2.5-coder:1.5b: ${p}% of 1.0 GB")
  work.finish(true)
  out: string = capsys.readouterr().out
  expect("... Download the models" in out and "✓ Download the models" in out, out)
  expect(out.split("\n").filter((l) => "% of" in l).length == 11, out)

// macOS (found on the first install, 2026-11-19): a later step loaded every agent again, and a `bootstrap` right after
// `bootout` failed with "5: Input/output error". An unchanged loaded agent is left alone; a changed one is waited for.
testALaunchAgentIsLeftAloneWhenLoadedAndRetriedWhileLaunchdHoldsIt(monkeypatch: any) void
  calls: string[] = []
  loaded = [true]
  failures = [1]
  fake = (args: string[], cwd: string? = null) =>
    calls.add(args[1])
    if args[1] == "print"
      return Ran(loaded[0] ? 0 : 113, "")
    if args[1] == "bootout"
      loaded[0] = false
      return Ran(0, "")
    if failures[0] > 0
      failures[0] -= 1
      return Ran(5, "Bootstrap failed: 5: Input/output error")
    loaded[0] = true
    Ran(0, "")
  monkeypatch.setattr("nuclear_builder.setup.capture", fake)
  monkeypatch.setattr("time.sleep", (s: double) => null)
  said: string[] = []
  graph = serviceOf("graph")
  loadAgent(graph, "/x/graph.plist", false, (l) => said.add(l))
  expect(calls == ["print"] and "already started" in said[0], "${calls}")
  calls.clear()
  loadAgent(graph, "/x/graph.plist", true, (l) => said.add(l))
  expect(calls == ["bootout", "print", "bootstrap", "bootstrap"] and "started at every login" in said.last, "${calls}")

// The vectors computed ahead come from the release of this archive, or a mirror (ADR-graph-0003).
testTheReleasesVectorsAreFetchedFromItsReleaseOrAMirror() void
  expect(releaseUrl("0.1.8", "nuclearlang-embeddings-0.1.8.npz", {}) == "https://github.com/nuclearlang/lang/releases/download/v0.1.8/nuclearlang-embeddings-0.1.8.npz")
  expect(releaseUrl("0.1.8", "x.npz", { "NUCLEAR_DOWNLOAD": "http://127.0.0.1:9000" }) == "http://127.0.0.1:9000/x.npz")
  expect(releaseUrl("0.1.8", "x.npz", { "NUCLEAR_REPO": "me/fork" }).startsWith("https://github.com/me/fork/releases/download/v0.1.8/"))

// The release's vectors land where the graph reads them, checked against their SHA-256 (found on Windows, 0.1.8:
// the step failed after the download, on the size of the file it said).
testTheReleasesVectorsAreDownloadedCheckedAndKept(tmpPath: Path, monkeypatch: any) void
  ai = tmpPath.joinpath("ai")
  ai.mkdir()
  ai.joinpath("VERSION").writeText("0.1.8")
  body: Bytes = "vectors".toBytes()
  digest = hashlib.sha256(body).hexdigest()
  answer = (url: string, followRedirects: boolean = false, timeout: double = 0.0) =>
    httpx.Response(200, content = url.endsWith(".sha256") ? "${digest}  nuclearlang-embeddings-0.1.8.npz".toBytes() : body, request = httpx.Request("GET", url))
  monkeypatch.setattr("nuclear_builder.setup.ai_root", () => "${ai}")
  monkeypatch.setattr("httpx.get", answer)
  monkeypatch.setenv("NUCLEAR_GRAPH_HOME", "${tmpPath.joinpath("graph")}")
  said: string[] = []
  fetchVectors((l) => said.add(l))
  expect(tmpPath.joinpath("graph", "models", "embeddings.npz").readBytes() == body, "${said}")
  expect("loads in seconds" in said.last, "${said}")

testAServiceTakesTheNextFreePortWhenAnotherProgramHoldsItsOwn() void
  held = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
  held.bind(socket.getaddrinfo("127.0.0.1", 0, socket.AF_INET, socket.SOCK_STREAM)[0][4])
  held.listen(1)
  port: int = held.getsockname()[1]
  try
    expect(not canListen(port))
    notOurs = (p: int) => false
    next = choosePort(port, notOurs)
    expect(next > port and canListen(next))
    // a port another service took is skipped
    expect(choosePort(port, notOurs, [next]) != next)
    // our own service keeps its port
    expect(choosePort(port, (p: int) => p == port) == port)
  finally
    held.close()
  expect(PORTS == { "graph": 7878, "developer": 7879, "chat": 7880 })

testTheAiArchiveIsFoundByItsLaunchersAndTheyAreLinkedOntoThePath(tmpPath: Path) void
  root = tmpPath.joinpath("ai")
  bin = tmpPath.joinpath("bin")
  expect(not hasRuntime("${root}", "linux"))
  root.joinpath("bin").mkdir(parents = true)
  for c in RUNTIME_COMMANDS
    root.joinpath("bin", c).writeText("#!/bin/sh\n")
  expect(hasRuntime("${root}", "linux"))
  // Windows looks for the .cmd launchers
  expect(not hasRuntime("${root}", "win32"))
  linked = linkRuntime("${root}", "${bin}", "linux")
  expect(linked.map((l) => Path(l).name) == RUNTIME_COMMANDS)
  for l in linked
    expect(Path(l).readlink() == root.joinpath("bin", Path(l).name))
  cmd = linkRuntime("C:\\Users\\a\\nuclearlang\\ai", "${bin}", "win32")[0]
  expect(Path(cmd).readText().startsWith("@\"C:\\Users\\a\\nuclearlang\\ai\\bin\\nuclear-graph.cmd\" %*"))

testTheToolsFindTheFoldersOfNuclearLangOnTheirPath() void
  e = toolEnv({ "PATH": "/usr/bin:/usr/bin" }, "linux")
  dirs = e["PATH"]!.split(":")
  expect(dirs[0] == "/usr/bin" and dirs.count((d) => d == "/usr/bin") == 1)
  expect("/opt/homebrew/bin" in dirs and dirs.any((d) => d.endsWith("/.local/bin")))

// Each AI client gets the MCP server in the shape it reads; what else its file holds is kept, a file that is not JSON
// is left as it is, and taking the server out leaves the rest.
testTheMcpServerIsAddedToAClientsFileAndTakenOutKeepingTheRest(tmpPath: Path) void
  file = tmpPath.joinpath("opencode", "opencode.json")
  file.parent.mkdir(parents = true)
  file.writeText(json.dumps({ "theme": "dark", "mcp": { "other": { "type": "local", "command": ["x"] } } }))
  expect("wrote" in addJsonEntry(file, "mcp", mcpEntry("OpenCode", "/opt/bin/nuclear-mcp")))
  written: <string, any> = json.loads(file.readText())
  expect(written["theme"] == "dark" and written["mcp"]!["other"] != null)
  expect(written["mcp"]!["nuclear"] == { "type": "local", "command": ["/opt/bin/nuclear-mcp"], "enabled": true })
  expect("already" in addJsonEntry(file, "mcp", mcpEntry("OpenCode", "/opt/bin/nuclear-mcp")))
  expect(removeJsonEntry(file, "mcp") != null and removeJsonEntry(file, "mcp") == null)
  left: <string, any> = json.loads(file.readText())
  servers: <string, any> = left["mcp"]!
  expect(not ("nuclear" in servers) and "other" in servers)
  broken = tmpPath.joinpath("broken.json")
  broken.writeText("{ not json")
  expect("left as it is" in addJsonEntry(broken, "mcpServers", mcpEntry("Cursor", "nuclear-mcp")) and broken.readText() == "{ not json")
  empty = tmpPath.joinpath("empty.json")
  empty.writeText("")
  expect("wrote" in addJsonEntry(empty, "mcpServers", mcpEntry("Cursor", "nuclear-mcp")) and "nuclear" in empty.readText())
  expect(mcpEntry("Gemini CLI", "nuclear-mcp") == { "command": "nuclear-mcp" })
  expect(jsonClients({ "XDG_CONFIG_HOME": "/cfg" })[1].file == "${Path("/cfg", "opencode", "opencode.json")}")

// Grok Build gets the MCP server with its own command (`grok mcp add`), once, and loses it with the services.
testGrokBuildGetsTheMcpServerOnceAndLosesItOnRemove(tmpPath: Path, monkeypatch: any) void
  servers: string[] = []
  calls: string[][] = []
  fake = (args: string[], cwd: string? = null) =>
    calls.add(args)
    if args[1] == "mcp" and args[2] == "list"
      return Ran(0, servers.join("\n"))
    if args[1] == "mcp" and args[2] == "add"
      servers.add(args[3])
    if args[1] == "mcp" and args[2] == "remove"
      servers.remove(args[3])
    Ran(0, "")
  monkeypatch.setattr("nuclear_builder.setup.capture", fake)
  monkeypatch.setattr("nuclear_builder.setup.which", (name: string) => name == "grok" ? "/bin/grok" : null)
  monkeypatch.setattr("nuclear_builder.setup.home", () => tmpPath)
  monkeypatch.setenv("XDG_CONFIG_HOME", "${tmpPath.joinpath(".config")}")
  said: string[] = []
  connectClients((l) => said.add(l))
  expect(said == ["Grok Build: added the nuclear MCP server"], "${said}")
  add = calls.find((c) => c[2] == "add")!
  expect(add[0] == "grok" and add[3] == "nuclear" and add[4] == "--", "${add}")
  said.clear()
  connectClients((l) => said.add(l))
  expect(said == ["Grok Build: the nuclear MCP server is already there"], "${said}")
  said.clear()
  disconnectClients((l) => said.add(l))
  expect(said == ["Grok Build: removed the nuclear MCP server"] and servers.isEmpty, "${said}")

// The local agents are optional and asked (ADR-installer-0006): `--yes` without a profile is `remote`, and a local
// profile whose models are declined goes on as `remote`; the Smart Graph and the MCP server come in both.
testTheSetUpIsRemoteByDefaultAndADeclinedLocalProfileGoesOnAsRemote(monkeypatch: any, capsys: any) void
  asked: string[] = []
  monkeypatch.setattr("nuclear_builder.cli.have_requirements", (p: Profile, always: boolean) =>
    asked.add("requirements ${p.id}")
    true)
  monkeypatch.setattr("nuclear_builder.cli.have_models", (p: Profile, always: boolean) =>
    asked.add("models ${p.id}")
    p.id == "remote")
  // the steps stop where the installation is looked for: what was chosen before is what is tested
  monkeypatch.setattr("nuclear_builder.setup.ai_root", () => null)
  expect(setup(["--yes"]) == 1)
  expect(asked == ["requirements remote", "models remote"], "${asked}")
  asked.clear()
  capsys.readouterr()
  expect(setup(["--profile", "lite", "--yes"]) == 1)
  expect(asked == ["requirements lite", "models lite"], "${asked}")
  expect("installed with the profile remote" in "${capsys.readouterr().out}")
