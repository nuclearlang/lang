// What a test holds true: it fails at the line that says it when it is not, with why.
expect(held: boolean, why: string = "it does not hold") void
  if not held
    throw AssertionError(why)

// A team of one member per role (each member's id its role, the first employee of `known`'s roster), worked by the
// local Nuclear Developer with the default models, but the roles of `paid`: Claude Code `haiku`.
crew(name: string, paid: string[] = [], known: <string, any>? = null) <string, any>
  team = localTeam({}, known)
  team["name"] = name
  team["id"] = teamSlug(name)
  for m in team["members"] as <string, any>[]
    if m["role"] in paid
      m["kind"] = "agent"
      m["provider"] = "claude-code"
      m["model"] = "haiku"
  team

// The local models switched on, for a test of their code (ADR-platform-0013: on standby, setup.json's `localModels`).
localOn(monkeypatch: any) void
  monkeypatch.setitem(DATA, "localModels", true)
