// A fake `nuclear` on the PATH: each call goes to `nuclear.log`; `check . --json` answers `errors`, `explain` the
// frame of lib/count.nuc, `fix` changes nothing.
fakeNuclear(tmpPath: Path, monkeypatch: any, errors: string = "[]") void
  bin = tmpPath.joinpath("bin")
  bin.mkdir(existOk = true)
  tool = bin.joinpath("nuclear")
  tool.writeText("#!/bin/sh\necho \"$@\" >> \"${tmpPath.joinpath("nuclear.log")}\"\ncase \"$1\" in\n  check) cat <<'EOF'\n${errors}\nEOF\n  ;;\n  explain) cat > /dev/null; printf '{\"title\": \"count is wrong\", \"hint\": \"it answers 1\", \"frames\": [{\"source\": \"%s/lib/count.nuc\", \"line\": 1, \"name\": \"count\"}]}\\n' \"$PWD\" ;;\n  fix) exit 1 ;;\nesac\n")
  tool.chmod(493)
  monkeypatch.setenv("PATH", "${bin}:${os.environ["PATH"]!}")

