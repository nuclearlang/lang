// What the local analyst answers for a strategy (ADR-developer-0001), with `more` over it.
analysisOf(more: <string, any>) <string, any>
  found: <string, any> = { "strategy": "strategy:resource-db", "title": "Strategy: a resource stored in the database", "why": "it writes \"CRUD\"", "mode": "write", "stages": ["generate", "plan", "test", "code", "verify"], "lead": "local", "source": "plan", "generate": [] as any[], "pieces": [] as any[], "questions": [] as string[], "limits": [] as string[], "report": "the report", "trace": [] as any[] }
  for k, v in more
    found[k] = v
  found

testTheQuestionsOfTheAnalysisStopTheRunUntilTheClientAnswersThem(tmpPath: Path, monkeypatch: any) void
  localOn(monkeypatch)
  root = lineProject(tmpPath, monkeypatch, [], { "stations": ["analysis"] })
  calls: string[] = []
  team = localCrew()
  transport = developer(calls, { "/developer/analyze": [analysisOf({ "questions": ["Which fields does it have?", "Which url?"] }), analysisOf({})] })
  run = newRun(root, { "name": "app", "platform": "backend" }, parseSpec(SPEC, "count-books"), team, ["analysis"])
  waited = again(run, root, team, transport).start()
  asked: <string, any> = waited["waiting"]!
  expect(waited["status"] == "waiting" and asked["id"] == "gate-analysis" and asked["questions"] == ["Which fields does it have?", "Which url?"])
  s = stepsOf(waited)[0]
  expect(s["summary"] == "resource-db: the request does not say: Which fields does it have? (and 1 more: read this step)" and s["log"] == "the report")
  expect(Path(root, "specs", "count-books", "questions.md").readText().endsWith("- Which url?\n"))
  // the client's answers go to the analyst, who asks nothing more: the run goes on (the analysis is no gate here)
  given: <string, any>[] = [{ "answer": "change", "text": "title and year; no url" }]
  f = Factory(loadRun(root, "count-books")!, team, readLine(root, "backend"), (q: <string, any>) => nextAnswer(given, q), (e: <string, any>) => null, { "preflight": false, "transport": transport })
  expect(f.start()["status"] == "passed" and calls == ["/developer/analyze", "/developer/analyze"])

