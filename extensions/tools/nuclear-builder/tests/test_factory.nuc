testAPieceTheLocalCoderLeavesWithErrorsGoesToTheLead(tmpPath: Path, monkeypatch: any) void
  localOn(monkeypatch)
  root = lineProject(tmpPath, monkeypatch, [])
  bin = tmpPath.joinpath("bin")
  bin.mkdir()
  result = json.dumps({ "type": "result", "result": "fixed:\n```nuclear\ncount() int = 0\n```", "total_cost_usd": 0.05, "is_error": false })
  bin.joinpath("claude").writeText("#!/bin/sh\nmkdir -p lib && printf 'count() int = 0\\n' > lib/count.nuc\ncat <<'EOF'\n${result}\nEOF\n")
  bin.joinpath("claude").chmod(493)
  monkeypatch.setenv("PATH", "${bin}:${os.environ["PATH"]!}")
  team = crew("Claude", ["analyst", "architect"], ROSTERLESS)
  run = newRun(root, { "name": "app", "platform": "backend" }, parseSpec(SPEC, "count-books"), team, ["code"])
  (run["spec"] as <string, any>)["pieces"] = [{ "path": "lib/count.nuc", "kind": "function", "task": "function count", "by": "planner" }]
  done = Factory(run, team, readLine(root, "backend"), (q: <string, any>) => null, (e: <string, any>) => null, { "preflight": false, "confirmSpending": true, "transport": developer([], { "/developer/code": { "code": "count() int = \n", "check": "1:15 N0001 an expression is missing", "attempts": 3 } }) }).start()
  expect(done["status"] == "passed", json.dumps(stepsOf(done).map((s) => [s["title"], s["summary"]])))
  fix = stepsOf(done).find((s) => s["title"] == "The Architect fixes lib/count.nuc")!
  expect(fix["key"] == "leadFixFile" and fix["args"] == ["architect", "lib/count.nuc"])
  expect(fix["provider"] == "claude-code" and fix["status"] == "passed" and fix["code"] == "count() int = 0\n" and ((done["costUsd"] as double) - 0.05).abs() < 0.000001)
  // an agent's subscription asks no spending (spec 023 requirement 4): nothing to confirm, nothing kept
  expect(done["spending"] == null)

// A station run again judges its work again: a check of its role that failed in an earlier attempt runs again and
// takes the new result, instead of failing Quality for good.
testARoleCheckThatFailedBeforeRunsAgainWithItsStation(tmpPath: Path, monkeypatch: any) void
  localOn(monkeypatch)
  root = lineProject(tmpPath, monkeypatch, [], { "commands": { "check": ["echo checked"], "build": [] as string[], "test": [] as string[], "probe": ["test -f ready"] } })
  calls: string[] = []
  given: <string, any>[] = [{ "answer": "yes" }, { "answer": "no" }]
  first = factory(root, localCrew(), given, developer(calls)).start()
  expect(first["status"] == "passed")
  addCheck(root, "count-books", "The probe holds", "code", "role", null, "probe")
  markCheck(root, "count-books", "user.1", "failed", "an earlier attempt")
  Path(root, "ready").writeText("")
  more: <string, any>[] = [{ "answer": "yes" }, { "answer": "no" }]
  again = Factory(loadRun(root, "count-books")!, localCrew(), readLine(root, "backend"), (q: <string, any>) => nextAnswer(more, q), (e: <string, any>) => null, { "preflight": false, "transport": developer(calls) })
  done = again.start("code")
  probe = loadChecks(root, "count-books").find((c) => c["id"] == "user.1")!
  expect(probe["state"] == "passed")
  stages: <string, any>[] = done["stages"]!
  expect(stages.find((st) => st["id"] == "quality")!["status"] == "passed")

// A fake Claude Code for the repair: a diagnosis answers `verdict`; a check fails its first time, then passes; any
// other call writes the design. Each prompt is appended to `prompts.log`.
repairingClaude(tmpPath: Path, monkeypatch: any, verdict: string) void
  bin = tmpPath.joinpath("bin")
  bin.mkdir(existOk = true)
  tool = bin.joinpath("claude")
  seen = tmpPath.joinpath("check-seen")
  log = tmpPath.joinpath("prompts.log")
  tool.writeText("#!/usr/bin/env python3\nimport json, os, sys\nprompt = ' '.join(sys.argv)\nopen('${log}', 'a').write(prompt.replace('\\\\n', ' ') + '\\\\n=====\\\\n')\nif 'NOT FIXABLE' in prompt:\n    said = ${json.dumps(verdict)}\nelif 'PASSED or FAILED' in prompt:\n    said = 'PASSED' if os.path.exists('${seen}') else 'FAILED\\\\nThe design cites ADR-0002, which this project does not have.'\n    open('${seen}', 'a').close()\nelse:\n    said = '--- document: design.md ---\\\\n# Design\\\\n\\\\nIt follows ADR-0001.'\nprint(json.dumps({'type': 'result', 'result': said, 'total_cost_usd': 0.01, 'is_error': False}))\n")
  tool.chmod(493)
  monkeypatch.setenv("PATH", "${bin}:${os.environ["PATH"]!}")

repairTeam() <string, any>
  team = crew("Claude", ["architect"], ROSTERLESS)
  memberFor(team, "architect")!["tasks"] = [{ "id": "adrs", "title": "The design follows the project's ADRs", "station": "design", "on": true }]
  team

// spec 024 requirement 6: a station that fails is diagnosed once by its own provider; FIXABLE runs it once more with the
// diagnosis in its task, and the run goes on; the repair is in the run file for the channel.
testAFailedStationIsDiagnosedOnceAndRunsAgainWithTheDiagnosis(tmpPath: Path, monkeypatch: any) void
  root = lineProject(tmpPath, monkeypatch, [], { "stations": ["design"] })
  repairingClaude(tmpPath, monkeypatch, "FIXABLE\nCite ADR-0001 only: ADR-0002 does not exist here.")
  team = repairTeam()
  run = newRun(root, { "name": "app", "platform": "backend" }, parseSpec(SPEC, "count-books"), team, ["design"])
  done = Factory(run, team, readLine(root, "backend"), (q: <string, any>) => null, (e: <string, any>) => null, { "preflight": false }).start()
  expect(done["status"] == "passed", json.dumps(stepsOf(done).map((s) => [s["title"], s["status"], s["summary"]])))
  repairs: <string, any>[] = done["repairs"]!
  expect(repairs.length == 1 and repairs[0]["station"] == "design" and repairs[0]["fixable"] == true and "ADR-0001" in "${repairs[0]["diagnosis"]}" and repairs[0]["costUsd"] == 0.01, json.dumps(repairs))
  prompts = tmpPath.joinpath("prompts.log").readText().split("=====")
  works = prompts.filter((p) => "Design what the generators did not write" in p)
  // the design worked twice; the second time with the diagnosis
  expect(works.length == 2 and not ("A repair" in works[0]) and "A repair" in works[1] and "Cite ADR-0001 only" in works[1])
  expect(done["repairing"] == null and stepsOf(done).any((s) => s["title"] == "Why it failed, and the repair" and s["status"] == "skipped"))

// A diagnosis that says NOT FIXABLE stops the run for the user: no second attempt, the diagnosis kept.
testADiagnosisThatCannotFixItStopsTheRun(tmpPath: Path, monkeypatch: any) void
  root = lineProject(tmpPath, monkeypatch, [], { "stations": ["design"] })
  repairingClaude(tmpPath, monkeypatch, "NOT FIXABLE\nThe user must decide which ADRs apply.")
  team = repairTeam()
  run = newRun(root, { "name": "app", "platform": "backend" }, parseSpec(SPEC, "count-books"), team, ["design"])
  done = Factory(run, team, readLine(root, "backend"), (q: <string, any>) => null, (e: <string, any>) => null, { "preflight": false }).start()
  repairs: <string, any>[] = done["repairs"]!
  expect(done["status"] == "failed" and repairs.length == 1 and repairs[0]["fixable"] == false)
  works = tmpPath.joinpath("prompts.log").readText().split("=====").filter((p) => "Design what the generators did not write" in p)
  expect(works.length == 1)

// spec 024 requirement 2: one run of two specs, one bill: each spec through every station in order, the first kept in
// its entry with its stations, what its steps wrote settled (never undone by the second's failure).
testOneRunWorksSeveralSpecsInOrder(tmpPath: Path, monkeypatch: any) void
  localOn(monkeypatch)
  root = lineProject(tmpPath, monkeypatch, [], { "stations": ["analysis", "design"] })
  Path(root, "specs", "count-shelves").mkdir(parents = true)
  second = SPEC.replace("Count the books", "Count the shelves")
  Path(root, "specs", "count-shelves", "spec.md").writeText(second)
  team = localCrew()
  first = parseSpec(SPEC, "count-books")
  run = newRun(root, { "name": "app", "platform": "backend", "dialect": "fastapi" }, first, team, ["analysis", "design"])
  run["id"] = "count-books-plus-1"
  run["specs"] = [{ "id": "count-books", "title": first["title"], "specPath": "specs/count-books", "spec": first, "status": "running" }, { "id": "count-shelves", "title": "Count the shelves", "specPath": "specs/count-shelves", "spec": parseSpec(second, "count-shelves"), "status": "pending" }]
  calls: string[] = []
  done = Factory(run, team, readLine(root, "backend"), (q: <string, any>) => null, (e: <string, any>) => null, { "preflight": false, "transport": developer(calls) }).start()
  specs: <string, any>[] = done["specs"]!
  expect(done["status"] == "passed" and specs.map((e) => e["status"]) == ["passed", "passed"], json.dumps(specs.map((e) => e["status"])))
  expect((done["spec"] as <string, any>)["id"] == "count-shelves" and done["specPath"] == "specs/count-shelves")
  expect(((specs[0]["stages"] as <string, any>[]).map((st) => st["status"])) == ["passed", "passed"])
  // both analyses were written, each in its spec's folder; one run file
  expect(Path(root, "specs", "count-books", "analysis.md").isFile() and Path(root, "specs", "count-shelves", "analysis.md").isFile())
  expect(calls.count((c) => c == "/developer/analyze") == 2 and loadRun(root, "count-books-plus-1") != null)
  settled = ((done["writes"] ?? []) as <string, any>[]).filter((w) => "${w["step"]}".startsWith("count-books:"))
  expect(not settled.isEmpty and settled.all((w) => "${w["step"]}" in passedSteps(done)))

// `run <spec> <spec>` and `run_start`'s `specs`: one run named after the first, the specs listed in order; a spec named
// twice is refused.
testARunOfSeveralSpecFilesListsThemInOrder(tmpPath: Path, monkeypatch: any) void
  localOn(monkeypatch)
  root = lineProject(tmpPath, monkeypatch)
  Path(root, ".nuclear", "project.json").writeText(json.dumps({ "name": "app", "platform": "backend", "dialect": "fastapi" }))
  Path(root, "specs", "count-shelves").mkdir(parents = true)
  Path(root, "specs", "count-shelves", "spec.md").writeText(SPEC.replace("Count the books", "Count the shelves"))
  books = "${Path(root, "specs", "count-books", "spec.md")}"
  made = prepareRun(root, [books, "${Path(root, "specs", "count-shelves", "spec.md")}"], null)
  run: <string, any> = made["run"]!
  expect(run["id"] == "count-books-plus-1" and (run["specs"] as <string, any>[]).map((e) => [e["id"], e["status"]]) == [["count-books", "running"], ["count-shelves", "pending"]])
  single: <string, any> = prepareRun(root, [books], null)["run"]!
  expect(not ("specs" in single))
  said = ""
  try
    prepareRun(root, [books, books], null)
  catch e
    said = "${e}"
  expect("named twice" in said)

// The tests written before their code must fail (the developer's check `expect = "fail"`): a failing command passes
// its step, one that passes fails it (those tests would test nothing new); a compile error is caught by `check` first.
testATestWrittenBeforeItsCodeMustFail(tmpPath: Path, monkeypatch: any) void
  root = lineProject(tmpPath, monkeypatch, [])
  f = factory(root, localCrew(), [], developer([]))
  st: <string, any> = { "id": "tests", "title": "Tests first", "status": "running", "steps": [] as any[] }
  expect(f.commands(st, ["exit 1"], false, true))
  expect(not f.commands(st, ["echo passing"], false, true))
  steps: <string, any>[] = st["steps"]!
  expect(steps[0]["status"] == "passed" and "as they must" in "${steps[0]["summary"]}" and steps[1]["status"] == "failed", json.dumps(steps))

// A model's verdict is read whatever Markdown wraps it: a real diagnosis came back `**FIXABLE**` and was read as not
// fixable, so the repair its own plan described never ran.
testAVerdictIsReadThroughItsMarkdown() void
  expect(verdictOf("**FIXABLE**\n\nthe plan").startsWith("FIXABLE"))
  expect(verdictOf("# PASSED\nwhy").startsWith("PASSED"))
  expect(verdictOf("`FAILED`: x").startsWith("FAILED"))
  expect(verdictOf("  not fixable").startsWith("NOT FIXABLE"))
  expect(not verdictOf("It is FIXABLE").startsWith("FIXABLE"))

// What only the user can decide (a check's `NEEDS YOU:` line: replacing their CI file) is asked at the station's gate,
// once, never a failed check.
testWhatOnlyTheUserDecidesIsAskedAtTheGate(tmpPath: Path, monkeypatch: any) void
  root = lineProject(tmpPath, monkeypatch, [])
  f = factory(root, localCrew(), [], developer([]))
  st: <string, any> = { "id": "delivery", "steps": [] as any[] }
  expect(f.toDecide(st) == "")
  f.youDecide(st, "Replace .github/workflows/nuclear-builder.yml with the line's?")
  f.youDecide(st, "Replace .github/workflows/nuclear-builder.yml with the line's?")
  expect(f.toDecide(st) == " Decide also: Replace .github/workflows/nuclear-builder.yml with the line's?", f.toDecide(st))
  f.youDecide(st, "Initialize the git repository? This folder has no .git, so no branch can be made.")
  expect(f.toDecide(st).endsWith(" Initialize the git repository?"), f.toDecide(st))

// The CI file the line would write is shown without writing it (`ci_preview`, `export --print`): a check compares
// with it and never replaces the user's file.
testTheCiFileIsComparedWithoutWritingIt(tmpPath: Path, monkeypatch: any) void
  root = lineProject(tmpPath, monkeypatch, [])
  first = ciPreview(root, "github")
  expect(first["exists"] == false and first["same"] == false and not Path(root, "${first["path"]}").exists())
  writeCiFile(root, "github")
  expect(ciPreview(root, "github")["same"] == true)
  Path(root, "${first["path"]}").writeText("# mine\n")
  expect(ciPreview(root, "github")["same"] == false and Path(root, "${first["path"]}").readText() == "# mine\n")
