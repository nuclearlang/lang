use json
use pathlib{ Path }

// The line's commands (`.nuclear/builder.json`): commands are data, the shell runs nothing that is not there. The
// same commands run in `nuclear-builder ci` and in the CI file `nuclear-builder export` writes: the agents' stations
// run on the developer's machine, a server checks their result.

CI_STAGES = ["check", "test", "security", "artifacts", "deploy"]
CI_PROVIDERS = ["github", "gitlab", "bitbucket"]
INSTALL = "curl -fsSL https://raw.githubusercontent.com/nuclearlang/nuclearlang/main/installer/release/install.sh | sh"
COMMAND_NAMES = ["check", "build", "test", "security", "artifacts", "seed", "integration", "deploy"]

// The default commands of a platform: the ones its CLI already has.
defaultCommands(platform: string) <string, string[]>
  mobile = platform == "mobile"
  { "check": ["nuclear check . --json"], "build": mobile ? ["nuclear build"] : ["nuclear build", "nuclear install"], "test": ["nuclear test"], "security": [] as string[], "artifacts": mobile ? ["nuclear build web"] : ["nuclear build"], "seed": [] as string[], "integration": [] as string[], "deploy": [] as string[] }

// How many times each level of a run is tried again by itself before the next one (`.nuclear/builder.json` "retries",
// a key left out keeps its default): `process`, a call of an agent or a command that failed, again in place in its
// step with the failure told; `node`, a part of a station whose step failed, worked again with its files kept and the
// failure told; `station`, the diagnosis and one more attempt of a station that failed. Then the run waits for the user.
RETRIES: <string, int> = { "process": 2, "node": 1, "station": 1 }

// How many checks of a station its role runs at the same time (`.nuclear/builder.json` "parallelChecks", 1 to 16; 1:
// one after another): each agent's session takes minutes, and the checks of a station judge the same work apart.
PARALLEL_CHECKS = 4

// The line of a project: the defaults under the project's `.nuclear/builder.json` (shared with CI).
readLine(root: string, platform: string) <string, any>
  line: <string, any> = { "commands": defaultCommands(platform), "branches": ["main", "feature/**"], "gates": ["analysis", "design", "delivery"], "stations": STATIONS, "forceConfirm": false, "minFreeMb": 500, "commandTimeoutMs": 1_200_000, "callTimeoutMs": 900_000, "stallSeconds": 90, "mcpCommand": "nuclear-mcp", "prices": {} as <string, any>, "retries": dict(RETRIES), "parallelChecks": PARALLEL_CHECKS }
  file = Path(root, ".nuclear", "builder.json")
  if file.isFile()
    own = json.loads(file.readText(encoding = "utf-8"))
    if isinstance(own, dict)
      for k, v in own as <string, any>
        if k == "retries" and isinstance(v, dict)
          retries: <string, any> = line["retries"]!
          for level, n in v as <string, any>
            retries[level] = n
        else if k == "commands" and isinstance(v, dict)
          commands: <string, any> = line["commands"]!
          for name, list in v as <string, any>
            commands[name] = list
        else
          line[k] = v
  line

commandsOf(line: <string, any>, name: string) string[]
  (line["commands"] as <string, any>)[name] ?? ([] as string[])

// The stages of CI from the commands.
ciCommands(line: <string, any>) <string, string[]>
  security = commandsOf(line, "security")
  { "check": commandsOf(line, "check"), "test": [...commandsOf(line, "build"), ...commandsOf(line, "test")], "security": security.isEmpty ? commandsOf(line, "check") : security, "artifacts": commandsOf(line, "artifacts"), "deploy": [...commandsOf(line, "seed"), ...commandsOf(line, "integration"), ...commandsOf(line, "deploy")] }

// The CI file of a provider: its path and its text.
ciFile(provider: string, line: <string, any>, platform: string) <string, string>
  stages = ciCommands(line)
  jobs = CI_STAGES.filter((s) => not stages[s]!.isEmpty)
  withPath = (cmds: string[]) => cmds.map((x) => "export PATH=\"$HOME/.local/bin:$PATH\" && ${x}")
  flutter = platform == "mobile"
  image = flutter ? "ghcr.io/cirruslabs/flutter:stable" : "ubuntu:24.04"
  prepare = "apt-get update -qq && apt-get install -y -qq curl git python3 python3-venv nodejs npm > /dev/null || true"
  if provider == "github"
    branches: string[] = line["branches"] ?? ["main"]
    out = ["# Generated by the Nuclear Builder (.nuclear/builder.json). The agent stations run locally; this checks their result.", "name: nuclear-builder", "on:", "  push:", "    branches: [${branches.map((b) => "\"${b}\"").join(", ")}]", "  pull_request:", "jobs:"]
    previous = ""
    for name in jobs
      out.addAll(["  ${name}:", "    runs-on: ubuntu-latest"])
      if previous.length > 0
        out.add("    needs: ${previous}")
      out.addAll(["    steps:", "      - uses: actions/checkout@v4"])
      if flutter
        out.addAll(["      - uses: subosito/flutter-action@v2", "        with: { channel: stable }"])
      out.addAll(["      - name: Install NuclearLang", "        run: ${INSTALL} && echo \"$HOME/.local/bin\" >> \"$GITHUB_PATH\""])
      for cmd in withPath(stages[name]!)
        out.add("      - run: ${cmd}")
      if name == "artifacts"
        out.addAll(["      - uses: actions/upload-artifact@v4", "        with: { name: build, path: build/ }"])
      previous = name
    return { "path": ".github/workflows/nuclear-builder.yml", "text": out.join("\n") + "\n" }
  if provider == "gitlab"
    out = ["# Generated by the Nuclear Builder (.nuclear/builder.json).", "stages: [${jobs.join(", ")}]", "image: ${image}", "default:", "  before_script:", "    - ${prepare}", "    - ${INSTALL}", ""]
    for name in jobs
      out.addAll(["${name}:", "  stage: ${name}", "  script:", ...withPath(stages[name]!).map((x) => "    - ${x}")])
      if name == "artifacts"
        out.addAll(["  artifacts:", "    paths: [build/]"])
      out.add("")
    return { "path": ".gitlab-ci.yml", "text": out.join("\n") }
  out = ["# Generated by the Nuclear Builder (.nuclear/builder.json).", "image: ${image}", "pipelines:", "  default:"]
  for name in jobs
    out.addAll(["    - step:", "        name: ${name}", "        script:", "          - ${prepare}", "          - ${INSTALL}", ...withPath(stages[name]!).map((x) => "          - ${x}")])
    if name == "artifacts"
      out.addAll(["        artifacts:", "          - build/**"])
  { "path": "bitbucket-pipelines.yml", "text": out.join("\n") + "\n" }

// ---------- the line's file: read and set ----------

// The keys of `.nuclear/builder.json` a command may set, and what each holds.
LINE_KEYS: <string, string> = { "team": "the id of the team that runs the project's specs", "stations": "the stations a run goes through, in order (a subset of analysis, design, tests, code, quality, delivery)", "gates": "the stations a run stops after for the user's approval", "branches": "the branches the exported CI runs on", "commands": "the project's commands by name (check, build, test, security, artifacts, seed, integration, deploy): lists of shell commands", "forceConfirm": "true: the spending is always confirmed twice by the user, never by --confirm-spending", "minFreeMb": "the free disk a run needs", "commandTimeoutMs": "how long a command may take", "callTimeoutMs": "how long a provider's call may take", "stallSeconds": "how long a local model may say nothing", "mcpCommand": "the Nuclear MCP server's command", "prices": "the USD per million tokens of a model: { \"<provider>/<model>\": [input, output] }", "developerUrl": "the Nuclear Developer's address", "ollamaUrl": "Ollama's address", "retries": "how many times a level is tried again by itself before the next: { \"process\": 2, \"node\": 1, \"station\": 1 }", "parallelChecks": "how many checks of a station its role runs at the same time (1 to 16; 1: one after another)" }

// A value of the line, checked before it is kept: a wrong one is said, never written.
validLineValue(key: string, value: any) any
  if not (key in LINE_KEYS)
    throw ValueError("no key `${key}` in .nuclear/builder.json: ${LINE_KEYS.keys.join(", ")}")
  if value == null
    return null
  texts = (v: any) => isinstance(v, list) and (v as any[]).all((x) => isinstance(x, str))
  if (key == "stations" or key == "gates") and not (texts(value) and (value as string[]).all((x) => x in STATIONS))
    throw ValueError("${key} is a list of stations: ${STATIONS.join(", ")}")
  if key == "branches" and not texts(value)
    throw ValueError("branches is a list of texts")
  if key == "forceConfirm" and not isinstance(value, bool)
    throw ValueError("forceConfirm is true or false")
  if key == "commands" and not (isinstance(value, dict) and (value as <string, any>).keys.all((k) => k in COMMAND_NAMES) and (value as <string, any>).values.all((v) => texts(v)))
    throw ValueError("commands is { name: [command, …] } with the names ${COMMAND_NAMES.join(", ")}")
  if key == "team"
    loadTeam("${value}")
  if key in ["minFreeMb", "commandTimeoutMs", "callTimeoutMs", "stallSeconds"] and not (isinstance(value, int) and not isinstance(value, bool) and (value as int) >= 0)
    throw ValueError("${key} is a whole number of 0 or more")
  if key == "retries" and not (isinstance(value, dict) and (value as <string, any>).keys.all((k) => k in RETRIES) and (value as <string, any>).values.all((n) => isinstance(n, int) and not isinstance(n, bool) and (n as int) >= 0 and (n as int) <= 5))
    throw ValueError("retries is { ${RETRIES.keys.map((k) => "\"${k}\"").join(", ")} } with whole numbers from 0 to 5")
  if key == "parallelChecks" and not (isinstance(value, int) and not isinstance(value, bool) and (value as int) >= 1 and (value as int) <= 16)
    throw ValueError("parallelChecks is a whole number from 1 to 16")
  if key in ["mcpCommand", "developerUrl", "ollamaUrl"] and not isinstance(value, str)
    throw ValueError("${key} is a text")
  if key == "prices" and not isinstance(value, dict)
    throw ValueError("prices is { \"<provider>/<model>\": [input, output] }")
  value

// The project's own `.nuclear/builder.json`, as written (empty when it has none).
ownLine(root: string) <string, any>
  file = Path(root, ".nuclear", "builder.json")
  if not file.isFile()
    return {}
  found = json.loads(file.readText(encoding = "utf-8"))
  if not isinstance(found, dict)
    throw ValueError(".nuclear/builder.json is not a JSON object: fix it first")
  found

// `line set`: keys of the project's line, each checked; null takes a key away (its default again).
setLine(root: string, values: <string, any>) <string, any>
  own = ownLine(root)
  for key, value in values
    kept = validLineValue(key, value)
    if kept == null
      own.remove(key)
    else
      own[key] = kept
  writeAtomic(Path(root, ".nuclear", "builder.json"), "${json.dumps(own, indent = 2, ensureAscii = false)}\n")
  own

// A value given on the command line: its JSON, else the text itself (`team=my-team`).
jsonValue(raw: string) any
  try
    return json.loads(raw)
  catch e
    if not isinstance(e, ValueError)
      throw e
    raw
