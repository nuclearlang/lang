use re
use sys
use json
use httpx
use pathlib{ Path }

// A member of a team in Nuclear Chat (spec 013, design.md "The responder" and "The process"): `nuclear-builder
// member --team <id> --member <member id> --events` (or `--role <role|chat>`: the role's first member, or the general
// agent) answers one message as that member, and `nuclear-builder chat-host --json` gives the chat the project's
// members and channels. A member is a member of the team (ADR-platform-0010) worked by its provider through the factory's adapters, with the factory's tools, the role files' guard and the two spending
// confirmations of the chat (chat.nuc); it speaks as its profile (the roster's bio and HR note, its personality,
// the team's instructions for its role). `--role chat` is the general agent.

LANGUAGES: <string, string> = { "en": "English", "es": "Spanish" }

// The language rule said in the language itself too: a small model follows it better.
SAY_IN: <string, string> = { "en": "Answer in English.", "es": "Responde en español." }

// The general agent's member in the chat: its id names its direct message, `dm-atlas`.
GENERAL_AGENT = "atlas"
// The folder's own channel in the chat (the workspace's or the project's), with the assigned team's tech lead.
HOME_CHANNEL = "home"

GENERAL_AGENT_BIO: <string, string> = { "en": "I explain Nuclear, your workspace and your projects from the knowledge base. A task is a team's: I tell you which tech lead is free, or help you make a team.", "es": "Te explico Nuclear, tu workspace y tus proyectos desde la base de conocimiento. Una tarea es de un equipo: te digo qué tech lead está libre, o te ayudo a crear un equipo." }

// The stations' names as the tech lead's plan says them.
STATION_TITLES: <string, string> = { "analysis": "analysis", "design": "design", "tests": "tests first", "code": "code", "quality": "quality", "delivery": "delivery" }

// What Nuclear Atlas is (spec 023 requirement 1): it informs and sends the work to a team's tech lead.
ATLAS_ROLE = "You are Nuclear Atlas, NuclearLang's guide. You only inform: you explain Nuclear, the user's workspace and projects, their specs, runs and teams, from the knowledge base (the Smart Graph: graph_answer, graph_search, nuclear_doc) and the project's map (project_inspect, project_read). You never do a task yourself: asked to write code, a spec, a project or to start a run, you do not do it; you say that a team's tech lead does it and name the teams that are free with their tech lead (the teams below; team_list for the latest), so the user writes to that tech lead in the chat. When no team is free or there is none, offer to make one here: with the user's yes, make it with the team tools of the Nuclear MCP server (team_create, member_add), which ask the user before each change. Why a team: it costs no more tokens than one agent; it works in stations (analysis, design, tests first, code, quality, delivery) with checks between them, as a professional team does; and the user shapes each team (its method, its instructions, its members)."

// The member's spending, cost and tool results of a conversation (a channel, or one of its threads) are kept as a
// chat's history (`.nuclear/builder/chat/member-<team>-<member>-<channel>[-<thread>].jsonl`): the confirmation holds
// for the conversation and its budget is the team's.
memberChatId(team: string, member: string, channel: string, thread: string) string
  "member-${team}-${member}-${channel}${thread.isEmpty ? "" : "-${thread}"}".replaceAll(Regex(r"[^\w.-]+"), "-")

// A member's GIF is one last line of the answer, `gif: <tag>` (a tag of the chat's GIF pack); a line so written, or the
// same words at the end of the answer, is never shown: it goes in `done` as `gif`.
GIF_LINE = Regex(r"^[^\w\n]*gif[^\w\n]*:[^\w\n]*([a-z][a-z-]*)[^\w\n]*$", ignoreCase = true, multiline = true)
GIF_TAIL = Regex(r"\s*[^\w\s]*\bgif[^\w\n]*:[^\w\n]*([a-z][a-z-]*)[^\w\n]*\s*$", ignoreCase = true)
// the end of an answer being written that may still become a GIF line (`g`, `gi`, `gif…`): held back
GIF_COMING = Regex(r"(?:^|\s)[^\w\s]*g(?:i(?:f[^\w\n]*(?::[^\w\n]*[a-z-]*)?)?)?$", ignoreCase = true)

// An answer without its GIF line, and the GIF's tag (lowercase; empty without one).
gifOf(text: string) <string, string>
  tag = ""
  for m in GIF_LINE.findAll(text)
    tag = "${m[1]}".lower()
  tail = GIF_TAIL.find(text)
  if tail != null
    tag = "${tail![1]}".lower()
  { "text": text.replaceAll(GIF_TAIL, "").replaceAll(GIF_LINE, "").trimEnd(), "tag": tag }

// What the chat's events are in the responder's protocol: `text`, `text-delta`, `tool` (a factory tool's call, then
// its result), `ask` and `done` (with the answer's `gif` tag); the rest (the provider's cost, tokens, traces) stays
// out. The answer's GIF line is never told as text.
MemberLines(tell: (e: <string, any>) => void)
  // the answer as written so far, how much of it was told, and the GIF the answer ends with
  streamed: string = ""
  told: int = 0
  gif: string = ""

  on(e: <string, any>) void
    ev: <string, any> = e["event"] ?? ({} as <string, any>)
    if e["type"] == "event" and ev["type"] == "text"
      found = gifOf("${ev["text"]}")
      if not found["tag"]!.isEmpty
        gif = found["tag"]!
      if not found["text"]!.trim().isEmpty
        tell({ "type": "text", "text": found["text"] })
    else if e["type"] == "event" and ev["type"] == "text-delta"
      streamed += "${ev["text"]}"
      shown = gifOf(streamed)["text"]!
      coming = GIF_COMING.find(shown)
      if coming != null
        shown = shown.substring(0, coming!.start)
      if shown.length > told
        tell({ "type": "text-delta", "text": shown.substring(told) })
        told = shown.length
    else if e["type"] == "event" and ev["type"] == "tool"
      tell({ "type": "tool", "id": ev["id"], "tool": ev["tool"], "input": ev["input"] })
    else if e["type"] == "event" and ev["type"] == "tool-result"
      tell({ "type": "tool", "id": ev["id"], "tool": ev["tool"], "ok": ev["ok"], "text": ev["text"] })
    else if e["type"] == "ask" or e["type"] == "typing"
      tell(e)
    else if e["type"] == "done"
      done: <string, any> = { "type": "done", "costUsd": e["costUsd"] ?? 0.0 }
      if e["error"] != null
        done["error"] = e["error"]
      if not gif.isEmpty
        done["gif"] = gif
      tell(done)

// One answer of a member: the chat's turn (its provider, its tools, its guard, its spending) with the member's own
// prompt. `ask` is the responder's input: `{ member, channel, thread, messages, said, lang }`; `given` is the team's
// member who answers (its id, role, employee, who works it), or the general agent's choice.
Member: Chat
  (root: string, id: string, given: <string, any>, line: <string, any>, read: () => string?, out: (e: <string, any>) => void, options: <string, any>, team: <string, any>, role: string, ask: <string, any>)
    // what the member does in the channel is remembered there (memory.nuc), without any call of a model
    super(root, id, given, line, read, ChannelMemory(root, "${ask["channel"] ?? "general"}", "${ask["thread"] ?? ""}", role == "chat" ? GENERAL_AGENT : "${given["id"] ?? role}").tap(out), options)
  assigned() <string, any>
    role == "chat" ? ({} as <string, any>) : given

  // Nuclear Atlas only informs: its tools read and teach (mcp.nuc's `INFORM_TOOLS`, `nuclear-mcp --informs`).
  informs() boolean
    role == "chat"

  // Who answers, as the ledger names them: the team's member (or the general agent) in the chat's channel.
  ledgerWho() <string, any>
    { "team": "${team["id"] ?? ""}", "teamName": "${team["name"] ?? ""}", "member": "${assigned()["id"] ?? ""}", "employee": "${assigned()["employee"] ?? ""}", "role": role, "channel": "${ask["channel"] ?? "general"}${"${ask["thread"] ?? ""}".isEmpty ? "" : "/${ask["thread"]}"}" }

  lang() string
    "${ask["lang"] ?? "en"}"

  languageRule() string
    languageRuleIn(lang(), "${ask["said"] ?? ""}")

  // The title of the GIF the user sent just before the message to answer (the messages since the last of another
  // author's), or nothing.
  userGif() string
    messages: <string, any>[] = ask["messages"] ?? []
    at = messages.length - 1
    while at >= 0 and messages[at]["author"] == "you"
      if messages[at]["gif"] != null
        return "${messages[at]["gif"]}"
      at -= 1
    ""

  // What the member may do with GIFs: one last line `gif: <tag>` from the chat's pack (`gifTags`), by their
  // personality (`gifs`: never, sometimes, often; `on`: failure, success, question) and their temperament's habit
  // (the sentences of its voice about GIFs); nothing when they never send one or the chat gave no tags.
  gifSection(personality: <string, any>, voice: string) string
    often = "${personality["gifs"] ?? "never"}"
    tags: string[] = ask["gifTags"] ?? []
    if role == "chat" or not (often in ["sometimes", "often"]) or tags.isEmpty
      return ""
    habit = voice.split(Regex(r"(?<=\.)\s+")).filter((l) => "GIF" in l).join(" ")
    moments: string[] = personality["on"] ?? []
    how = often == "often" ? "You like GIFs: add one whenever it fits." : "Now and then, only when it really fits."
    "## GIFs\n\nYou may end your answer with one last line `gif: <tag>`, a tag of this list, and the chat shows a GIF of it after your message: ${tags.join(", ")}. Never describe the GIF nor write a link. ${how}${habit.isEmpty ? "" : " ${habit}"} It fits when the user sent a GIF or made a joke${moments.isEmpty ? "" : ", and at ${moments.map((m) => "a ${m}").join(", ")}"}. Most answers have no GIF. Example of an answer that has one:\n\n${lang() == "es" ? "¡Por fin en verde!" : "Finally green!"}\ngif: celebrate"

  // The member's employee in the roster, in the conversation's language; empty when the role has none.
  profile() <string, any>
    staff = roster(role, lang())
    staff.find((p) => p["id"] == assigned()["employee"]) ?? ({} as <string, any>)

  name() string
    own = "${assigned()["name"] ?? ""}".trim()
    own.isEmpty ? "${profile()["name"] ?? ROLE_TITLES[role] ?? "the general agent"}" : own

  // The answer to the message said, once: `typing`, then the chat's turn told in the responder's protocol.
  respond() int
    load()
    rememberAsked(root, ask, role == "chat" ? GENERAL_AGENT : "${given["id"] ?? role}")
    out({ "type": "typing" })
    answer("${ask["said"] ?? ""}".trim())
    0

  persona() Role
    if role == "chat"
      return Role("chat", "Nuclear Atlas", ATLAS_ROLE, {}, {}, [], [])
    // the team's and the member's skills (library.nuc), a base agent's text before the member's instructions
    who = withSkills(team, assigned())
    skills: <string, string> = {}
    sources: <string, string> = {}
    for shared in who["sharedSkills"] as <string, any>[]
      skills["${shared["id"]}"] = "${shared["markdown"]}"
      sources["${shared["id"]}"] = "${shared["from"]}"
    Role(role, ROLE_TITLES[role] ?? role, "You are ${name()}, the ${ROLE_TITLES[role] ?? role} of the team ${team["name"]} in Nuclear Builder, NuclearLang's software factory.", skills, {}, [], [], "${who["instructions"] ?? ""}", "${assigned()["employee"] ?? ""}", sources)

  // The tech lead answers for the whole team (spec 013 requirement 4b); a member knows who theirs is.
  leadSection() string
    lead = "${team["techLead"] ?? ""}"
    if assigned()["id"] == lead
      return "## You are the team's tech lead\n\nYou answer for the whole team: a message to the team is yours, and you speak for everyone. When a question belongs to another member, say who owns it (by name and role) and bring them in. You are accountable for the team's work.\n\nGiven a task, your first answer is the plan, its first line `Plan: <the plan in one sentence>` (the channel remembers it): what the team will do, how (the stations it goes through, the team's method below) and who of your team does each part, by name and role. Then do it through the factory's tools: a spec with its acceptance criteria (spec_new; ask the user for the criteria when they are not given), then its run (run_start, assigning the members you named), and tell the run's progress here (runs, run_file) until it is delivered or waits for the user.\n\n## Your team, by station\n\n${byStation()}"
    own: <string, any> = ((team["members"] ?? []) as <string, any>[]).find((m) => m["id"] == lead) ?? ({} as <string, any>)
    leadRole = "${own["role"] ?? DEFAULT_LEAD}"
    staff = roster(leadRole, lang())
    hired = staff.find((p) => p["id"] == own["employee"]) ?? ({} as <string, any>)
    leadName = "${own["name"] ?? ""}".trim()
    named = leadName.isEmpty ? "${hired["name"] ?? ""}" : leadName
    "## Your tech lead\n\n${named.isEmpty ? "The" : "${named}, the"} ${ROLE_TITLES[leadRole] ?? leadRole}${named.isEmpty ? "" : ","} answers for the team and is accountable for its work; you answer what is asked of you."

  // Who of the team works each station (the role's first member), by name and role: the tech lead's plan.
  byStation() string
    lines: string[] = []
    for station in STATIONS
      r = STATION_ROLE[station] ?? station
      m = memberFor(team, r)
      title = ROLE_TITLES[r] ?? r
      if m == null
        lines.add("- ${STATION_TITLES[station] ?? station}: nobody (the team has no ${title})")
      else
        own = "${m!["name"] ?? ""}".trim()
        hired = roster(r, lang()).find((p) => p["id"] == m!["employee"]) ?? ({} as <string, any>)
        lines.add("- ${STATION_TITLES[station] ?? station}: ${own.isEmpty ? "${hired["name"] ?? title}" : own}, the ${title}")
    lines.join("\n")

  // The teams Nuclear Atlas tells of: each one's tech lead and whether it is free (line.nuc's `teamsAtWork`).
  teamsSection() string
    found = teamsAtWork(root)
    if found.isEmpty
      return "## The teams\n\nThere is no team yet: offer to make one."
    lines = found.map((t) =>
      lead: <string, any>? = t["lead"]
      who = lead == null ? "no tech lead (no members)" : "its tech lead ${lead!["name"]}, the ${ROLE_TITLES["${lead!["role"]}"] ?? lead!["role"]}"
      state = t["free"] == true ? "free" : "busy (runs in progress: ${(t["running"] as string[]).join(", ")})"
      "- ${t["name"]} (`${t["id"]}`): ${state}; ${who}"
    )
    "## The teams\n\n${lines.join("\n")}"

  // Who the member is, the factory's tools, the project, the conversation of the chat, the message to answer and the
  // tools' results of this turn.
  chatPrompt(project: string, platform: string) string
    channel = "#${ask["channel"] ?? "general"}${"${ask["thread"] ?? ""}".isEmpty ? "" : ", a thread"}"
    where = "the project ${project}${platform.isEmpty ? "" : " (${platform})"}"
    rules = "You never edit a role's files (nuclear-agents/roles/) nor the project's files: a spec is written with `spec_new`, a change of the project is a run of the factory. Answer as a message in a team's chat: short."
    // the language first and again at the end, where small and large models both follow it
    parts: string[] = [languageRule()]
    if role == "chat"
      parts.add("${ATLAS_ROLE} You are in ${where}, talking in Nuclear Chat (${channel}). You never edit a file. Answer as a message of the chat: short.")
      parts.add(teamsSection())
    else
      p = profile()
      personality: <string, any> = assigned()["personality"] ?? ({} as <string, any>)
      mood = temperamentOf(personality, p)
      named: <string, any> = mood["name"] ?? ({} as <string, any>)
      about = ["- Bio: ${p["bio"] ?? ""}", "- HR's note: ${p["hrNote"] ?? ""}", "- Temperament: ${named["en"] ?? ""}", "- Personality: ${personality["note"] ?? ""}"].filter((l) => not l.endsWith(": "))
      parts.add("You are ${name()}, the ${ROLE_TITLES[role] ?? role} of the team ${team["name"]} in Nuclear Builder, NuclearLang's software factory, working on ${where}. You talk with the user and your teammates in Nuclear Chat (${channel}). Speak as yourself: your profile is your character. ${rules}")
      if not about.isEmpty
        parts.add("## Who you are\n\n${about.join("\n")}")
      if not mood.isEmpty
        parts.add("## How you write\n\n${mood["voice"] ?? ""}")
      gifs = gifSection(personality, "${mood["voice"] ?? ""}")
      if not gifs.isEmpty
        parts.add(gifs)
      parts.add(leadSection())
      instructions = "${assigned()["instructions"] ?? ""}".trim()
      if not instructions.isEmpty
        parts.add("## The team's instructions for your role\n\n${instructions}")
    parts.add(toolsSection())
    parts.add(componentsSection())
    messages: <string, any>[] = ask["messages"] ?? []
    remembered = memorySection(root, "${ask["channel"] ?? "general"}", "${ask["thread"] ?? ""}", messages, "${ask["said"] ?? ""}")
    if not remembered.isEmpty
      parts.add(remembered)
    if not messages.isEmpty
      parts.add("## The conversation so far\n\n${messages.map((m) => "${m["author"] ?? "?"}: ${m["gif"] == null ? m["text"] ?? "" : "[a GIF: ${m["gif"]}]"}").join("\n\n")}")
    now = "## The message to answer\n\nyou: ${ask["said"] ?? ""}\n\n${languageRule()}"
    sent = userGif()
    if not sent.isEmpty and not gifSection(assigned()["personality"] ?? ({} as <string, any>), "").isEmpty
      now += "\n\nThe user just sent a GIF (\"${sent}\"): answer it with a GIF of your own, ending your answer with one line `gif: <tag>` (for example `gif: laugh`)."
    parts.add(now)
    // this turn's tool results: what the history kept after the message said
    at = history.length
    while at > 0 and history[at - 1]["role"] != "you"
      at -= 1
    results = history.skip(at).filter((h) => h["role"] == "tool")
    if not results.isEmpty
      parts.add("## The tools answered (for you only)\n\n${results.map((h) => "${h["tool"]}${h["error"] == true ? " (failed)" : ""}:\n${h["text"]}").join("\n\n")}\n\nTell the user in a few sentences what was done and where (never the results whole), or call another tool.")
    parts.join("\n\n")

// The words that tell English from Spanish in a short chat message (the languages the chat speaks).
LANGUAGE_WORDS: <string, string[]> = { "en": ["the", "is", "are", "what", "you", "your", "hi", "hello", "hey", "and", "this", "that", "how", "can", "do", "does", "it", "in", "of", "to", "my", "please", "thanks", "haha", "lol"], "es": ["el", "la", "los", "las", "es", "son", "que", "qué", "tu", "tú", "hola", "y", "este", "esta", "cómo", "como", "puedes", "haces", "lo", "en", "de", "mi", "por", "favor", "gracias", "jaja", "nuevo", "nombre"] }

// The language a message is written in, `en` or `es`, or nothing when its words do not tell (a small model answers
// in one language it is told better than it tells the message's language itself).
messageLanguage(text: string) string
  words = text.lower().split(Regex(r"[^\wáéíóúüñ]+")).filter((w) => not w.isEmpty)
  en = words.count((w) => w in LANGUAGE_WORDS["en"]!)
  es = words.count((w) => w in LANGUAGE_WORDS["es"]!) + (Regex(r"[¿¡ñ]").test(text) ? 2 : 0)
  en > es ? "en" : es > en ? "es" : ""

// The language of the answer: the user's chosen language, else the one the user's message is written in.
languageRuleIn(lang: string, said: string) string
  wrote = messageLanguage(said)
  chosen = LANGUAGES[lang] ?? "the language ${lang}"
  if not wrote.isEmpty and wrote != lang
    return "Language: answer in ${LANGUAGES[wrote]}: the user chose ${chosen}, but wrote this message in ${LANGUAGES[wrote]}. ${SAY_IN[wrote]}"
  "Language: answer in ${chosen}, the user's chosen language. ${SAY_IN[lang] ?? ""} But when the user's message is written in another language, answer in the language of that message.".replace("  ", " ")

// A member's temperament (temperaments.json): the team's override, else the hired employee's of the roster; empty
// when it has none or the list is not there.
temperamentOf(personality: <string, any>, profile: <string, any>) <string, any>
  id = personality["temperament"] ?? profile["temperament"]
  temperaments().find((t) => t["id"] == id) ?? ({} as <string, any>)

// `nuclear-builder member --team <id> (--member <member id> | --role <role|chat>) --events [--root <dir>] [--provider <p>] [--model <m>]
// [--kind …] [--budget <usd>] [--confirm-spending] [--force-confirm]`: one answer of a member, the responder of
// Nuclear Chat. A usage error is a `done` with its error and exit code 2.
memberLine(args: string[]) int
  tellIt = (e: <string, any>) => print(json.dumps(e, ensureAscii = false), flush = true)
  refuse = (why: string) =>
    tellIt({ "type": "done", "costUsd": 0.0, "error": why })
    2
  root = option(args, "--root") ?? projectRoot("${Path.cwd()}")
  memberId = option(args, "--member")
  // `--role delivery` (the role's id before DevOps) is still taken for one release: roles.nuc's OLD_ROLES
  role = roleId(option(args, "--role") ?? (memberId == null ? "" : "member"))
  if not (role in ROLES) and role != "chat" and memberId == null
    return refuse("--member <member id> of the team, or --role one of ${ROLES.join(", ")} or chat")
  if not ("--events" in args)
    return refuse("a member answers with --events: the conversation as one JSON line on stdin")
  asked = option(args, "--team")
  if asked == null and role != "chat"
    return refuse("--team <id> names the member's team")
  team: <string, any> = {}
  try
    team = asked == null ? teamOfRun(root, null) : teamOfRetry(root, null, asked!)
  catch e
    if not isinstance(e, ValueError)
      throw e
    return refuse("${e}")
  // a role named goes to the member who works it (its first; teams.nuc's `memberFor`)
  given: <string, any> = (memberId != null ? ((team["members"] ?? []) as <string, any>[]).find((m) => m["id"] == memberId) : memberFor(team, role)) ?? ({} as <string, any>)
  if memberId != null and given.isEmpty
    return refuse("the team ${team["id"]} has no member `${memberId}`")
  if not given.isEmpty
    role = "${given["role"]}"
  if role == "chat"
    // the general agent: the provider asked, else the local Developer while the local models are on, else the default
    // external choice; the local one asked while they are on standby is that choice too (ADR-platform-0013)
    asked = option(args, "--provider")
    keep = asked != null and (asked != "nuclear-developer" or localModels())
    w: <string, any>? = keep ? { "provider": asked } : localModels() ? { "provider": "nuclear-developer" } : externalWorker(readLine(root, "")["prices"] ?? ({} as <string, any>))
    if w == null
      return refuse(NO_PROVIDER)
    provider = "${w!["provider"]}"
    given = { "provider": provider, "kind": (keep ? option(args, "--kind") : null) ?? kindOf(provider), "model": (keep ? option(args, "--model") : null) ?? w!["model"] ?? "" }
  else if given.isEmpty
    return refuse("the team ${team["id"]} has no ${role}")
  if not ("${given["provider"] ?? "nuclear-developer"}" in ADAPTERS)
    return refuse("no provider `${given["provider"]}`: ${ADAPTERS.keys.join(", ")}")
  request = jsonLine("${sys.stdin.readline()}".trim())
  if request == null or "${request!["said"] ?? ""}".trim().isEmpty
    return refuse("the conversation is one JSON line: {\"member\", \"channel\", \"thread\", \"messages\", \"said\", \"lang\"}")
  budget = (option(args, "--budget") ?? "${team["budgetUsd"] ?? 5.0}").toDouble() ?? 0.0
  options: <string, any> = { "events": true, "budgetUsd": budget, "confirmSpending": "--confirm-spending" in args, "forceConfirm": "--force-confirm" in args }
  card = projectCard(root)
  id = memberChatId("${team["id"]}", role == "chat" ? "chat" : "${given["id"]}", "${request!["channel"] ?? "general"}", "${request!["thread"] ?? ""}")
  readIt = () => readUser(true)
  lines = MemberLines(tellIt)
  member = Member(root, id, given, readLine(root, "${card["platform"] ?? ""}"), readIt, (e: <string, any>) => lines.on(e), options, team, role, request!)
  member.respond()

// The host file of Nuclear Chat for a project or a workspace (spec 013, design.md "The process"; spec 023 requirement
// 2): every saved team (the one assigned here first: teams.nuc's `runTeam`; none when none is saved: no team is made
// up), each member of each
// (any number per role; id `<team>-<member id>`), their profile in `lang`, the brain that answers as them (`brain`:
// the agent's name, its kind, provider and model, paid or local), their face (the thumbnail's whole path, a chat's
// avatar; the portrait's without one; null without either), their temperament, their personality, their
// responder and their profile's card (`memberCard`). Only the tech lead of each team and Atlas are `listed` (the people of the chat, each with a direct
// message); the other members write in the team's channel and the run's threads. The channels: `home`, the folder's
// own (named after the workspace or the project), with the tech lead of the team assigned to it (`assignedTeamId`:
// the folder's or its workspace's); `general`; each team's, with its tech lead. `assigned` is the team assigned here,
// null when none is: the editor then offers the saved teams in `home` (or creating one). The teams with their tech
// lead, who answers a message to the team.
chatHost(root: string, lang: string, transport: httpx.BaseTransport? = null) <string, any>
  members: <string, any>[] = []
  teams: <string, any>[] = []
  channels: <string, any>[] = []
  // the temperaments a member's profile offers, named in the language
  moods = temperaments().map((t) => { "id": "${t["id"]}", "name": "${(t["name"] ?? ({} as <string, any>))[lang] ?? (t["name"] ?? ({} as <string, any>))["en"] ?? t["id"]}" })
  for team in hostTeams(root, lang)
    teamId = "${team["id"]}"
    lead = "${team["techLead"] ?? defaultLead(team["members"] ?? []) ?? ""}"
    for r in team["members"] as <string, any>[]
      role = "${r["role"]}"
      own = "${r["id"]}"
      staff = roster(role, lang)
      p = staff.find((x) => x["id"] == r["employee"]) ?? ({} as <string, any>)
      name = "${r["name"] ?? ""}".isEmpty ? ROLE_TITLES[role] ?? role : "${r["name"]}"
      personality: <string, any> = r["personality"] ?? ({} as <string, any>)
      members.add({ "id": "${teamId}-${own}", "name": name, "role": role, "member": own, "team": teamId, "listed": own == lead, "avatar": "${r["employee"] ?? "${teamId}-${own}"}", "face": p["thumb"] ?? p["face"], "temperament": personality["temperament"] ?? p["temperament"], "profile": { "bio": p["bio"] ?? "", "hrNote": p["hrNote"] ?? "", "lang": lang }, "personality": r["personality"], "brain": brainOf(r), "responder": { "command": ["nuclear-builder", "member", "--team", teamId, "--member", own], "paid": r["kind"] != "local" }, "card": memberCard(r, teamId, personality, p, moods, lang) })
    leadId = lead.isEmpty ? "" : "${teamId}-${lead}"
    // a message to the team goes to its tech lead; `@<role>` to the role's first member as listed here (Nuclear Chat)
    teams.add({ "id": teamId, "name": team["name"], "lead": leadId })
    description = "${team["description"] ?? ""}"
    channels.add({ "id": teamId, "name": teamId, "topic": description.isEmpty ? "${team["name"]}" : description, "members": leadId.isEmpty ? ([] as string[]) : [leadId] })
  listed = members.filter((m) => m["listed"] == true).map((m) => "${m["id"]}")
  // the general agent: answered by the choice of its conversation, else this default: the local Nuclear Developer
  // while the local models are on, else the default external choice (ADR-platform-0013); none: `why` says to choose
  choices = chatChoices(agentsHere(root, transport))
  w: <string, any>? = localModels() ? { "provider": "nuclear-developer" } : externalWorker(readLine(root, "")["prices"] ?? ({} as <string, any>))
  chosen = w == null ? null : choices.find((c) => c["id"] == w!["provider"])
  responder: <string, any> = { "command": (chosen ?? choices[0])["command"], "paid": chosen != null and chosen!["kind"] != "local", "choice": chosen == null ? "" : chosen!["id"], "model": w == null ? "" : w!["model"] ?? "", "choices": choices }
  if chosen == null
    responder["why"] = NO_PROVIDER
  members.add({ "id": GENERAL_AGENT, "name": "Atlas", "role": "chat", "team": "", "listed": true, "avatar": GENERAL_AGENT, "face": null, "temperament": null, "profile": { "bio": GENERAL_AGENT_BIO[lang] ?? GENERAL_AGENT_BIO["en"], "hrNote": "", "lang": lang }, "personality": { "gifs": "never", "on": [] as string[] }, "responder": responder })
  project = folderName(root)
  assigned = assignedTeamId(root)
  team: <string, any>? = assigned == null ? null : teams.find((t) => t["id"] == assigned)
  homeLead = team == null ? "" : "${team!["lead"]}"
  home: <string, any> = { "id": HOME_CHANNEL, "name": channelName(project), "topic": project, "members": homeLead.isEmpty ? ([] as string[]) : [homeLead] }
  { "host": "builder", "members": members, "channels": [home, { "id": "general", "name": "general", "topic": "The project ${project}", "members": listed }, ...channels], "teams": teams, "assigned": team == null ? null : assigned, "lang": lang }

// The folder's name in the chat: a workspace's (its marker's `workspace(name = …)`), else the project's, else the
// folder's own.
folderName(root: string) string
  marker = Path(root, ".workspace", "workspace.nuc")
  if marker.isFile()
    found = re.search(r'workspace\(\s*name\s*=\s*"([^"]+)"', marker.readText())
    if found != null
      return "${found!.group(1)}"
  "${projectCard(root)["name"] ?? Path(root).name}"

// A channel's name from a folder's: lower case, words joined by `-` (Slack's).
channelName(name: string) string
  slug: string = re.sub(r"^-+|-+$", "", re.sub(r"[^a-z0-9]+", "-", name.lower()))
  slug.isEmpty ? HOME_CHANNEL : slug

// What a member's profile in the chat shows and changes: the temperament (the team's, else the employee's) and the ones
// to choose from, the skills by their titles, the instructions; only a saved team's member can be changed (the local
// team is made when none is saved: the profile says to create a team).
memberCard(r: <string, any>, teamId: string, personality: <string, any>, p: <string, any>, moods: <string, any>[], lang: string) <string, any>
  skills = ((r["skills"] ?? ([] as string[])) as string[]).map((id) => "${(librarySkill(id, lang) ?? ({} as <string, any>))["title"] ?? id}")
  { "editable": teamId != LOCAL_TEAM, "temperament": "${personality["temperament"] ?? p["temperament"] ?? ""}", "temperaments": moods, "skills": skills, "instructions": "${r["instructions"] ?? ""}" }

// The teams of the chat, as shown: the project's (the run's team: the one of `.nuclear/builder.json`, its workspace's,
// the default, the only saved one; none chosen among several is no error here), then every other saved team; with
// none saved, none (the local team a run takes is never a member of the chat: nobody could change it). A team that cannot be read is left out of the chat (the company screen tells what is wrong with it).
hostTeams(root: string, lang: string) <string, any>[]
  people = rosters(lang)
  first: <string, any>? = null
  try
    first = runTeam(root, null)
  catch e
    if not isinstance(e, TeamChoice)
      throw e
  found: <string, any>[] = first == null ? [] : [teamShown(first!, people)]
  for id in teamIds()
    if found.any((t) => t["id"] == id)
      continue
    try
      found.add(teamShown(loadTeam(id), people))
    catch e
      if not isinstance(e, ValueError)
        throw e
  found

// Who works a member, as the chat shows it under their name: `Claude Code · opus · paid`.
brainOf(r: <string, any>) <string, any>
  provider = "${r["provider"] ?? "nuclear-developer"}"
  kind = "${r["kind"] ?? kindOf(provider)}"
  { "agent": AGENT_LABELS[provider] ?? provider, "kind": kind, "provider": provider, "model": "${r["model"] ?? ""}", "paid": kind != "local" }

// `nuclear-builder chat-host --json [--root <dir>] [--lang en|es]`: every team is in the chat, so several teams and
// none chosen are no error here (a run still asks which one, `TeamChoice`).
chatHostLine(args: string[]) int
  root = option(args, "--root") ?? projectRoot("${Path.cwd()}")
  try
    printJson(chatHost(root, option(args, "--lang") ?? "en"))
  catch e
    if not isinstance(e, ValueError) and not isinstance(e, OSError)
      throw e
    printJson({ "error": "${e}" })
    return 1
  0
