{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "outDir": "out",
    "strict": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "test",
    "../tools/*/src",
    "../tools/*/test"
  ],
  "exclude": [
    "../tools/*/src/**/*.tsx"
  ]
}
