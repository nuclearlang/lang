use os
use hashlib
use chromadb
use numpy
use chromadb/config{ Settings }
use chromadb/api/models/Collection{ Collection }
use onnxruntime
use tokenizers{ Tokenizer }
use huggingface_hub{ hfHubDownload }

// The embeddings model (ADR-graph-0003): EmbeddingGemma exported to ONNX, run inside the graph's own process by ONNX
// Runtime, so no other program is needed (no Ollama). Its files come from Hugging Face the first time, into the
// graph's data folder. `NUCLEAR_GRAPH_EMBED_FILE` chooses another export of the same model (`onnx/<file>.onnx`).
EMBED_REPO = "onnx-community/embeddinggemma-300m-ONNX"
// int8 by default: 187 of the 188 questions of questions.toml (Ollama's BF16: 188), 309 MB (ADR-graph-0003)
EMBED_FILE = os.environ.get("NUCLEAR_GRAPH_EMBED_FILE") ?? "model_quantized"
// the longest text the model reads, in tokens (EmbeddingGemma's context), and the most tokens of one batch
EMBED_TOKENS = 2048
BATCH_TOKENS = 4096

// EmbeddingGemma's prompt of a document: its title, then its text.
asDocument(title: string, text: string) string
  "title: ${title.length > 0 ? title : "none"} | text: ${text}"

// EmbeddingGemma's prompt of a search.
asQuery(text: string) string
  "task: search result | query: ${text}"

// The folder of the model's files, downloaded the first time (`nuclear-graph model` does it ahead, with the set-up).
modelFolder() Path
  // real files in a folder of their own: Hugging Face's cache keeps links to its blobs, and ONNX Runtime refuses a
  // model whose data file resolves outside the model's folder
  folder = Paths.home().joinpath("models", "embeddinggemma-300m-onnx")
  for f in ["tokenizer.json", "onnx/${EMBED_FILE}.onnx", "onnx/${EMBED_FILE}.onnx_data"]
    hfHubDownload(repoId = EMBED_REPO, filename = f, localDir = "${folder}")
  folder

// EmbeddingGemma in ONNX Runtime, loaded once per process.
LocalModel
  tokenizer: any
  session: any

  (folder: Path)
    tokenizer = Tokenizer.fromFile("${folder.joinpath("tokenizer.json")}")
    tokenizer.enableTruncation(EMBED_TOKENS)
    options = onnxruntime.SessionOptions()
    options.logSeverityLevel = 3
    // no arena: it keeps the memory of the largest batch for the life of the process
    options.enableCpuMemArena = false
    session = onnxruntime.InferenceSession("${folder.joinpath("onnx", "${EMBED_FILE}.onnx")}", options, providers = ["CPUExecutionProvider"])

  // The vectors of `shaped`, in its order. The texts go by length, so a batch pads little, and a batch holds at most
  // `BATCH_TOKENS` tokens: the memory of a batch grows with the square of its longest text, so long texts go alone.
  embed(shaped: string[]) double[][]
    encoded: any[] = tokenizer.encodeBatch(shaped)
    sizes: int[] = encoded.map((e) => (e.ids as int[]).length)
    order: int[] = (0..shaped.length).sortedBy((i) => sizes[i])
    out: double[][] = shaped.map((t) => [] as double[])
    at = 0
    while at < order.length
      end = at + 1
      while end < order.length and sizes[order[end]] * (end - at + 1) <= BATCH_TOKENS
        end += 1
      batch = order.slice(at, end)
      longest = sizes[batch.last]
      ids = batch.map((i) => [...(encoded[i].ids as int[]), ...(0..(longest - sizes[i])).map((x) => 0)])
      mask = batch.map((i) => [...(0..sizes[i]).map((x) => 1), ...(0..(longest - sizes[i])).map((x) => 0)])
      got: any = session.run(["sentence_embedding"], { "input_ids": numpy.array(ids, dtype = numpy.int64), "attention_mask": numpy.array(mask, dtype = numpy.int64) })[0]
      rows: double[][] = got.tolist()
      for j in 0..batch.length
        out[batch[j]] = rows[j]
      at = end
    out

// The model of this process, once it was first needed.
LOADED: LocalModel[] = []

// The vectors of texts already shaped for the model (`asDocument`, `asQuery`), by the embeddings model.
localEmbed(shaped: string[]) double[][]
  withPrecomputed(shaped, precomputed(), modelEmbed)

// The vectors of texts by the model itself, loaded the first time it is needed.
modelEmbed(shaped: string[]) double[][]
  if LOADED.isEmpty
    LOADED.add(LocalModel(modelFolder()))
  LOADED[0].embed(shaped)

// ---------- the vectors computed ahead (ADR-graph-0003) ----------
// A release computes the vectors of its knowledge base once and publishes them (`nuclearlang-embeddings-<v>.npz`,
// the same file for every system: a vector depends only on the text and the model); the set-up puts it in the data
// folder, and an ingest takes each vector from it instead of running the model over every row. A text it does not
// hold (a row added later, a question) goes to the model.

// The key of a text in that file: the model's export and the text exactly as embedded.
vectorKey(shaped: string) string
  hashlib.sha1("${EMBED_FILE}\n${shaped}".toBytes()).hexdigest()

// Where the set-up puts the vectors of this release's knowledge base.
precomputedFile() Path
  Paths.home().joinpath("models", "embeddings.npz")

// The vectors computed ahead, by key, read once per process; none without the file or when it is another export's.
PRECOMPUTED: <string, double[]>[] = []
precomputed() <string, double[]>
  if PRECOMPUTED.isEmpty
    PRECOMPUTED.add(readPrecomputed(precomputedFile()))
  PRECOMPUTED[0]

readPrecomputed(file: Path) <string, double[]>
  found: <string, double[]> = {}
  if not file.isFile()
    return found
  data: any = numpy.load("${file}")
  if "${data["export"]}" != EMBED_FILE
    return found
  keys: string[] = data["keys"].tolist()
  rows: double[][] = data["vectors"].astype(numpy.float32).tolist()
  for i in 0..keys.length
    found[keys[i]] = rows[i]
  found

// Writes vectors by key to `file` (float16: a search needs no more), with the export they belong to.
writePrecomputed(file: Path, vectors: <string, double[]>) void
  keys: string[] = vectors.keys.sorted()
  numpy.savezCompressed("${file}", export = numpy.array(EMBED_FILE), keys = numpy.array(keys), vectors = numpy.array(keys.map((k) => vectors[k]!), dtype = numpy.float16))

// The vectors of `shaped`: each one `known` holds as it is, the rest by `compute` (called only when some are missing).
withPrecomputed(shaped: string[], known: <string, double[]>, compute: (texts: string[]) => double[][]) double[][]
  out: double[][] = shaped.map((t) => known[vectorKey(t)] ?? ([] as double[]))
  missing: int[] = (0..shaped.length).filter((i) => out[i].isEmpty)
  if not missing.isEmpty
    made = compute(missing.map((i) => shaped[i]))
    for j in 0..missing.length
      out[missing[j]] = made[j]
  out

// What a read of a collection with its vectors becomes for a search: each item (id, metadata) with how far its vector
// is from `vector` by direction (cosine: 0 is the same one), the closest first.
closest(got: any, vector: double[]) <string, any>[]
  ids: string[] = got["ids"]
  if ids.length == 0
    return []
  metas: any[] = got["metadatas"] ?? []
  // one row per item (a numpy matrix): the whole shelf is measured at once
  kept: any = got["embeddings"]
  length = Math.sqrt(vector.map((x) => x * x).sum())
  lengths: any = numpy.linalg.norm(kept, axis = 1)
  apart: any = 1.0 - kept.dot(vector) / (lengths * length)
  far: double[] = apart.tolist()
  out: <string, any>[] = []
  for i in 0..ids.length
    out.add({ "id": ids[i], "meta": metas[i], "distance": (far[i] * 10000).round() / 10000 })
  out.sortedBy((item) => item["distance"]!)

// The first of two values that is a text with something in it.
textOr(first: any, second: any) string
  one = "${first ?? ""}"
  one.length > 0 ? one : "${second ?? ""}"

// What Chroma keeps as metadata: texts, numbers, booleans and lists of texts that are not empty.
storable(meta: <string, any>) <string, any>
  out: <string, any> = {}
  for key, value in meta
    if value is string or value is int or value is double or value is boolean or Assets.texts(value)
      out[key] = value
  out

// The graph's store: one Chroma collection per shelf (ADR-graph-0001), whose documents are encrypted and whose vectors
// come from the embeddings model run in this process (`localEmbed`). Only the server process opens it.
//
// A row's metadata is in clear (ids, names, keys, filters: what Chroma searches by); its text is sealed. The shelves
// of the knowledge base are made by `ingest`; `prompts` holds the prompts (the skills of the roles) and `memory` what an
// agent decided to keep about a project while working on it.
Store
  client: any
  box: Box
  embedder: (shaped: string[]) => double[][]
  cols: <string, Collection> = {}

  // `path`: the folder of the vectors (the data folder's `db` when left out); `key`: the key of the documents (the
  // keyring's when left out); `embed`: what gives the vectors (the local embeddings model when left out).
  (path: string = "", key: Bytes? = null, embed: ((shaped: string[]) => double[][])? = null)
    client = chromadb.PersistentClient(path = path.length > 0 ? path : "${Paths.db()}", settings = Settings(anonymizedTelemetry = false, allowReset = false))
    box = Box(key ?? Secrets.key())
    embedder = embed ?? localEmbed
    for name in COLLECTIONS
      cols[name] = client.getOrCreateCollection(name, metadata = { "hnsw:space": "cosine" }, embeddingFunction = null)

  col(name: string) Collection
    if not (name in cols)
      throw KeyError("unknown collection '${name}' (collections: ${COLLECTIONS.join(", ")})")
    cols[name]!

  // ---- writing ----

  // Adds or replaces items. Each is {id, document, meta} (a list `[id, text, meta]` is the same); what is embedded
  // is `embed` under `title` when given, else the document; with `query`, `embed` is embedded as a search is (a
  // question a row answers). The document is stored encrypted.
  put(collection: string, items: any[]) int
    rows: <string, any>[] = []
    for item in items
      rows.add(isinstance(item, dict) ? item : { "id": item[0], "document": item[1], "meta": item[2] })
    if rows.length == 0
      return 0
    shaped: string[] = []
    for row in rows
      meta: <string, any> = row["meta"]!
      shaped.add(row["query"] == true ? asQuery("${row["embed"]}") : asDocument(textOr(row["title"], meta["title"]), textOr(row["embed"], row["document"])))
    vectors: any = embedder(shaped)
    col(collection).upsert(
      ids = rows.map((r) => "${r["id"]}"),
      embeddings = vectors,
      documents = rows.map((r) => box.seal("${r["document"]}")),
      metadatas = rows.map((r) => storable(r["meta"]!)),
    )
    rows.length

  delete(collection: string, ids: string[]) void
    if ids.length > 0
      col(collection).delete(ids = ids.copy())

  // Removes the collections of before the shelves (ADR-graph-0001).
  dropLegacy() string[]
    gone: string[] = []
    for name in LEGACY
      try
        client.deleteCollection(name)
        gone.add(name)
      catch e
        // it was not there
        continue
    gone

  // ---- versions ----

  // The schema and the revision of the knowledge base this store holds (0: never ingested).
  version() <string, int>
    meta: <string, any> = client.getCollection(SHELVES.keys[0]).metadata ?? {}
    schema: int = meta["schema"] ?? 0
    revision: int = meta["revision"] ?? 0
    { "schema": schema, "revision": revision }

  setVersion(schema: int, revision: int) void
    for name in SHELVES.keys
      col(name).modify(metadata = { "schema": schema, "revision": revision })

  // ---- reading ----

  // id → content hash of the items of a collection (to embed again only what changed).
  hashes(collection: string, where: <string, any>? = null) <string, string>
    got: any = col(collection).get(where = where, include = ["metadatas"])
    ids: string[] = got["ids"]
    metas: <string, any>[] = got["metadatas"] ?? []
    out: <string, string> = {}
    for i in 0..Math.min(ids.length, metas.length)
      out[ids[i]] = "${metas[i]["hash"] ?? ""}"
    out

  embedQuery(query: string) double[]
    embedder([asQuery(query)])[0]

  // The `k` items closest to a vector among the ones a filter matches: id, metadata and distance (0 is the same
  // meaning), without their text. Exact: the vector the store keeps of each of them is compared (a shelf holds
  // hundreds of items: milliseconds). The store's own index is approximate and, once items were replaced, does not
  // reach every item it holds: it is not asked.
  near(collection: string, vector: double[], k: int, where: <string, any>? = null) <string, any>[]
    closest(col(collection).get(where = where, include = ["metadatas", "embeddings"]), vector).take(k)

  // How far each of these items is from a vector, as `near` gives them.
  measure(collection: string, vector: double[], ids: string[]) <string, any>[]
    if ids.length == 0
      return []
    closest(col(collection).get(ids = ids.unique(), include = ["metadatas", "embeddings"]), vector)

  // The items a filter matches: id and metadata.
  where(collection: string, where: <string, any>, limit: int? = null) <string, any>[]
    got: any = col(collection).get(where = where, limit = limit, include = ["metadatas"])
    ids: string[] = got["ids"]
    metas: any[] = got["metadatas"] ?? []
    out: <string, any>[] = []
    for i in 0..Math.min(ids.length, metas.length)
      out.add({ "id": ids[i], "meta": metas[i] })
    out

  // id → {text, meta} of the items with these ids (the ones that exist).
  documents(collection: string, ids: string[]) <string, <string, any>>
    out: <string, <string, any>> = {}
    if ids.length == 0
      return out
    got: any = col(collection).get(ids = ids.unique(), include = ["documents", "metadatas"])
    found: string[] = got["ids"]
    texts: string[] = got["documents"] ?? []
    metas: any[] = got["metadatas"] ?? []
    for i in 0..Math.min(found.length, Math.min(texts.length, metas.length))
      out[found[i]] = { "text": box.open(texts[i]), "meta": metas[i] }
    out

  // The items a filter matches, with their text.
  read(collection: string, where: <string, any>) <string, any>[]
    got: any = col(collection).get(where = where, include = ["documents", "metadatas"])
    found: string[] = got["ids"]
    texts: string[] = got["documents"] ?? []
    metas: any[] = got["metadatas"] ?? []
    out: <string, any>[] = []
    for i in 0..Math.min(found.length, Math.min(texts.length, metas.length))
      out.add({ "id": found[i], "text": box.open(texts[i]), "meta": metas[i] })
    out

  stats() <string, int>
    out: <string, int> = {}
    for name, held in cols
      out[name] = held.count()
    out
