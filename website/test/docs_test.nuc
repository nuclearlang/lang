// Tests of the site: the content repository is a mock; the use cases, managers and screens are the real code.
page() Page
  Page(
    path = "/nuclearlang/reference/nuclear-base",
    title = "The base language",
    html = "<h1>The base language</h1><p>Every rule of Nuclear.</p>",
    headings = [Heading(level = 2, id = "names", text = "Names and files")],
    source = "https://github.com/nuclearlang/nuclear/blob/main/nuclearlang/docs/07-reference/nuclear-base.md",
  )

entry(path: string, title: string, headings: string[], words: string) SearchEntry
  SearchEntry(path = path, title = title, headings = headings, words = words)

step(command: string, output: string) PlatformSteps
  PlatformSteps(title = "Create the project", text = "Only .nuc files.", command = command, output = output)

code() PlatformCode
  PlatformCode(path = "components/todos/api/todos_controller.nuc", html = "<pre>nuclear</pre>", outputs = [PlatformOutputs(dialect = "fastapi", path = "build/app/todos_controller.py", html = "<pre>python</pre>", logo = "/logos/fastapi.svg")])

logo() Logo
  Logo(name = "React", src = "/logos/react.svg")

shot() Shot
  Shot(
    id = "connector",
    image = "/shots/connector.webp",
    alt = "HTTP Connections",
    caption = "HTTP Connections",
    spots = [ShotSpot(x = 0.5, y = 0.5, label = "copy as curl")],
  )

module() ExtensionModule
  ExtensionModule(
    id = "http-connections",
    name = "HTTP Connections",
    icon = "/brand/http.svg",
    title = "An API client that fills itself",
    points = ["It finds the services of every project."],
    keys = [ShotKey(key = "Ctrl+Alt+H", label = "VS Code")],
    logos = [],
    marks = [],
    art = "",
    shots = [shot()],
    more = "/tools/http-connections",
  )

stats() PlatformStats
  PlatformStats(nucFiles = 14, nucLines = 99, outFiles = 15, outLines = 197)

home() Home
  Home(
    title = "NuclearLang",
    lead = "Write only the logic.",
    tagline = "A language.",
    actions = [Action(title = "Start", path = "/start/backend", primary = true)],
    targetsTitle = "Builds to",
    targets = [logo()],
    agentsTitle = "Made for your agents",
    agents = [Logo(name = "Claude Code", src = "/logos/claudecode.svg")],
    hooks = [Hook(title = "Made for agents", text = "One way to write each thing.", icon = "/icons/bot.svg")],
    samplesTitle = "Write it once",
    samplesNote = "A note.",
    samples = [Sample(title = "Models", nuclear = "<pre>nuclear</pre>", outputs = [Output(dialect = "typescript", html = "<pre>ts</pre>", logo = "/logos/typescript.svg")])],
    check = CheckDemo(title = "Errors an agent can fix", text = "Text.", wrong = "<pre>let x</pre>", diagnostics = [Diagnostic(code = "N0022", line = 1, col = 1, message = "declare by assigning", fix = "let  → ")], json = "<pre>[]</pre>", fixed = "<pre>x</pre>"),
    generatorTitle = "One command writes the feature",
    generatorText = "Text.",
    generatorPlatform = "backend",
    generator = [step("nuclear new todos_api -p backend", "created config.nuc")],
    stats = stats(),
    dialectsTitle = "Change the dialect",
    dialectsText = "Text.",
    dialects = code(),
    logs = module(),
    extension = Extension(title = "Everything in one extension", text = "Text.", editorsTitle = "Five editors", editors = [EditorLink(name = "Zed", src = "/logos/zed.svg", path = "/tools/zed")], modules = [module()]),
    platformsTitle = "Three platforms",
    platformsText = "Text.",
    platforms = [PlatformCard(key = "web", name = "Web", dialects = "react", logos = [logo()], tagline = "In a browser.")],
    toolsTitle = "The tools",
    toolsText = "Text.",
    tools = [ToolCard(key = "mcp", name = "MCP server", group = "AI", tagline = "Nuclear in any client.", icon = "/icons/plug.svg")],
    librariesTitle = "Any library",
    librariesText = "Text.",
    librariesCommand = "<pre>nuclear add motion</pre>",
    librariesExample = "<pre>example</pre>",
    install = Install(title = "Install in one line", text = "Text.", mark = "/brand/install.svg", systems = [InstallSystem(name = "Windows", logos = [logo()], html = "<pre>irm</pre>")], next = "<pre>nuclear new</pre>"),
  )

tool() Tool
  Tool(
    key = "mcp",
    name = "MCP server",
    group = "AI",
    tagline = "Nuclear in any client.",
    pitch = "It speaks MCP.",
    highlights = [ToolHighlights(title = "Generate first", text = "The generators, as tools.")],
    icon = "/icons/plug.svg",
    logos = [logo()],
    shots = [shot()],
    demo = "<pre>nuclear-mcp tools</pre>",
    project = "https://github.com/example/tree/main/tools/mcp",
    pages = [ToolPages(title = "The MCP server", path = "/mcp/guide/mcp")],
  )

platform() Platform
  Platform(
    key = "backend",
    name = "Backend",
    dialects = "fastapi · nestjs",
    logos = [logo()],
    tagline = "APIs from the same .nuc.",
    pitch = "Controllers and entities.",
    levels = [PlatformLevels(level = "1 · Context", title = "Your API and its clients", text = "Text.", boxes = [PlatformBoxes(name = "Your API", kind = "system", text = "in Nuclear")], flows = [PlatformFlows(source = "Clients", target = "Your API", text = "HTTP")])],
    pages = [PlatformPages(title = "The backend", path = "/backend/reference/backend")],
    app = "todos_api",
    example = "https://github.com/example/tree/main/todos_api",
    steps = [step("nuclear new todos_api -p backend", "created config.nuc"), step("nuclear check --json", "[]")],
    code = code(),
    stats = stats(),
  )

@mock([ContentRepository, ToolRepository, PlatformRepository])
DocsTest
  beforeEach()
    when(ContentRepository.page).thenReturn(Ok(page()))
    when(ContentRepository.site).thenReturn(
      Ok(
        Site(
          title = "NuclearLang",
          url = "https://example.org",
          org = "https://github.com/example",
          footer = "Footer text",
          top = [Link(title = "Guide", path = "/nuclearlang/guide/README")],
          sections = [NavSection(title = "Reference", items = [Link(title = "Base", path = "/nuclearlang/reference/nuclear-base")])],
        ),
      ),
    )
    when(ContentRepository.index).thenReturn(
      Ok([
        entry("/c", "Operators", [], "results of every operation"),
        entry("/b", "Errors", ["Results and errors"], ""),
        entry("/a", "Results", [], ""),
        entry("/d", "Lambdas", [], "nothing here"),
      ]),
    )
    when(ContentRepository.home).thenReturn(Ok(home()))
    when(ToolRepository.all).thenReturn(Ok([tool()]))
    when(PlatformRepository.all).thenReturn(Ok([platform()]))

  @test("the search ranks a title before a heading before a word of the text")
  ranks()
    found = okOf(~SearchUseCase.exec("Results"))
    expect(found.map((r) => r.path)).toEqual(["/a", "/b", "/c"])

  @test("a query of one letter finds nothing")
  shortQuery()
    expect(okOf(~SearchUseCase.exec(" r "))).toEqual([])

  @widget("a page of the documentation shows its text, its headings and the menu")
  showsPage()
    renderScreen(DocScreen(area = "spec", name = "nuclear-base"))
    ~screen.findByText("Every rule of Nuclear.")
    ~screen.findByText("Names and files")
    ~screen.findByText("Base")
    ~screen.findByText("Guide")

  @widget("the home page shows its hooks, a tab per target, the agent's fix and the replayed commands")
  showsHome()
    renderScreen(HomeScreen())
    ~screen.findByText("Write only the logic.")
    ~screen.findByText("Made for agents")
    ~screen.findByText("typescript")
    ~screen.findByText("Run nuclear fix")
    ~screen.findByText("\$ nuclear new todos_api -p backend")
    ~screen.findByText("Every tool")
    ~screen.findByText("Everything in one extension")
    ~screen.findByText("Made for your agents")
    ~screen.findByText("Install in one line")
    ~screen.findByText("Zed")
    ~screen.findAllByText("An API client that fills itself")
    ~screen.findAllByText("Ctrl+Alt+H")

  @widget("the page of a tool shows its pitch, how it starts and the index of its documents")
  showsTool()
    renderScreen(ToolScreen(name = "mcp"))
    ~screen.findByText("It speaks MCP.")
    ~screen.findByText("Generate first")
    ~screen.findByText("The MCP server")
    ~screen.findAllByText("HTTP Connections")
    ~screen.findAllByText("React")

  @widget("a tool that does not exist says so")
  missingTool()
    renderScreen(ToolScreen(name = "nope"))
    ~screen.findByText("There is no tool named nope.")

  @widget("the page of a platform shows its levels down to the code")
  showsPlatform()
    renderScreen(PlatformScreen(name = "backend"))
    ~screen.findByText("Your API and its clients")
    ~screen.findByText("4 · Code")
    ~screen.findByText("build/app/todos_controller.py")

  @widget("the onboarding of a platform shows its first step and its real output")
  showsOnboarding()
    renderScreen(StartScreen(name = "backend"))
    ~screen.findByText("Build todos_api")
    ~screen.findAllByText("\$ nuclear new todos_api -p backend")
    ~screen.findByText("Next")
