// The home page, from site.toml (public/content/home.json): its hooks and its interactive blocks. Every output in it
// was made by the real compiler and the real commands when the site was built.
Home
  title: string
  lead: string
  tagline: string
  actions: Action[]
  targetsTitle: string
  targets: Logo[]
  agentsTitle: string
  agents: Logo[]
  hooks: Hook[]
  samplesTitle: string
  samplesNote: string
  samples: Sample[]
  check: CheckDemo
  generatorTitle: string
  generatorText: string
  generatorPlatform: string
  generator: PlatformSteps[]
  stats: PlatformStats
  dialectsTitle: string
  dialectsText: string
  dialects: PlatformCode
  logs: ExtensionModule
  extension: Extension
  platformsTitle: string
  platformsText: string
  platforms: PlatformCard[]
  toolsTitle: string
  toolsText: string
  tools: ToolCard[]
  librariesTitle: string
  librariesText: string
  librariesCommand: string
  librariesExample: string
  install: Install

Action
  title: string
  path: string
  primary: boolean

Hook
  title: string
  text: string
  icon: string

// A sample: its Nuclear and what each target language's dialect writes from it (highlighted HTML).
Sample
  title: string
  nuclear: string
  outputs: Output[]

Output
  dialect: string
  html: string
  logo: string

// An agent's mistake, what `nuclear check --json` answers and what `nuclear fix` makes of it.
CheckDemo
  title: string
  text: string
  wrong: string
  diagnostics: Diagnostic[]
  json: string
  fixed: string

Diagnostic
  code: string
  line: int
  col: int
  message: string
  fix: string

PlatformCard
  key: string
  name: string
  dialects: string
  logos: Logo[]
  tagline: string

ToolCard
  key: string
  name: string
  group: string
  tagline: string
  icon: string

// The editor block: the parts of the extension, most important first.
Extension
  title: string
  text: string
  editorsTitle: string
  editors: EditorLink[]
  modules: ExtensionModule[]

// An editor the extension runs in: its logo and the page that explains it.
EditorLink
  name: string
  src: string
  path: string

// The install block: a tab per system (its logos and its command, highlighted) and what to run next.
Install
  title: string
  text: string
  mark: string
  systems: InstallSystem[]
  next: string

InstallSystem
  name: string
  logos: Logo[]
  html: string
