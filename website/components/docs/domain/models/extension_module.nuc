// A part of the extension as the home page shows it (site.toml [[modules]]): its mark, a slogan, at most three
// points, its keys, the logos of what it works with, its own marks, an animated art, its screenshots and the page
// that explains it (`more`).
ExtensionModule
  id: string
  name: string
  icon: string
  title: string
  points: string[]
  keys: ShotKey[]
  logos: Logo[]
  marks: Logo[]
  art: string
  shots: Shot[]
  more: string
