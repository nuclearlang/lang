// The onboarding of a platform (/start/web), two ways: with an agent (the set-up that gives it the context: the MCP
// server, the Smart Graph, the project's agent files; then what to ask it), or by hand (the commands that make the
// example app, each with the output it gave when this site was built: the site runs them again on every build).
@screen(route = "/start/:name", providers = [PlatformsManager, SiteManager, SearchManager])
stateless StartScreen(name: string)
  build() Element
    Frame(
      current = "/platforms",
      content = PlatformsStateBuilder(
        loading = () => p(className = "muted center", children = "Loading…"),
        full = (items) => Reveal(key = name, child = Onboarding(key = name, platforms = items, name = name)),
        error = (e) => p(className = "error center", children = e.message),
      ),
    )

stateful Onboarding(platforms: Platform[], name: string)
  step: int = 0
  agent: boolean = true

  build() Element
    platform = platforms.find((p) => p.key == name)
    if platform == null
      section(className = "missing", children = [h1(children = "Not found"), p(children = "There is no platform named ${name}."), a(href = "/platforms", children = "The platforms")])
    else
      fragment(
        PlatformTabs(platforms = platforms, current = name, base = "/start"),
        section(
          className = "page-hero",
          children = [
            small(className = "eyebrow rise", children = "Onboarding · ${platform.name}"),
            h1(className = "rise", children = "Build ${platform.app}"),
            p(className = "lead rise", children = agent ? "${platform.agentSteps.length} steps. Your agent writes the app; the tools give it what it needs to know." : "${platform.steps.length} steps. Nothing written by hand: every file comes from the tools."),
            div(
              className = "pills rise",
              children = [
                button(className = agent ? "pill active" : "pill", onClick = () => choose(true), children = "With an agent"),
                button(className = agent ? "pill" : "pill active", onClick = () => choose(false), children = "By hand"),
              ],
            ),
          ],
        ),
        ol(
          className = "stepper rise",
          children = (agent ? platform.agentSteps : platform.steps).map((s, i) =>
            li(key = s.title, className = i == step ? "current" : i < step ? "done" : "", children = button(onClick = () => go(i), children = [span(className = "number", children = "${i + 1}"), span(children = s.title)]))
          ),
        ),
        StepCard(key = "${agent}${step}", step = agent ? platform.agentSteps[step] : platform.steps[step]),
        div(
          className = "actions",
          children = [
            if step > 0 button(className = "button", onClick = () => go(step - 1), children = "Back"),
            if step < (agent ? platform.agentSteps : platform.steps).length - 1 button(className = "button primary", onClick = () => go(step + 1), children = "Next"),
          ],
        ),
        agent ? Prompts(platform = platform) : step == platform.steps.length - 1 ? Done(platform = platform) : span(),
      )

  go(index: int) void
    setState(() =>
      step = index
    )

  choose(withAgent: boolean) void
    setState(() =>
      agent = withAgent
      step = 0
    )

stateless StepCard(step: PlatformSteps)
  build() Element
    section(
      className = "step-card",
      children = [
        h2(children = step.title),
        p(children = step.text),
        Terminal(key = step.command, steps = [step], title = step.output == "" ? "run it on your machine" : "its real output", controls = false),
      ],
    )

// The end of the onboarding: the app is made; its code, the example in the tree and where to read on.
stateless Done(platform: Platform)
  build() Element
    section(
      className = "block",
      children = [
        h2(children = "That is the whole app"),
        p(className = "block-text", children = "${platform.stats.nucFiles} .nuc files and ${platform.stats.nucLines} lines of Nuclear, all written by the commands above; the dialect writes ${platform.stats.outLines} lines from them."),
        CodeTabs(
          titles = platform.code.outputs.map((o) => o.path),
          panes = platform.code.outputs.map((o) => o.html),
          pinned = platform.code.html,
          pinnedTitle = platform.code.path,
          icons = platform.code.outputs.map((o) => o.logo),
        ),
        div(
          className = "actions",
          children = [
            a(className = "button primary", href = platform.example, children = "The example in the tree"),
            a(className = "button", href = "/platforms/${platform.key}", children = "How the platform works"),
            ...platform.pages.slice(0, 1).map((d) => a(key = d.path, className = "button", href = d.path, children = "The guide")),
          ],
        ),
      ],
    )

// What to ask an agent on this platform: apps of several kinds, and what it uses to write them.
stateless Prompts(platform: Platform)
  build() Element
    section(
      className = "block",
      children = [
        h2(children = "Ask for an app"),
        p(className = "block-text", children = "A few starting points. Say what you want; the agent reads AGENTS.md, asks the Smart Graph through the MCP server, runs the generators and checks every file."),
        ul(className = "prompts", children = platform.prompts.map((t) => li(key = t, children = t))),
        div(className = "actions", children = [a(className = "button", href = "/tools/mcp", children = "The MCP server"), a(className = "button", href = "/tools/graph", children = "The Smart Graph"), a(className = "button", href = "/tools/atlas", children = "Nuclear Atlas")]),
      ],
    )
