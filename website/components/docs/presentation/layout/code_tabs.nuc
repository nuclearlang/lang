// Code in tabs: one pane at a time (highlighted HTML, made when the site was built). With `pinned` the Nuclear stays
// on the left and the tabs choose what it becomes on the right.
stateful CodeTabs(titles: string[], panes: string[], pinned: string = "", pinnedTitle: string = "Nuclear")
  selected: int = 0

  build() Element
    div(
      className = pinned == "" ? "code-tabs" : "code-tabs compare",
      children = [
        if pinned != "" div(className = "pane pinned", children = [div(className = "pane-title", children = pinnedTitle), div(className = "code", dangerouslySetInnerHTML = { "__html": pinned })]),
        div(
          className = "pane",
          children = [
            div(
              className = "tabs",
              role = "tablist",
              children = titles.map((t, i) =>
                button(key = t, role = "tab", className = i == selected ? "tab active" : "tab", onClick = () => select(i), children = t)
              ),
            ),
            div(className = "code", dangerouslySetInnerHTML = { "__html": panes[selected] }),
          ],
        ),
      ],
    )

  select(index: int) void
    setState(() =>
      selected = index
    )
