// The platform this project is written for and the dialect it is built with (ADR-synapsis-0002, ADR-web-0001).
synapsis(platform = "web", dialect = "react")
app(name = "nuclearlang_website", title = "NuclearLang", description = "A minimal language for AI agents and people, transpiled to TypeScript, Dart and Python; Synapsis, its framework for mobile, backend and web.", version = "0.1.0")

dependencies(
  motion = "^14.14.0",
)
