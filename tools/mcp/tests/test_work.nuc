use json
use shutil
use asyncio
use pytest
use mcp_types
use pathlib{ Path }
use mcp/client/client{ Client }
use mcp/server/mcpserver{ MCPServer }

// The tools that organize the user's work (spec 022): each change asked first (elicitation, or a preview and its
// confirm token), and each tool a thin call of `nuclear workspace` or `nuclear-builder`, run here by a fake runner.

// A command runner that answers `out` and keeps every call: [args, cwd, stdin].
Runner(out: string = "{\"ok\": true}")
  calls: any[][] = []

  run(args: string[], cwd: string? = null, stdin: string = "") Ran
    ~asyncio.sleep(0)
    calls.add([args, cwd, stdin])
    Ran(0, out)

// What a client answers to an elicitation.
Reply(action: string, content: <string, any>? = null)

Caps(elicitation: any = null)

// A client's session: whether it can ask (its capabilities) and what its user answers.
Session(clientCapabilities: Caps, reply: Reply, canSendRequest: boolean = true)
  asked: string[] = []

  elicitForm(message: string, requestedSchema: any, relatedRequestId: any = null) Reply
    ~asyncio.sleep(0)
    asked.add(message)
    reply

// A tool call's context, as the MCP library gives it.
Ctx(session: Session, requestId: int = 1)

asking(action: string, yes: boolean = true) Ctx
  Ctx(Session(Caps({ "form": {} as <string, any> }), Reply(action, { "confirm": yes })))

said(text: string) <string, any>
  json.loads(text)

testAChangeAskedByElicitationIsDoneOnlyOnTheUsersYes(tmpPath: Path) void
  runner = Runner()
  tools = WorkTools(runner.run)
  yes = asking("accept")
  asyncio.run(tools.workspaceCreate("${tmpPath}/shop", "shop", "", "", yes))
  expect(runner.calls.length == 1 and runner.calls[0][0] == ["nuclear", "workspace", "new", "${tmpPath.resolve()}/shop", "--name", "shop", "--json"])
  expect("Create the workspace `shop`" in yes.session.asked[0] and ".workspace/workspace.nuc" in yes.session.asked[0])
  // declined, cancelled or a yes unticked: nothing runs
  for ctx in [asking("decline"), asking("cancel"), asking("accept", false)]
    out = said(asyncio.run(tools.workspaceCreate("${tmpPath}/shop", "shop", "", "", ctx)))
    expect(out["declined"] != null and runner.calls.length == 1)

// The migrations of a backend project: reading them asks nothing; writing one and changing the database ask first.
testMigrationsAreReadFreelyAndChangeTheDatabaseOnlyOnTheUsersYes(tmpPath: Path) void
  project = tmpPath.joinpath("shop_api")
  project.joinpath("components").mkdir(parents = true)
  project.joinpath("config.nuc").writeText("synapsis(platform = \"backend\", dialect = \"fastapi\")\n")
  root = "${project.resolve()}"
  runner = Runner("applied 20261122100000_notes")
  tools = WorkTools(runner.run)
  // status: no question, from a folder inside the project
  status = said(asyncio.run(tools.projectMigrate("${project}/components")))
  expect(status["ok"] == true and status["output"] == "applied 20261122100000_notes")
  expect(runner.calls.length == 1 and runner.calls[0][0] == ["nuclear", "migrate", "status"] and runner.calls[0][1] == root)
  // without a client that can ask: a preview that says what changes, nothing run
  preview = said(asyncio.run(tools.projectMigrate(root, "up")))
  expect(preview["confirm"] != null and "Apply the pending migrations" in "${preview["preview"]}" and runner.calls.length == 1)
  // the token is for that exact change: another action does not use it
  other = said(asyncio.run(tools.projectMigrate(root, "down", "", "", "${preview["confirm"]}")))
  expect(other["error"] != null and runner.calls.length == 1)
  again = said(asyncio.run(tools.projectMigrate(root, "up")))
  done = said(asyncio.run(tools.projectMigrate(root, "up", "", "", "${again["confirm"]}")))
  expect(done["ok"] == true and runner.calls[1][0] == ["nuclear", "migrate", "up"])
  // a client that asks: the user reads what is dropped before a down
  yes = asking("accept")
  asyncio.run(tools.projectMigrate(root, "down", "", "20261122100000_notes", "", false, "", [], yes))
  expect(runner.calls[2][0] == ["nuclear", "migrate", "down", "--to", "20261122100000_notes"])
  expect("dropped, with its data" in yes.session.asked[0])
  made = asking("accept")
  asyncio.run(tools.projectMigrate(root, "make", "notes on tasks", "", "", false, "", [], made))
  expect(runner.calls[3][0] == ["nuclear", "migrate", "make", "notes on tasks"] and "The database is not changed" in made.session.asked[0])
  no = said(asyncio.run(tools.projectMigrate(root, "up", "", "", "", false, "", [], asking("decline"))))
  expect(no["declined"] != null and runner.calls.length == 4)
  // fake and transaction reach the command; a fake says that nothing runs
  marked = asking("accept")
  asyncio.run(tools.projectMigrate(root, "up", "", "", "", true, "each", [], marked))
  expect(runner.calls[4][0] == ["nuclear", "migrate", "up", "--fake", "--transaction", "each"])
  expect("without running them" in marked.session.asked[0])
  // a rename reaches make, and the user reads it
  renamed = asking("accept")
  asyncio.run(tools.projectMigrate(root, "make", "shops are stores", "", "", false, "", ["shops=stores", "orders.shop_id=store_id"], renamed))
  expect(runner.calls[5][0] == ["nuclear", "migrate", "make", "shops are stores", "--rename", "shops=stores", "--rename", "orders.shop_id=store_id"])
  expect("renamed, keeping the rows: shops=stores, orders.shop_id=store_id" in renamed.session.asked[0])
  // what is refused before anything runs
  for wrong in [
    tools.projectMigrate("${tmpPath}", "status"),
    tools.projectMigrate(root, "sideways"),
    tools.projectMigrate(root, "make"),
    tools.projectMigrate(root, "up", "a message"),
    tools.projectMigrate(root, "status", "", "20261122100000_notes"),
    tools.projectMigrate(root, "up", "", "--force"),
    tools.projectMigrate(root, "status", "", "", "", true),
    tools.projectMigrate(root, "up", "", "", "", false, "some"),
    tools.projectMigrate(root, "up", "", "", "", false, "", ["shops=stores"]),
    tools.projectMigrate(root, "make", "shops", "", "", false, "", ["--force"]),
  ]
    expect(said(asyncio.run(wrong))["error"] != null)
  expect(runner.calls.length == 6)

// A runner of `nuclear test` (its exit code and output) and of `nuclear explain` (its JSON), with every call kept.
FakeTests(code: int, out: string, explained: string = "{}")
  calls: any[][] = []

  run(args: string[], cwd: string? = null, stdin: string = "") Ran
    ~asyncio.sleep(0)
    calls.add([args, cwd, stdin])
    args[1] == "explain" ? Ran(0, explained) : Ran(code, out)

// Every project of the machine and its address: `nuclear projects --json`, as it printed it.
testProjectsListIsTheRegistryOfTheMachine() void
  listed = "{\"projects\": [{\"name\": \"api\", \"platform\": \"backend\", \"url\": \"http://127.0.0.1:8000\", \"port\": 8000}]}"
  runner = Runner(listed)
  got = said(asyncio.run(WorkTools(runner.run).projectsList()))
  expect(got["projects"][0]["port"] == 8000)
  expect(runner.calls == [[["nuclear", "projects", "--json"], null, ""]])

// The tests of a project: the same answer whatever the dialect's runner prints.
testTheTestsOfAProjectAnswerTheSameInEveryDialect(tmpPath: Path) void
  project = tmpPath.joinpath("shop_api")
  project.joinpath("test").mkdir(parents = true)
  project.joinpath("config.nuc").writeText("synapsis(platform = \"backend\", dialect = \"fastapi\")\n")
  root = "${project.resolve()}"
  green = FakeTests(0, "...\n3 passed in 0.03s")
  ok = said(asyncio.run(WorkTools(green.run).projectTest("${project}/test")))
  expect(ok["ok"] == true and ok["passed"] == 3 and ok["failed"] == 0 and ok["failures"] == [])
  expect(green.calls.length == 1 and green.calls[0][0] == ["nuclear", "test"] and green.calls[0][1] == root)
  // a failure: where it is in the .nuc and what it means, from `nuclear explain` given the runner's output
  frames = "{\"frames\": [{\"line\": 15, \"name\": \"missing\", \"source\": \"${root}/test/notes_test.nuc\"}], \"hint\": \"A test's expect failed\"}"
  red = FakeTests(1, "FAILED tests/notes_test.py::test_missing\n1 failed, 2 passed in 0.05s", frames)
  bad = said(asyncio.run(WorkTools(red.run).projectTest(root)))
  expect(bad["ok"] == false and bad["passed"] == 2 and bad["failed"] == 1 and bad["hint"] == "A test's expect failed")
  expect(bad["failures"] == [{ "file": "${root}/test/notes_test.nuc", "line": 15, "name": "missing" }])
  expect(red.calls[1][0] == ["nuclear", "explain", "--json"] and "1 failed" in "${red.calls[1][2]}")
  expect(said(asyncio.run(WorkTools(green.run).projectTest("${tmpPath}")))["error"] != null)
  // each runner's own words
  expect(countsOfTests("1 failed, 2 passed in 0.05s") == [2, 1])
  expect(countsOfTests("ℹ tests 16\nℹ pass 15\nℹ fail 1") == [15, 1])
  expect(countsOfTests("00:02 +7: All tests passed!") == [7, 0])
  expect(countsOfTests("00:02 +5 -2: Some tests failed.") == [5, 2])
  expect(countsOfTests(" Tests  1 failed | 8 passed (9)") == [8, 1])
  expect(countsOfTests("2 passed, 1 error in 0.1s") == [2, 1])
  expect(countsOfTests("nothing ran") == [0, 0])

// The yes or no a real client's user gives (the MCP library's client, over the initialize handshake of stdio).
Answering(yes: boolean)
  asked: string[] = []

  answer(context: any, params: any) any
    ~asyncio.sleep(0)
    asked.add("${params.message}")
    mcpTypes.ElicitResult(action = yes ? "accept" : "decline", content = yes ? { "confirm": true } : null)

called(server: MCPServer, answering: Answering?, tool: string, args: <string, any>) string
  client = answering == null ? Client(server, mode = "legacy") : Client(server, elicitationCallback = answering!.answer, mode = "legacy")
  ~client.__aenter__()
  try
    result = ~client.callTool(tool, args)
    parts: any[] = result.content
    return "${parts[0].text}"
  finally
    ~client.__aexit__(null, null, null)

testAToolAsksThroughTheProtocolsElicitationAndFallsBackToAPreview() void
  runner = Runner()
  server = MCPServer("test")
  for tool in WorkTools(runner.run).all()
    server.addTool(tool)
  yes = Answering(true)
  expect(said(asyncio.run(called(server, yes, "team_delete", { "team": "dev" })))["ok"] == true and "Delete the team `dev`" in yes.asked[0])
  no = Answering(false)
  expect(said(asyncio.run(called(server, no, "team_delete", { "team": "dev" })))["declined"] != null and runner.calls.length == 1)
  // a client without elicitation: the preview and its token
  expect(said(asyncio.run(called(server, null, "team_delete", { "team": "dev" })))["confirm"] != null and runner.calls.length == 1)

testAClientThatCannotAskGetsAPreviewAndATokenForThatExactChangeOnce(tmpPath: Path) void
  runner = Runner()
  tools = WorkTools(runner.run)
  // no context, or a client without the elicitation capability: a preview, nothing run
  for ctx in [null, Ctx(Session(Caps(), Reply("accept", { "confirm": true })))]
    preview = said(asyncio.run(tools.teamDelete("dev-team", "", ctx)))
    expect(preview["confirm"] != null and "Delete the team `dev-team`" in "${preview["preview"]}" and runner.calls.isEmpty)
  token = "${said(asyncio.run(tools.teamDelete("dev-team")))["confirm"]}"
  // the token of another change is refused, and used up
  wrong = said(asyncio.run(tools.teamDelete("other-team", token)))
  expect("another change" in "${wrong["error"]}" and runner.calls.isEmpty)
  token = "${said(asyncio.run(tools.teamDelete("dev-team")))["confirm"]}"
  asyncio.run(tools.teamDelete("dev-team", token))
  expect(runner.calls.length == 1 and runner.calls[0][0] == ["nuclear-builder", "team", "delete", "dev-team", "--json"])
  // once only
  again = said(asyncio.run(tools.teamDelete("dev-team", token)))
  expect("unknown, expired or used" in "${again["error"]}" and runner.calls.length == 1)
  // expired after five minutes
  late = "${said(asyncio.run(tools.teamDelete("dev-team")))["confirm"]}"
  PENDING[late]!["until"] = 0
  expect("expired" in "${said(asyncio.run(tools.teamDelete("dev-team", late)))["error"]}" and runner.calls.length == 1)
  expect("unknown" in "${said(asyncio.run(tools.teamDelete("dev-team", "made-up")))["error"]}" and runner.calls.length == 1)

testDeletingAWorkspaceRemovesItsMarkerAndItsAppsFoldersOnlyWhenAsked(tmpPath: Path) void
  root = tmpPath.joinpath("shop")
  root.joinpath(".workspace").mkdir(parents = true)
  root.joinpath(".workspace", "workspace.nuc").writeText("workspace(name = \"shop\")\n")
  root.joinpath("shop-api").mkdir()
  shown = Json.encode({ "root": "${root}", "name": "shop", "apps": [{ "name": "shop-api", "folder": "shop-api", "platform": "backend" }] })
  runner = Runner(shown)
  tools = WorkTools(runner.run)
  yes = asking("accept")
  done = said(asyncio.run(tools.workspaceDelete("${root}", false, "", yes)))
  expect(done["deleted"] == "${root}" and not root.joinpath(".workspace").exists() and root.joinpath("shop-api").isDir())
  expect("only its marker" in yes.session.asked[0] and "stay as they are" in yes.session.asked[0])
  expect(runner.calls.map((c) => c[0]) == [["nuclear", "workspace", "show", "--json"]])
  // the folders too, said in the question, each removed by `nuclear workspace remove --delete`
  root.joinpath(".workspace").mkdir()
  root.joinpath(".workspace", "workspace.nuc").writeText("workspace(name = \"shop\")\n")
  sure = asking("accept")
  asyncio.run(tools.workspaceDelete("${root}", true, "", sure))
  expect("AND the folders of its 1 app(s): shop-api" in sure.session.asked[0])
  expect(runner.calls.last[0] == ["nuclear", "workspace", "remove", "shop-api", "--delete", "--json"] and runner.calls.last[1] == "${root}")

testTheAppsToolsCallTheWorkspaceCommandInTheWorkspace(tmpPath: Path) void
  runner = Runner()
  tools = WorkTools(runner.run)
  yes = asking("accept")
  asyncio.run(tools.appAdd("${tmpPath}", "shop-web", "web", "react", "", yes))
  asyncio.run(tools.appRename("${tmpPath}", "shop-web", "shop-site", "", yes))
  asyncio.run(tools.appRemove("${tmpPath}", "shop-site", false, "", yes))
  asyncio.run(tools.appRemove("${tmpPath}", "shop-site", true, "", yes))
  expect(runner.calls.map((c) => c[0]) == [["nuclear", "workspace", "add", "shop-web", "--platform", "web", "--dialect", "react", "--json"], ["nuclear", "workspace", "rename", "shop-web", "shop-site", "--json"], ["nuclear", "workspace", "remove", "shop-site", "--json"], ["nuclear", "workspace", "remove", "shop-site", "--delete", "--json"]])
  expect(runner.calls.all((c) => c[1] == "${tmpPath}") and "delete its folder" in yes.session.asked[3])
  // a platform that is not one, a word read as an option: refused before asking
  expect("not a platform" in "${said(asyncio.run(tools.appAdd("${tmpPath}", "x", "desktop", "", "", yes)))["error"]}")
  expect(said(asyncio.run(tools.appRename("${tmpPath}", "x", "--delete", "", yes)))["error"] != null and yes.session.asked.length == 4)

testASpecIsWrittenByNuclearBuilderInTheProjectAndEditedWholeAfterTheUsersYes(tmpPath: Path) void
  project = tmpPath.joinpath("shop")
  project.mkdir()
  project.joinpath("config.nuc").writeText("")
  runner = Runner("{\"id\": \"lend-a-book\", \"path\": \"specs/books/lend-a-book\"}")
  tools = WorkTools(runner.run)
  yes = asking("accept")
  refused = said(asyncio.run(tools.specCreate("${project}", "books", "Lend a book", [] as string[], "", "feature", "", "", "", "", yes)))
  expect("acceptance criteria" in "${refused["error"]}" and runner.calls.isEmpty)
  asyncio.run(tools.specCreate("${project}", "books", "Lend a book", ["a lent book is not free"], "domain", "feature", "A reader borrows a book.", "", "es", "", yes))
  expect(runner.calls[0][0] == ["nuclear-builder", "spec", "new", "--title", "Lend a book", "--component", "books", "--use-case", "feature", "--layer", "domain", "--description", "A reader borrows a book.", "--criteria", "a lent book is not free", "--language", "es", "--json"])
  expect(runner.calls[0][1] == "${project}" and "specs/books/domain/<id>/spec.md" in yes.session.asked[0] and "- a lent book is not free" in yes.session.asked[0])
  asyncio.run(tools.specEdit("${project}", "lend-a-book", "# Lend a book for two weeks\n", "", yes))
  expect(runner.calls.last[0] == ["nuclear-builder", "spec", "update", "lend-a-book", "--stdin", "--json"] and runner.calls.last[2] == "# Lend a book for two weeks\n")
  expect("specs/books/lend-a-book/spec.md" in yes.session.asked[1])
  expect("not inside a Synapsis project" in "${said(asyncio.run(tools.specList("${tmpPath}")))["error"]}")

testTheTeamsToolsCallNuclearBuilderAndNeverHireALocalMember() void
  runner = Runner()
  tools = WorkTools(runner.run)
  yes = asking("accept")
  expect(LOCAL_STANDBY in "${said(asyncio.run(tools.memberAdd("dev", "developer", "", "local", "", "", "", 1, "", yes)))["error"]}")
  expect(LOCAL_STANDBY in "${said(asyncio.run(tools.teamCreate("Dev", "", "", null, [{ "role": "qa", "kind": "local" }], null, ctx = yes)))["error"]}" and runner.calls.isEmpty)
  asyncio.run(tools.teamCreate("Dev", "Ship the shop", "", ["testing"], [{ "role": "developer", "provider": "claude-code" }], 5.0, ctx = yes))
  expect(runner.calls[0][0] == ["nuclear-builder", "team", "create", "--json"] and json.loads("${runner.calls[0][2]}")["members"] == [{ "role": "developer", "provider": "claude-code" }])
  asyncio.run(tools.memberAdd("dev", "qa", "", "agent", "codex", "", "", 2, "", yes))
  expect(runner.calls[1][0] == ["nuclear-builder", "team", "member", "add", "dev", "--role", "qa", "--kind", "agent", "--provider", "codex", "--count", "2", "--json"])
  asyncio.run(tools.memberEdit("dev", "qa-001", instructions = "Be thorough", ctx = yes))
  expect(runner.calls[2][0] == ["nuclear-builder", "team", "member", "update", "dev", "qa-001", "--instructions", "Be thorough", "--json"])
  asyncio.run(tools.memberRemove("dev", "qa-001", "", yes))
  asyncio.run(tools.skillsSet("dev", ["testing", "security"], "", "", yes))
  asyncio.run(tools.teamEdit("dev", "Developers", "", "", null, "", null, "", "", "", "", "", "", yes))
  expect(runner.calls.slice(3).map((c) => c[0]) == [["nuclear-builder", "team", "member", "remove", "dev", "qa-001", "--json"], ["nuclear-builder", "team", "skills", "set", "dev", "--skills", "testing,security", "--json"], ["nuclear-builder", "team", "update", "dev", "--name", "Developers", "--json"]])
  asyncio.run(tools.teamList())
  expect(runner.calls.last[0] == ["nuclear-builder", "team", "list", "--json"] and yes.session.asked.length == 6)
  // the team's method, instructions and model for every member (spec 023)
  asyncio.run(tools.teamEdit("dev", "", "", "", null, "", null, "Kanban", "Small pull requests", "agent", "codex", "gpt-5", "", yes))
  expect(runner.calls.last[0] == ["nuclear-builder", "team", "update", "dev", "--method", "Kanban", "--instructions", "Small pull requests", "--kind", "agent", "--provider", "codex", "--model", "gpt-5", "--json"] and "codex" in yes.session.asked.last)
  expect(LOCAL_STANDBY in "${said(asyncio.run(tools.teamEdit("dev", "", "", "", null, "", null, "", "", "local", "", "", "", yes)))["error"]}")
  asyncio.run(tools.teamCreate("Ops", "", "", null, [{ "role": "devops" }], null, "", "Write runbooks", "api", "anthropic", "claude-sonnet-4-5", "", yes))
  draft = json.loads("${runner.calls.last[2]}")
  expect(draft["brain"] == { "kind": "api", "provider": "anthropic", "model": "claude-sonnet-4-5" } and draft["instructions"] == "Write runbooks" and draft["method"] == "")

// The rest of Nuclear Builder (what its page and the company screen do): each a `nuclear-builder` command in the
// project, every change asked first and nothing run on a no; a run started or answered in a process of its own.
testTheRestOfNuclearBuilderIsReachedAndEveryChangeAskedFirst(tmpPath: Path) void
  project = tmpPath.joinpath("shop")
  project.mkdir()
  project.joinpath("config.nuc").writeText("")
  runner = Runner("{\"id\": \"lend-a-book\", \"path\": \"specs/books/lend-a-book\"}")
  tools = WorkTools(runner.run)
  no = asking("accept", false)
  declined = said(asyncio.run(tools.runStart("${project}", "lend-a-book", ctx = no)))
  // the spec is read to find its file, nothing is started
  expect(declined["changed"] == "nothing: the user said no" and runner.calls.length == 1)
  yes = asking("accept")
  asyncio.run(tools.runStart("${project}", "lend-a-book", "dev", "developer=dev-017", ctx = yes))
  expect(runner.calls.last[0] == ["nuclear-builder", "run", "${project.resolve()}/specs/books/lend-a-book/spec.md", "--detach", "--team", "dev", "--assign", "developer=dev-017"] and runner.calls.last[1] == "${project.resolve()}")
  // several specs in one run: each one's file, in order
  asyncio.run(tools.runStart("${project}", specs = ["lend-a-book", "lend-a-book"], ctx = yes))
  expect(runner.calls.last[0] == ["nuclear-builder", "run", "${project.resolve()}/specs/books/lend-a-book/spec.md", "${project.resolve()}/specs/books/lend-a-book/spec.md", "--detach"])
  asyncio.run(tools.runAnswer("${project}", "r1", "change", "Smaller steps", ctx = yes))
  expect(runner.calls.last[0] == ["nuclear-builder", "run", "answer", "r1", "--answer", "change", "--text", "Smaller steps", "--detach"])
  expect("not an answer" in "${said(asyncio.run(tools.runAnswer("${project}", "r1", "maybe", ctx = yes)))["error"]}")
  asyncio.run(tools.runRetry("${project}", "r1", "code", ctx = yes))
  expect(runner.calls.last[0] == ["nuclear-builder", "retry", "r1", "--from", "code", "--detach"])
  asyncio.run(tools.checkMark("${project}", "r1", "c2", "passed", ctx = yes))
  expect(runner.calls.last[0] == ["nuclear-builder", "checks", "r1", "mark", "c2", "passed", "--json"])
  asyncio.run(tools.specMove("${project}", "lend-a-book", "loans", "domain", ctx = yes))
  expect(runner.calls.last[0] == ["nuclear-builder", "spec", "move", "lend-a-book", "--component", "loans", "--layer", "domain", "--json"])
  asyncio.run(tools.lineSet("${project}", { "budgetUsd": 3 }, ctx = yes))
  expect(runner.calls.last[0] == ["nuclear-builder", "line", "set", "budgetUsd=3", "--json"])
  asyncio.run(tools.skillsCreate("dev", "---\nname: house-style\n---\nShort functions.\n", ctx = yes))
  expect(runner.calls.last[0] == ["nuclear-builder", "skills", "create", "--team", "dev", "--json"] and "${runner.calls.last[2]}".startsWith("---"))
  // the member's whole card: its GIF habit, its note and the team's model
  asyncio.run(tools.memberEdit("dev", "dev-1", gifs = "often", note = "Prefers Kanban", teamBrain = true, ctx = yes))
  expect(runner.calls.last[0] == ["nuclear-builder", "team", "member", "update", "dev", "dev-1", "--gifs", "often", "--note", "Prefers Kanban", "--team-brain", "--json"])
  // what only reads is never asked
  asked = yes.session.asked.length
  asyncio.run(tools.runs("${project}"))
  asyncio.run(tools.metrics("bill", by = "week"))
  asyncio.run(tools.modelsList("claude-code"))
  expect(yes.session.asked.length == asked and runner.calls.slice(-3).map((c) => c[0]) == [["nuclear-builder", "runs", "--json"], ["nuclear-builder", "metrics", "--view", "bill", "--by", "week", "--json"], ["nuclear-builder", "models", "--provider", "claude-code", "--json"]])
  // a client that cannot ask: a preview, nothing run
  calls = runner.calls.length
  preview = said(asyncio.run(tools.runStop("${project}", "r1")))
  expect(preview["confirm"] != null and runner.calls.length == calls)

// The real `nuclear workspace` (skipped until the installed command has it): create, show, edit and delete.
testTheWorkspaceToolsAgainstTheInstalledCommand(tmpPath: Path) void
  if shutil.which("nuclear") == null
    pytest.skip("no nuclear command")
  probe: Ran = asyncio.run(runCommand(["nuclear", "workspace", "show", "--json"], "${tmpPath}"))
  if not probe.out.trim().startsWith("{")
    pytest.skip("the installed nuclear has no `workspace` command yet")
  tools = WorkTools()
  yes = asking("accept")
  made = said(asyncio.run(tools.workspaceCreate("${tmpPath}/shop", "shop", "A shop", "", yes)))
  expect(Path(tmpPath, "shop", ".workspace", "workspace.nuc").isFile(), Json.encode(made))
  asyncio.run(tools.workspaceEdit("${tmpPath}/shop", "", "The shop", "", yes))
  shown = said(asyncio.run(tools.workspaceShow("${tmpPath}/shop")))
  expect(shown["name"] == "shop" and shown["description"] == "The shop", Json.encode(shown))
  asyncio.run(tools.workspaceDelete("${tmpPath}/shop", false, "", yes))
  expect(not Path(tmpPath, "shop", ".workspace", "workspace.nuc").exists() and Path(tmpPath, "shop").isDir())
