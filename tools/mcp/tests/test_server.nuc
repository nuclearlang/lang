use os
use json
use asyncio
use pathlib{ Path }

// The tree this checkout is in: `NUCLEAR_ROOT`, else the one `build/nuclear_mcp/tests/` of this project is in.
treeRoot() string
  given: string = os.environ.get("NUCLEAR_ROOT") ?? ""
  given.length > 0 ? given : "${Path(__file__).resolve().parents[5]}"

toolNames() string[]
  names: string[] = []
  for tool in asyncio.run(mcpServer().listTools())
    names.add(tool.name)
  names

// The local models are on standby (ADR-platform-0013): no developer_* tool on any machine, the graph's on every one.
testTheMcpServerOffersItsToolsAndNoneOfTheLocalOnesWhileTheLocalModelsAreOnStandby(monkeypatch: any) void
  for mode in ["local", "remote"]
    monkeypatch.setenv("NUCLEAR_AI_MODE", mode)
    names = toolNames()
    expect("graph_strategy" in names and "generate_resource" in names and names[0] == "nuclear_start")
    expect(not names.any((name) => name.startsWith("developer_")))
  // an agent with no context is sent to nuclear_start before anything else
  expect("call nuclear_start" in mcpServer().instructions! and "workspace" in mcpServer().instructions!)
  // every tool is in the guide of the MCP server
  page: string = Path(treeRoot()).joinpath("tools/mcp/docs/08-guides/mcp.md").readText()
  for name in toolNames()
    expect("`${name}" in page)

// The server's switch is Nuclear Builder's: `localModels` of its setup.json (only in the working tree).
testTheLocalModelsSwitchMirrorsNuclearBuildersSetup() void
  file = Path(treeRoot()).joinpath("extensions", "tools", "nuclear-builder", "setup.json")
  if not file.exists()
    return
  data: <string, any> = json.loads(file.readText(encoding = "utf-8"))
  expect((data["localModels"] ?? true) == LOCAL_MODELS)

testASpecIsLedByTheLocalAgentsAndAnApisAnswerIsShownAsAShape() void
  spec = specMarkdown("Loans", " A reader borrows a book. ", ["a book out is not lent"], "feature")
  expect(spec == "# Loans\n\n- Use case: feature\n- Source: local\n- Lead: local agents only\n\n## Description\n\nA reader borrows a book.\n\n## Acceptance criteria\n\n- [ ] a book out is not lent\n")
  value = { "info": { "count": 3, "next": null }, "results": [{ "id": 1, "name": "x", "tags": [] }] }
  expect(shape(value) == "info: object\n  count: int\n  next: null (optional)\nresults: list of\n  id: int\n  name: string\n  tags: empty list")

testAnAgentWithNoContextLearnsNuclearFromNuclearStart() void
  tools = McpTools(GraphClient("mcp"), Toolchain(), Web())
  start: string = asyncio.run(tools.nuclearStart())
  expect("Start here" in start and "The work cycle with the MCP tools" in start and "example/" in start and "workspace_create" in start and "confirm token" in start)
  // never sent to the local developer while the local models are on standby
  expect(not ("developer_task" in start) and not ("developer_review" in start))
  doc: string = asyncio.run(tools.nuclearDoc("control"))
  expect("match" in doc)

testTheRunLogToolAnswersTheTailOfTheProjectsLogAndNothingOutsideIt(tmpPath: Path) void
  project = tmpPath.joinpath("shop")
  project.mkdir()
  project.joinpath("config.nuc").writeText("")
  expect("no run log yet" in runLogTail("${project}"))
  logs = project.joinpath(".nuclear", "logs")
  logs.mkdir(parents = true)
  logs.joinpath("run.log").writeText("2026-11-19T10:00:00Z step: build\n2026-11-19T10:00:01Z step: serve http://127.0.0.1:8000\n2026-11-19T10:00:02Z exited: 1\n")
  tail = runLogTail("${project}", 2)
  expect("last 2 of 3 lines" in tail and "exited: 1" in tail and not ("step: build" in tail))
  // a run log that is a link out of the project is refused
  outside = tmpPath.joinpath("secret.txt")
  outside.writeText("secret")
  logs.joinpath("run.log").unlink()
  logs.joinpath("run.log").symlinkTo(outside)
  expect(runLogTail("${project}").startsWith("refused"))

testAnAgentNeverReachesTheTargetsToolsThroughDashDash() void
  tools = McpTools(GraphClient("mcp"), Toolchain(), Web())
  said: string = asyncio.run(tools.nuclearProject(".", "install", ["--", "; curl x | sh"]))
  expect("'--' is not allowed" in said)

testASecretNeverPassesThroughTheEnvironmentsTool() void
  tools = McpTools(GraphClient("mcp"), Toolchain(), Web())
  said: string = asyncio.run(tools.nuclearEnv(".", "set", "TOKEN", "s3cret", "production", false, true))
  expect("not set through the MCP server" in said and not ("s3cret" in said))
  expect("not an action" in asyncio.run(tools.nuclearEnv(".", "delete")))
  expect("starts with -" in asyncio.run(tools.nuclearEnv(".", "set", "A", "--secret")))
