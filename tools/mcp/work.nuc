use sys
use json
use shutil
use codecs
use asyncio
use secrets
use pathlib{ Path }
use mcp/server/mcpserver{ Context }

// What an agent organizes in the user's name (spec 022): the workspaces and their apps (`nuclear workspace … --json`),
// the specs Nuclear Builder reads (`nuclear-builder spec … --json`) and the teams of the software factory
// (`nuclear-builder team …`). Every tool here is a thin call of one of those commands, and every one that changes
// something asks the user's yes first (`confirmed`).

APP_PLATFORMS = ["mobile", "web", "backend"]
// How long a preview's token is valid (milliseconds); it is used once.
CONFIRM_MS = 300000
// The previews waiting for the user's yes, kept in the server's process only: token → {key, until}.
PENDING: <string, <string, any>> = {}
// What a client that can ask its user (MCP elicitation) shows: one yes or no.
YES_SCHEMA: <string, any> = { "type": "object", "properties": { "confirm": { "type": "boolean", "title": "Yes, do it", "default": true } }, "required": ["confirm"] }

// The closest folder up with a config.nuc (a Synapsis project).
projectOf(folder: string) Path?
  start: Path = Path(folder).resolve()
  for d in [start, ...start.parents]
    if d.joinpath("config.nuc").exists()
      return d
  null

// Runs a command with `stdin` on its standard input and waits for it, at most `timeout` seconds: its exit code and
// what it printed (its standard output; its errors when it printed nothing else).
runCommand(args: string[], cwd: string? = null, stdin: string = "", timeout: int = 600) Ran
  if shutil.which(args[0]) == null
    return Ran(127, "${args[0]} is not installed (run the NuclearLang installer)")
  p = ~asyncio.createSubprocessExec(...args, cwd = cwd, stdin = asyncio.subprocess.PIPE, stdout = asyncio.subprocess.PIPE, stderr = asyncio.subprocess.PIPE)
  try
    done = ~asyncio.waitFor(p.communicate(stdin.toBytes()), timeout)
    out = codecs.decode(done[0], "utf-8", "replace")
    Ran(p.returncode ?? 0, out.trim().isEmpty ? codecs.decode(done[1], "utf-8", "replace") : out)
  catch e
    if not isinstance(e, TimeoutError)
      throw e
    p.kill()
    Ran(124, "${args.join(" ")}: timed out after ${timeout} s")

// A command's answer for the agent: its JSON as it printed it, or {"error"} when it failed without one.
answerOf(ran: Ran) string
  out = ran.out.trim()
  if ran.code == 0 and not out.isEmpty
    return out
  if out.startsWith("{") or out.startsWith("[")
    return out
  Json.encode({ "error": out.isEmpty ? "exited ${ran.code}" : out })

// An error answer.
refused(text: string) string
  Json.encode({ "error": text })

// The first word that would be read as an option of the command (it starts with -), or null.
optionLike(words: string[]) string?
  words.find((w) => w.startsWith("-"))

// The key a token is bound to: the tool and its exact arguments.
changeKey(tool: string, args: <string, any>) string
  "${tool} ${Json.encode(args)}"

// Whether the client said it can ask its user (the `elicitation` capability).
canAsk(ctx: Context?) boolean
  if ctx == null
    return false
  try
    caps = ctx!.session.clientCapabilities
    // a client of the newer protocol reached in its own process has no channel back for the question
    return caps != null and caps.elicitation != null and ctx!.session.canSendRequest
  catch e
    // outside a request there is no session
    return false

// The user's yes to a change, asked before it is made: null when the user said yes (the tool goes on), else what the
// tool answers instead, having changed nothing. `change` says exactly what will change. A client that can ask
// (elicitation) asks its user yes or no; one that cannot gets a preview with a `confirm` token, bound to this tool and
// these arguments, valid 5 minutes and once: calling the tool again with it is the user's yes.
confirmed(ctx: Context?, tool: string, args: <string, any>, change: string, confirm: string) string?
  now = DateTime.now().millis
  for token in PENDING.keys
    if (PENDING[token]!["until"] as int) < now
      PENDING.remove(token)
  key = changeKey(tool, args)
  if not confirm.isEmpty
    held = PENDING.remove(confirm)
    if held == null
      return refused("nothing changed: the confirm token is unknown, expired or used; call ${tool} again without confirm for a new preview")
    if "${held!["key"]}" != key
      return refused("nothing changed: the confirm token is for another change (another tool or other arguments); call ${tool} again without confirm for a preview of this one")
    return null
  if canAsk(ctx)
    try
      answer = ~ctx!.session.elicitForm(message = "${change}\n\nDo it?", requestedSchema = YES_SCHEMA, relatedRequestId = ctx!.requestId)
      content: <string, any> = answer.content ?? ({} as <string, any>)
      if answer.action == "accept" and content["confirm"] == true
        return null
      return Json.encode({ "declined": change, "changed": "nothing: the user said no" })
    catch e
      // the client said it can ask but the question failed: the preview instead
      print("elicitation failed: ${e}", file = sys.stderr)
  token = secrets.tokenUrlsafe(12)
  PENDING[token] = { "key": key, "until": now + CONFIRM_MS }
  Json.encode({ "preview": change, "changed": "nothing yet", "confirm": token, "expiresInSeconds": CONFIRM_MS ~/ 1000, "next": "show this preview to the user; only on their yes, call ${tool} again with the same arguments and confirm=\"${token}\" (valid once, for 5 minutes)" })

// The tools that organize the user's work (spec 022): workspaces and apps, specs, teams and members. `runner` runs a
// command (`runCommand`; a test gives its own). Each method with a comment is a tool, and the comment is what the
// client reads of it; every change is confirmed by the user (elicitation, or a preview and its confirm token).
WorkTools(runner: any = runCommand)
  // `nuclear workspace <args> --json` in a folder of the workspace.
  workspaceRun(args: string[], folder: string? = null) string
    ran: Ran = ~runner(["nuclear", "workspace", ...args, "--json"], folder, "")
    answerOf(ran)

  // `nuclear-builder <args>` in a folder (a project), with `stdin`.
  builderRun(args: string[], folder: string? = null, stdin: string = "") string
    ran: Ran = ~runner(["nuclear-builder", ...args], folder, stdin)
    answerOf(ran)

  // ---------- the database of a backend project ----------

  // The migrations of a backend project's database (`nuclear migrate`: the same in every backend dialect and
  // database). action: status (every migration, applied or pending: read it first), make (message: what changed;
  // writes one migration, the entities minus the last migration, into the project's migrations/; it warns of every
  // drop and of a required column without a default: tell the user), up (applies the pending ones; to: up to that
  // migration), down (reverts the last one applied; to: back to that migration). fake (up, down): only the history
  // changes and nothing runs (a database that already has its tables is brought under the migrations with up and
  // fake). transaction (up, down): all (the default: the whole run in one transaction), each (one per migration)
  // or none. project: the project's folder or one inside it. make, up and down ask the user first (confirm: the token of a preview, when the client cannot
  // ask): up and down change the database of the project's active environment, and down drops what the migration
  // made, with its data. Build the project first (nuclear_build): the migration reads the built entities.
  projectMigrate(project: string, action: string = "status", message: string = "", to: string = "", confirm: string = "", fake: boolean = false, transaction: string = "", ctx: Context? = null) string
    root = projectOf(project)
    if root == null
      return refused("${project} is not inside a Synapsis project (no config.nuc)")
    if not (action in ["status", "make", "up", "down"])
      return refused("'${action}' is not an action of project_migrate (status, make, up, down)")
    bad = optionLike([message, to])
    if bad != null
      return refused("'${bad}' is not a message or a migration (it starts with -)")
    if action == "make" and message.trim().isEmpty
      return refused("make needs message: what changed in the entities (\"notes on tasks\")")
    if action != "make" and not message.isEmpty
      return refused("message is for make only")
    if not to.isEmpty and not (action in ["up", "down"])
      return refused("to is for up and down only")
    if (fake or not transaction.isEmpty) and not (action in ["up", "down"])
      return refused("fake and transaction are for up and down only")
    if not (transaction in ["", "all", "each", "none"])
      return refused("'${transaction}' is not a transaction of project_migrate (all, each, none)")
    args = ["nuclear", "migrate", action]
    if action == "make"
      args = [...args, message]
    if not to.isEmpty
      args = [...args, "--to", to]
    if fake
      args = [...args, "--fake"]
    if not transaction.isEmpty
      args = [...args, "--transaction", transaction]
    if action != "status"
      change = match action
        "make" -> "Write one migration of ${root} for \"${message}\" into its migrations/ folder (the entities minus the last migration). The database is not changed."
        "up" -> fake ? "Mark the pending migrations of ${root} as applied in the database of its active environment${to.isEmpty ? "" : ", up to ${to}"}, without running them: the schema is not changed." : "Apply the pending migrations of ${root} to the database of its active environment${to.isEmpty ? "" : ", up to ${to}"}."
        _ -> fake ? "Mark ${to.isEmpty ? "the last migration applied" : "the migrations applied after ${to}"} as not applied in the database of ${root}'s active environment, without running anything: the schema is not changed." : "Revert ${to.isEmpty ? "the last migration applied" : "the migrations applied after ${to}"} in the database of ${root}'s active environment: what they made is dropped, with its data."
      no = ~confirmed(ctx, "project_migrate", { "project": "${root}", "action": action, "message": message, "to": to, "fake": fake, "transaction": transaction }, change, confirm)
      if no != null
        return no!
    ran: Ran = ~runner(args, "${root}", "")
    // the command's own text (no JSON): what it applied, reverted or refused, as the user would read it
    Json.encode({ "ok": ran.code == 0, "action": action, "output": ran.out.trim() })

  // The tests of a Synapsis project, written in Nuclear (`test/*_test.nuc`): builds the project and runs them with
  // its dialect's runner (`nuclear test`). The answer is the same whatever the dialect: {ok, passed, failed,
  // failures: [{file, line, name}] (where each failure is in the `.nuc`), hint (what a failed `expect` or an error
  // means), output (the runner's last lines)}. project: the project's folder or one inside it. Run it after every
  // change, and before saying a task is done; it changes nothing but the project's build/ (a backend's tests use
  // an in-memory database, empty in each test). A project not installed yet answers what to run (nuclear_project
  // with install).
  projectTest(project: string) string
    root = projectOf(project)
    if root == null
      return refused("${project} is not inside a Synapsis project (no config.nuc)")
    ran: Ran = ~runner(["nuclear", "test"], "${root}", "")
    counts = countsOfTests(ran.out)
    failures: any[] = []
    hint = ""
    if ran.code != 0
      // where the runner's failure is in the Nuclear, and what it means
      explained: Ran = ~runner(["nuclear", "explain", "--json"], "${root}", ran.out)
      found = jsonOf(explained.out)
      if found != null
        frames: any[] = found!["frames"] ?? []
        failures = frames.map((f) => { "file": "${f["source"]}", "line": f["line"], "name": "${f["name"]}" })
        hint = "${found!["hint"] ?? ""}"
    out = ran.out.trim()
    Json.encode({
      "ok": ran.code == 0,
      "passed": counts[0],
      "failed": counts[1],
      "failures": failures,
      "hint": hint,
      "output": out.substring(Math.max(0, out.length - 4000)),
    })

  // ---------- workspaces and apps ----------

  // Create a workspace: a folder that organizes one business project and the apps that form it, recognized by its
  // marker `.workspace/workspace.nuc` (the editor, this server and the agents start from it). path: where (the folder
  // is made); name (default: the folder's name) and description. Start every new product here, then app_add its apps.
  // Asks the user first (confirm: the token of a preview, when the client cannot ask).
  workspaceCreate(path: string, name: string = "", description: string = "", confirm: string = "", ctx: Context? = null) string
    bad = optionLike([path, name, description])
    if bad != null
      return refused("'${bad}' is not a path, a name or a description (it starts with -)")
    target = Path(path).expanduser().resolve()
    shown = name.isEmpty ? target.name : name
    change = "Create the workspace `${shown}` in ${target}: the folder and its marker .workspace/workspace.nuc, which names the apps added to it."
    no = ~confirmed(ctx, "workspace_create", { "path": "${target}", "name": name, "description": description }, change, confirm)
    if no != null
      return no!
    args = ["new", "${target}"]
    if not name.isEmpty
      args = [...args, "--name", name]
    if not description.isEmpty
      args = [...args, "--description", description]
    ~workspaceRun(args)

  // A workspace and its apps: {root, name, description, apps: [{name, folder, platform, dialect, exists}]}. workspace:
  // its folder or any folder inside it. Read it first: the apps are the projects to work in.
  workspaceShow(workspace: string) string
    if not Path(workspace).isDir()
      return refused("${workspace} is not a folder")
    ~workspaceRun(["show"], workspace)

  // Rename a workspace or change its description (its marker). workspace: its folder or one inside it. Asks the user
  // first (confirm: the token of a preview, when the client cannot ask).
  workspaceEdit(workspace: string, name: string = "", description: string = "", confirm: string = "", ctx: Context? = null) string
    if not Path(workspace).isDir()
      return refused("${workspace} is not a folder")
    if name.isEmpty and description.isEmpty
      return refused("say what changes: name, description or both")
    bad = optionLike([name, description])
    if bad != null
      return refused("'${bad}' is not a name or a description (it starts with -)")
    parts: string[] = []
    if not name.isEmpty
      parts.add("its name becomes `${name}`")
    if not description.isEmpty
      parts.add("its description becomes \"${description}\"")
    change = "Change the workspace of ${Path(workspace).resolve()}: ${parts.join(" and ")} (its marker .workspace/workspace.nuc)."
    no = ~confirmed(ctx, "workspace_edit", { "workspace": "${Path(workspace).resolve()}", "name": name, "description": description }, change, confirm)
    if no != null
      return no!
    args = ["edit"]
    if not name.isEmpty
      args = [...args, "--name", name]
    if not description.isEmpty
      args = [...args, "--description", description]
    ~workspaceRun(args, workspace)

  // Stop a folder being a workspace: its marker `.workspace/workspace.nuc` is removed; its apps' folders stay unless
  // delete_folders is true (then every app's folder is deleted, with all its files: only when the user asked for
  // it). Asks the user first, saying which (confirm: the token of a preview, when the client cannot ask).
  workspaceDelete(workspace: string, deleteFolders: boolean = false, confirm: string = "", ctx: Context? = null) string
    if not Path(workspace).isDir()
      return refused("${workspace} is not a folder")
    said = ~workspaceRun(["show"], workspace)
    shown = jsonOf(said)
    if shown == null or shown!["root"] == null
      return said
    root = "${shown!["root"]}"
    apps = ((shown!["apps"] ?? []) as <string, any>[]).map((a) => "${a["name"]}")
    named = apps.isEmpty ? "no apps" : "${apps.length} app(s): ${apps.join(", ")}"
    change = deleteFolders ? "Delete the workspace `${shown!["name"]}` (${root}): its marker .workspace/workspace.nuc AND the folders of its ${named}, with every file in them. This cannot be undone." : "Remove the workspace `${shown!["name"]}` (${root}): only its marker .workspace/workspace.nuc; the folders of its ${named} stay as they are."
    no = ~confirmed(ctx, "workspace_delete", { "workspace": root, "deleteFolders": deleteFolders }, change, confirm)
    if no != null
      return no!
    if deleteFolders
      for app in apps
        gone = jsonOf(~workspaceRun(["remove", app, "--delete"], root))
        if gone == null or gone!["error"] != null
          return refused("the app ${app} was not removed (${gone == null ? "no answer" : gone!["error"]}); the workspace's marker is kept")
    // shortcut: the marker is removed here because `nuclear workspace` has no `delete` yet; call it when it does
    marker = Path(root, ".workspace", "workspace.nuc")
    if marker.isFile()
      marker.unlink()
    held = Path(root, ".workspace")
    if held.isDir() and (list(held.iterdir()) as Path[]).isEmpty
      held.rmdir()
    Json.encode({ "deleted": root, "apps": apps, "foldersDeleted": deleteFolders })

  // Add an app to a workspace: `nuclear new` makes it in a folder of the workspace and the marker names it. app: its
  // name (its folder); platform: mobile, web or backend; dialect: optional (the platform's default). Asks the user
  // first (confirm: the token of a preview, when the client cannot ask).
  appAdd(workspace: string, app: string, platform: string, dialect: string = "", confirm: string = "", ctx: Context? = null) string
    if not Path(workspace).isDir()
      return refused("${workspace} is not a folder")
    if not (platform in APP_PLATFORMS)
      return refused("'${platform}' is not a platform: ${APP_PLATFORMS.join(", ")}")
    bad = optionLike([app, dialect])
    if bad != null or app.isEmpty
      return refused("'${bad ?? app}' is not an app's name or a dialect")
    made = dialect.isEmpty ? platform : "${platform}, ${dialect}"
    change = "Add the app `${app}` (${made}) to the workspace of ${Path(workspace).resolve()}: nuclear new makes its folder ${app}/ and the marker names it."
    no = ~confirmed(ctx, "app_add", { "workspace": "${Path(workspace).resolve()}", "app": app, "platform": platform, "dialect": dialect }, change, confirm)
    if no != null
      return no!
    args = ["add", app, "--platform", platform]
    if not dialect.isEmpty
      args = [...args, "--dialect", dialect]
    ~workspaceRun(args, workspace)

  // Rename an app of a workspace (new_name: its new name). Asks the user first (confirm: the token of a preview,
  // when the client cannot ask).
  appRename(workspace: string, app: string, newName: string, confirm: string = "", ctx: Context? = null) string
    if not Path(workspace).isDir()
      return refused("${workspace} is not a folder")
    bad = optionLike([app, newName])
    if bad != null or app.isEmpty or newName.isEmpty
      return refused("an app and its new name are needed (neither starts with -)")
    change = "Rename the app `${app}` of the workspace of ${Path(workspace).resolve()} to `${newName}`."
    no = ~confirmed(ctx, "app_rename", { "workspace": "${Path(workspace).resolve()}", "app": app, "newName": newName }, change, confirm)
    if no != null
      return no!
    ~workspaceRun(["rename", app, newName], workspace)

  // Remove an app from a workspace (the marker stops naming it); its folder is deleted only with delete_folder true
  // (every file in it: only when the user asked for it). Asks the user first, saying which (confirm: the token of a
  // preview, when the client cannot ask).
  appRemove(workspace: string, app: string, deleteFolder: boolean = false, confirm: string = "", ctx: Context? = null) string
    if not Path(workspace).isDir()
      return refused("${workspace} is not a folder")
    bad = optionLike([app])
    if bad != null or app.isEmpty
      return refused("'${app}' is not an app's name")
    where = Path(workspace).resolve()
    change = deleteFolder ? "Remove the app `${app}` from the workspace of ${where} AND delete its folder with every file in it. This cannot be undone." : "Remove the app `${app}` from the workspace of ${where} (the marker stops naming it); its folder stays as it is."
    no = ~confirmed(ctx, "app_remove", { "workspace": "${where}", "app": app, "deleteFolder": deleteFolder }, change, confirm)
    if no != null
      return no!
    ~workspaceRun(deleteFolder ? ["remove", app, "--delete"] : ["remove", app], workspace)

  // ---------- specs (Nuclear Builder reads them: specs/<component>/[<layer>/]<id>/spec.md) ----------

  // Write a new spec of a project where Nuclear Builder reads it (it shows in the Builder at once): its title, its
  // business component (a folder of components/, or _global for the whole project), its acceptance criteria (each
  // one checkable: ask the user for them when they are not given), and optionally its layer (presentation, domain or
  // data), its use case (feature, refactor, bug, test, security, docs, diagram) and its description; or text: the
  // spec's whole markdown, from its `# title`. language: the language the project's specs are written in (en, es...):
  // the first spec of a project asks the user for it (offer the editor's language, else the one they write in) and it
  // is kept; later specs leave it empty. Asks the user first (confirm: the token of a preview, when the client cannot ask).
  specCreate(project: string, component: string, title: string, criteria: string[]? = null, layer: string = "", useCase: string = "feature", description: string = "", text: string = "", language: string = "", confirm: string = "", ctx: Context? = null) string
    root = projectOf(project)
    if root == null
      return refused("${project} is not inside a Synapsis project (no config.nuc)")
    kept = (criteria ?? []).map((c: string) => c.trim()).filter((c: string) => not c.isEmpty)
    if kept.isEmpty and text.trim().isEmpty
      return refused("a spec needs its acceptance criteria (each one checkable): ask the user for them")
    bad = optionLike([component, title, layer, useCase, language])
    if bad != null or title.trim().isEmpty or component.trim().isEmpty
      return refused("a spec needs a title and a component (neither starts with -)")
    if [description, ...kept].any((w) => w.startsWith("--"))
      return refused("a description or a criterion never starts with --")
    folder = layer.isEmpty ? "specs/${component}/<id>" : "specs/${component}/${layer}/<id>"
    items = kept.isEmpty ? "the criteria of its text" : kept.map((c) => "- ${c}").join("\n")
    change = "Write the spec \"${title}\" (${useCase}) in the project ${root}: ${folder}/spec.md, shown in Nuclear Builder at once. Its acceptance criteria:\n${items}"
    no = ~confirmed(ctx, "spec_create", { "project": "${root}", "component": component, "title": title, "criteria": kept, "layer": layer, "useCase": useCase, "description": description, "text": text, "language": language }, change, confirm)
    if no != null
      return no!
    args = ["spec", "new", "--title", title, "--component", component, "--use-case", useCase]
    if not layer.isEmpty
      args = [...args, "--layer", layer]
    if not description.isEmpty
      args = [...args, "--description", description]
    for c in kept
      args = [...args, "--criteria", c]
    if not language.trim().isEmpty
      args = [...args, "--language", language.trim()]
    if not text.trim().isEmpty
      args.add("--stdin")
    ~builderRun([...args, "--json"], "${root}", text)

  // The specs of a project, by component and layer, with their runs.
  specList(project: string) string
    root = projectOf(project)
    if root == null
      return refused("${project} is not inside a Synapsis project (no config.nuc)")
    ~builderRun(["spec", "list", "--json"], "${root}")

  // One spec of a project: its markdown, what it says (title, criteria...), its draft when it has one, its run's status.
  specShow(project: string, id: string) string
    root = projectOf(project)
    if root == null
      return refused("${project} is not inside a Synapsis project (no config.nuc)")
    if id.startsWith("-")
      return refused("'${id}' is not a spec's id")
    ~builderRun(["spec", "show", id, "--json"], "${root}")

  // Replace the text of a spec (its whole markdown, from its `# title`; spec_show gives the current one). Asks the
  // user first (confirm: the token of a preview, when the client cannot ask).
  specEdit(project: string, id: string, text: string, confirm: string = "", ctx: Context? = null) string
    root = projectOf(project)
    if root == null
      return refused("${project} is not inside a Synapsis project (no config.nuc)")
    if id.startsWith("-") or id.isEmpty
      return refused("'${id}' is not a spec's id")
    if not text.trim().startsWith("# ")
      return refused("a spec's text is its whole markdown, from its `# title`")
    said = ~builderRun(["spec", "show", id, "--json"], "${root}")
    shown = jsonOf(said)
    if shown == null or shown!["path"] == null
      return said
    title = text.trim().split("\n")[0].substring(2)
    change = "Replace the text of the spec `${id}` (${shown!["path"]}/spec.md in ${root}) with the new one (${text.trim().split("\n").length} lines, titled \"${title}\")."
    no = ~confirmed(ctx, "spec_edit", { "project": "${root}", "id": id, "text": text }, change, confirm)
    if no != null
      return no!
    ~builderRun(["spec", "update", id, "--stdin", "--json"], "${root}", text)

  // ---------- teams of the software factory (Nuclear Builder) ----------

  // The teams: id, name, members, the default one.
  teamList() string
    ~builderRun(["team", "list", "--json"])

  // One team: its members (each its id, role, employee, who works it), purpose, skills, tech lead, budget.
  teamShow(team: string) string
    if team.startsWith("-") or team.isEmpty
      return refused("'${team}' is not a team's id")
    ~builderRun(["team", "show", team])

  // Create a team: its name, purpose, description, skills (library ids), budget_usd and members: a list of {role
  // (analyst, architect, developer, qa, devops), employee, kind (agent or api), provider, model, name}; who works a
  // member not said: the team's model (kind agent or api, provider, model: who works every member without its own),
  // else the default external agent. method is how the team works (empty: Scrum), instructions what every member
  // follows. Members are never of the local kind (the local models are on standby). Asks the user first (confirm:
  // the token of a preview, when the client cannot ask).
  teamCreate(name: string, purpose: string = "", description: string = "", skills: string[]? = null, members: <string, any>[]? = null, budgetUsd: double? = null, method: string = "", instructions: string = "", kind: string = "", provider: string = "", model: string = "", confirm: string = "", ctx: Context? = null) string
    if name.trim().isEmpty
      return refused("a team needs a name")
    hired: <string, any>[] = members ?? []
    if kind == "local" or hired.any((m) => m["kind"] == "local")
      return refused(LOCAL_STANDBY)
    draft: <string, any> = { "name": name, "purpose": purpose, "description": description, "skills": skills ?? [], "members": hired, "method": method, "instructions": instructions }
    if budgetUsd != null
      draft["budgetUsd"] = budgetUsd
    if not kind.isEmpty or not provider.isEmpty
      brain: <string, any> = { "model": model }
      if not kind.isEmpty
        brain["kind"] = kind
      if not provider.isEmpty
        brain["provider"] = provider
      draft["brain"] = brain
    who = hired.map((m) => "${m["role"]}${m["name"] != null ? " ${m["name"]}" : ""}${m["provider"] != null ? " (${m["provider"]}${m["model"] != null ? " ${m["model"]}" : ""})" : ""}")
    brainSaid = draft["brain"] == null ? "" : "; every member worked by ${provider.isEmpty ? kind : provider}${model.isEmpty ? "" : " ${model}"} unless it has its own"
    change = "Create the team `${name}` with ${hired.length} member(s)${who.isEmpty ? "" : ": ${who.join(", ")}"}${budgetUsd != null ? "; budget ${budgetUsd} USD" : ""}${method.isEmpty ? "" : "; method: ${method}"}${instructions.isEmpty ? "" : "; instructions: ${instructions}"}${brainSaid}."
    no = ~confirmed(ctx, "team_create", draft, change, confirm)
    if no != null
      return no!
    ~builderRun(["team", "create", "--json"], null, Json.encode(draft))

  // Change a team: its name, description, purpose, skills (library ids, the whole list), lead (a member's id: the tech
  // lead), budget_usd, method (how it works; empty: Scrum stays), instructions (what every member follows) or the
  // team's model (kind agent or api, provider, model: it works every member from then on; a member's own set after
  // it wins). Asks the user first (confirm: the token of a preview, when the client cannot ask).
  teamEdit(team: string, name: string = "", description: string = "", purpose: string = "", skills: string[]? = null, lead: string = "", budgetUsd: double? = null, method: string = "", instructions: string = "", kind: string = "", provider: string = "", model: string = "", confirm: string = "", ctx: Context? = null) string
    if kind == "local"
      return refused(LOCAL_STANDBY)
    flags: <string, string> = { "--name": name, "--description": description, "--purpose": purpose, "--lead": lead, "--method": method, "--instructions": instructions, "--kind": kind, "--provider": provider, "--model": model }
    if skills != null
      flags["--skills"] = skills!.join(",")
    if budgetUsd != null
      flags["--budget"] = "${budgetUsd}"
    given = flags.keys.filter((k) => not flags[k]!.isEmpty or k == "--skills")
    if team.startsWith("-") or team.isEmpty
      return refused("'${team}' is not a team's id")
    if given.isEmpty
      return refused("say what changes: name, description, purpose, skills, lead, budget_usd, method, instructions, kind, provider or model")
    bad = optionLike(given.map((k) => flags[k]!))
    if bad != null
      return refused("'${bad}' starts with -")
    change = "Change the team `${team}`: ${given.map((k) => "${k.substring(2)} → ${flags[k]}").join("; ")}."
    no = ~confirmed(ctx, "team_edit", { "team": team, "flags": flags }, change, confirm)
    if no != null
      return no!
    args = ["team", "update", team]
    for k in given
      args = [...args, k, flags[k]!]
    ~builderRun([...args, "--json"])

  // Delete a team (its file is kept as <id>.json.bak). Asks the user first (confirm: the token of a preview, when the
  // client cannot ask).
  teamDelete(team: string, confirm: string = "", ctx: Context? = null) string
    if team.startsWith("-") or team.isEmpty
      return refused("'${team}' is not a team's id")
    no = ~confirmed(ctx, "team_delete", { "team": team }, "Delete the team `${team}` (its file is kept as ${team}.json.bak).", confirm)
    if no != null
      return no!
    ~builderRun(["team", "delete", team, "--json"])

  // Hire members into a team: role (analyst, architect, developer, qa, devops), and optionally employee (of the
  // roster), kind (agent or api), provider, model (one this machine has), name, count. Never the local kind (the
  // local models are on standby). Asks the user first (confirm: the token of a preview, when the client cannot ask).
  memberAdd(team: string, role: string, employee: string = "", kind: string = "", provider: string = "", model: string = "", name: string = "", count: int = 1, confirm: string = "", ctx: Context? = null) string
    if kind == "local"
      return refused(LOCAL_STANDBY)
    flags: <string, string> = { "--role": role, "--employee": employee, "--kind": kind, "--provider": provider, "--model": model, "--name": name }
    given = flags.keys.filter((k) => not flags[k]!.isEmpty)
    bad = optionLike([team, ...given.map((k) => flags[k]!)])
    if bad != null or team.isEmpty or role.isEmpty
      return refused("a team and a role are needed (no value starts with -)")
    who = provider.isEmpty ? "the default agent" : "${provider}${model.isEmpty ? "" : " ${model}"}"
    named = name.isEmpty ? "" : " named ${name}"
    change = "Hire ${count} ${role}${named} into the team `${team}`, worked by ${who}."
    no = ~confirmed(ctx, "member_add", { "team": team, "flags": flags, "count": count }, change, confirm)
    if no != null
      return no!
    args = ["team", "member", "add", team]
    for k in given
      args = [...args, k, flags[k]!]
    ~builderRun([...args, "--count", "${Math.max(1, count)}", "--json"])

  // Change a member of a team (member: its id in the team), as its card in the editor does: who works it (kind agent
  // or api, provider, model; team_brain true: the team's model instead), its employee, name, instructions,
  // temperament, skills (the whole list), extra_skills (its own skills, a list of objects), gifs (its GIF habit:
  // never, sometimes, often), note, agent (a library agent it is based on). Never the local kind (the local models are
  // on standby). Asks the user first (confirm: the token of a preview, when the client cannot ask).
  memberEdit(team: string, member: string, kind: string = "", provider: string = "", model: string = "", employee: string = "", name: string = "", instructions: string = "", temperament: string = "", skills: string[]? = null, extraSkills: <string, any>[]? = null, gifs: string = "", note: string = "", agent: string = "", teamBrain: boolean = false, confirm: string = "", ctx: Context? = null) string
    if kind == "local"
      return refused(LOCAL_STANDBY)
    flags: <string, string> = { "--kind": kind, "--provider": provider, "--model": model, "--employee": employee, "--name": name, "--instructions": instructions, "--temperament": temperament, "--gifs": gifs, "--note": note, "--agent": agent }
    if skills != null
      flags["--skills"] = skills!.join(",")
    if extraSkills != null
      flags["--extra-skills"] = Json.encode(extraSkills)
    given = flags.keys.filter((k) => not flags[k]!.isEmpty or k == "--skills")
    bad = optionLike([team, member, ...given.map((k) => flags[k]!)])
    if bad != null or team.isEmpty or member.isEmpty
      return refused("a team and a member are needed (no value starts with -)")
    if given.isEmpty and not teamBrain
      return refused("say what changes of the member")
    said = given.map((k) => "${k.substring(2)} → ${flags[k]}")
    if teamBrain
      said.add("worked by the team's model")
    change = "Change the member `${member}` of the team `${team}`: ${said.join("; ")}."
    no = ~confirmed(ctx, "member_edit", { "team": team, "member": member, "flags": flags, "teamBrain": teamBrain }, change, confirm)
    if no != null
      return no!
    args = ["team", "member", "update", team, member]
    for k in given
      args = [...args, k, flags[k]!]
    if teamBrain
      args.add("--team-brain")
    ~builderRun([...args, "--json"])

  // Let a member go (member: its id in the team). Asks the user first (confirm: the token of a preview, when the
  // client cannot ask).
  memberRemove(team: string, member: string, confirm: string = "", ctx: Context? = null) string
    bad = optionLike([team, member])
    if bad != null or team.isEmpty or member.isEmpty
      return refused("a team and a member are needed (neither starts with -)")
    no = ~confirmed(ctx, "member_remove", { "team": team, "member": member }, "Remove the member `${member}` from the team `${team}`.", confirm)
    if no != null
      return no!
    ~builderRun(["team", "member", "remove", team, member, "--json"])

  // Set the library skills of a team (every member inherits them) or, with member, of one member: skills is the whole
  // list of skill ids (Nuclear Builder's `skills list` names them). Asks the user first (confirm: the token of a
  // preview, when the client cannot ask).
  skillsSet(team: string, skills: string[], member: string = "", confirm: string = "", ctx: Context? = null) string
    bad = optionLike([team, member, ...skills])
    if bad != null or team.isEmpty
      return refused("a team is needed (no value starts with -)")
    whose = member.isEmpty ? "the team `${team}` (every member inherits them)" : "the member `${member}` of the team `${team}`"
    change = "Set the skills of ${whose} to: ${skills.isEmpty ? "none" : skills.join(", ")}."
    no = ~confirmed(ctx, "skills_set", { "team": team, "skills": skills, "member": member }, change, confirm)
    if no != null
      return no!
    args = ["team", "skills", "set", team, "--skills", skills.join(",")]
    if not member.isEmpty
      args = [...args, "--member", member]
    ~builderRun([...args, "--json"])

  // ---------- what follows reaches the rest of Nuclear Builder: what the editor's Builder page and company screen do ----------

  // A change of Nuclear Builder asked first: `nuclear-builder <args>` in `folder` only on the user's yes.
  builderChange(ctx: Context?, tool: string, key: <string, any>, change: string, confirm: string, args: string[], folder: string? = null, stdin: string = "") string
    no = ~confirmed(ctx, tool, key, change, confirm)
    if no != null
      return no!
    ~builderRun(args, folder, stdin)

  // ---------- more of the specs ----------

  // Move a spec to another business component (and layer: presentation, domain or data); its run follows. Asks the
  // user first (confirm: the token of a preview, when the client cannot ask).
  specMove(project: string, id: string, component: string, layer: string = "", confirm: string = "", ctx: Context? = null) string
    root = projectOf(project)
    if root == null
      return refused("${project} is not inside a Synapsis project (no config.nuc)")
    bad = optionLike([id, component, layer])
    if bad != null or id.isEmpty or component.isEmpty
      return refused("a spec's id and a component are needed (neither starts with -)")
    args = ["spec", "move", id, "--component", component, ...(layer.isEmpty ? [] as string[] : ["--layer", layer]), "--json"]
    ~builderChange(ctx, "spec_move", { "project": "${root}", "id": id, "component": component, "layer": layer }, "Move the spec `${id}` of ${root} to specs/${component}/${layer.isEmpty ? "" : "${layer}/"}${id} (its run follows).", confirm, args, "${root}")

  // Move the specs of the old flat layout (specs/<id>/) to their component. Asks the user first (confirm: the token of
  // a preview, when the client cannot ask).
  specMigrate(project: string, confirm: string = "", ctx: Context? = null) string
    root = projectOf(project)
    if root == null
      return refused("${project} is not inside a Synapsis project (no config.nuc)")
    ~builderChange(ctx, "spec_migrate", { "project": "${root}" }, "Move every spec of the flat specs/<id>/ of ${root} to its component's folder.", confirm, ["spec", "migrate", "--json"], "${root}")

  // Delete a spec: its folder goes to .nuclear/builder/deleted/ (it can be brought back by hand). Asks the user first
  // (confirm: the token of a preview, when the client cannot ask).
  specDelete(project: string, id: string, confirm: string = "", ctx: Context? = null) string
    root = projectOf(project)
    if root == null
      return refused("${project} is not inside a Synapsis project (no config.nuc)")
    if id.startsWith("-") or id.isEmpty
      return refused("'${id}' is not a spec's id")
    ~builderChange(ctx, "spec_delete", { "project": "${root}", "id": id }, "Delete the spec `${id}` of ${root}: its folder goes to .nuclear/builder/deleted/.", confirm, ["spec", "delete", id, "--json"], "${root}")

  // Accept a spec's draft (spec.draft.md, written by a member in Nuclear Chat) over the spec. Asks the user first
  // (confirm: the token of a preview, when the client cannot ask).
  specAccept(project: string, id: string, confirm: string = "", ctx: Context? = null) string
    root = projectOf(project)
    if root == null
      return refused("${project} is not inside a Synapsis project (no config.nuc)")
    if id.startsWith("-") or id.isEmpty
      return refused("'${id}' is not a spec's id")
    ~builderChange(ctx, "spec_accept", { "project": "${root}", "id": id }, "Accept the draft of the spec `${id}` of ${root}: spec.draft.md replaces its spec.md.", confirm, ["spec", "accept", id, "--json"], "${root}")

  // Throw away a spec's draft (spec.draft.md); the spec stays as it is. Asks the user first (confirm: the token of a
  // preview, when the client cannot ask).
  specDiscard(project: string, id: string, confirm: string = "", ctx: Context? = null) string
    root = projectOf(project)
    if root == null
      return refused("${project} is not inside a Synapsis project (no config.nuc)")
    if id.startsWith("-") or id.isEmpty
      return refused("'${id}' is not a spec's id")
    ~builderChange(ctx, "spec_discard", { "project": "${root}", "id": id }, "Throw away the draft of the spec `${id}` of ${root} (spec.draft.md); the spec stays.", confirm, ["spec", "discard", id, "--json"], "${root}")

  // ---------- runs of the software factory ----------

  // Start the run of a spec, or of several in one run (specs: their ids, spec_list names them; a big feature in pieces,
  // a sprint): each spec through every station before the next, one bill. Its stations are worked by the team (empty:
  // the project's) in a process of its own; it stops at the gates for an answer (run_answer). assign is the tech lead's
  // choice of who works a role (developer=dev-017,qa=qa-002). A paid provider's spending is confirmed by the user twice
  // in the editor (`waiting: spending`), never here. Asks the user first (confirm: the token of a preview, when the
  // client cannot ask). The factory is for big work: a small or medium task is the agent's own (nuclear_doc("task-size")).
  runStart(project: string, spec: string = "", team: string = "", assign: string = "", specs: string[]? = null, confirm: string = "", ctx: Context? = null) string
    root = projectOf(project)
    if root == null
      return refused("${project} is not inside a Synapsis project (no config.nuc)")
    ids: string[] = [...(spec.isEmpty ? [] as string[] : [spec]), ...(specs ?? [])].filter((s: string) => not s.trim().isEmpty)
    bad = optionLike([...ids, team, assign])
    if bad != null or ids.isEmpty
      return refused("a spec's id is needed, or several in specs (no value starts with -)")
    files: string[] = []
    for id in ids
      said = ~builderRun(["spec", "show", id, "--json"], "${root}")
      shown = jsonOf(said)
      if shown == null or shown!["path"] == null
        return said
      files.add("${Path(root, "${shown!["path"]}", "spec.md")}")
    args = ["run", ...files, "--detach", ...(team.isEmpty ? [] as string[] : ["--team", team]), ...(assign.isEmpty ? [] as string[] : ["--assign", assign])]
    listed = ids.join("`, `")
    named = ids.length == 1 ? "the spec `${ids[0]}`" : "the specs `${listed}` in one run"
    change = "Start the run of ${named} in ${root}${team.isEmpty ? " by the project's team" : " by the team ${team}"}${assign.isEmpty ? "" : " (${assign})"}: the factory's stations work it and stop at each gate for an answer."
    ~builderChange(ctx, "run_start", { "project": "${root}", "specs": ids, "team": team, "assign": assign }, change, confirm, args, "${root}")

  // The runs of a project: id, title, status, cost, each station's status.
  runs(project: string) string
    root = projectOf(project)
    if root == null
      return refused("${project} is not inside a Synapsis project (no config.nuc)")
    ~builderRun(["runs", "--json"], "${root}")

  // A run's file: every station and step, who did it, its decisions, the files it wrote, the cost; `waiting` is the
  // question it waits on.
  runFile(project: string, id: string) string
    root = projectOf(project)
    if root == null
      return refused("${project} is not inside a Synapsis project (no config.nuc)")
    if id.startsWith("-") or id.isEmpty
      return refused("'${id}' is not a run's id")
    ~builderRun(["run", "show", id, "--json"], "${root}")

  // A run's journal (markdown): everything the roles did, station by station.
  runJournal(project: string, id: string) string
    root = projectOf(project)
    if root == null
      return refused("${project} is not inside a Synapsis project (no config.nuc)")
    if id.startsWith("-") or id.isEmpty
      return refused("'${id}' is not a run's id")
    ~builderRun(["run", "journal", id], "${root}")

  // Answer the question a run waits on, with the user's own answer: approve (go on), change (text: what should
  // change; the station works again), stop (the run waits), or yes / no for QA's plan. The spending and the delivery
  // are answered in the editor. Asks the user first (confirm: the token of a preview, when the client cannot ask).
  runAnswer(project: string, id: string, answer: string, text: string = "", confirm: string = "", ctx: Context? = null) string
    root = projectOf(project)
    if root == null
      return refused("${project} is not inside a Synapsis project (no config.nuc)")
    if not (answer in ["approve", "change", "stop", "yes", "no"])
      return refused("'${answer}' is not an answer: approve, change, stop, yes or no")
    if id.startsWith("-") or id.isEmpty or text.startsWith("--")
      return refused("'${id}' is not a run's id (and a text never starts with --)")
    args = ["run", "answer", id, "--answer", answer, ...(text.isEmpty ? [] as string[] : ["--text", text]), "--detach"]
    ~builderChange(ctx, "run_answer", { "project": "${root}", "id": id, "answer": answer, "text": text }, "Answer the run `${id}` of ${root}: ${answer}${text.isEmpty ? "" : " (\"${text}\")"}.", confirm, args, "${root}")

  // Go on with a run that stopped (interrupted, or waiting with nothing to answer), in a process of its own. Asks the
  // user first (confirm: the token of a preview, when the client cannot ask).
  runResume(project: string, id: string, confirm: string = "", ctx: Context? = null) string
    root = projectOf(project)
    if root == null
      return refused("${project} is not inside a Synapsis project (no config.nuc)")
    if id.startsWith("-") or id.isEmpty
      return refused("'${id}' is not a run's id")
    ~builderChange(ctx, "run_resume", { "project": "${root}", "id": id }, "Go on with the run `${id}` of ${root} from where it stopped.", confirm, ["run", "--resume", id, "--detach"], "${root}")

  // Run a run again from the station that failed (or from station, or from one step and every step after it),
  // optionally by another team: what those stations wrote is undone first. Asks the user first (confirm: the token of
  // a preview, when the client cannot ask).
  runRetry(project: string, id: string, station: string = "", step: string = "", team: string = "", confirm: string = "", ctx: Context? = null) string
    root = projectOf(project)
    if root == null
      return refused("${project} is not inside a Synapsis project (no config.nuc)")
    bad = optionLike([id, station, step, team])
    if bad != null or id.isEmpty
      return refused("a run's id is needed (no value starts with -)")
    args = ["retry", id, ...(station.isEmpty ? [] as string[] : ["--from", station]), ...(step.isEmpty ? [] as string[] : ["--step", step]), ...(team.isEmpty ? [] as string[] : ["--team", team]), "--detach"]
    start = step.isEmpty ? (station.isEmpty ? "the station that failed" : "the station ${station}") : "the step ${step}"
    ~builderChange(ctx, "run_retry", { "project": "${root}", "id": id, "station": station, "step": step, "team": team }, "Run `${id}` of ${root} again from ${start}${team.isEmpty ? "" : " by the team ${team}"}: what it wrote from there is undone first.", confirm, args, "${root}")

  // Run a run again from the start: every file it wrote goes back first. Asks the user first (confirm: the token of a
  // preview, when the client cannot ask).
  runRestart(project: string, id: string, confirm: string = "", ctx: Context? = null) string
    root = projectOf(project)
    if root == null
      return refused("${project} is not inside a Synapsis project (no config.nuc)")
    if id.startsWith("-") or id.isEmpty
      return refused("'${id}' is not a run's id")
    ~builderChange(ctx, "run_restart", { "project": "${root}", "id": id }, "Run `${id}` of ${root} again from the start: every file it wrote goes back first.", confirm, ["restart", id, "--detach"], "${root}")

  // Stop a run's process (a run that asks a question just waits). Asks the user first (confirm: the token of a
  // preview, when the client cannot ask).
  runStop(project: string, id: string, confirm: string = "", ctx: Context? = null) string
    root = projectOf(project)
    if root == null
      return refused("${project} is not inside a Synapsis project (no config.nuc)")
    if id.startsWith("-") or id.isEmpty
      return refused("'${id}' is not a run's id")
    ~builderChange(ctx, "run_stop", { "project": "${root}", "id": id }, "Stop the run `${id}` of ${root}.", confirm, ["run", "stop", id, "--json"], "${root}")

  // ---------- QA's checks of a run ----------

  // A run's checks (checks.json of its spec): QA's plan and the user's, each one's station, who runs it, its state.
  checks(project: string, id: string) string
    root = projectOf(project)
    if root == null
      return refused("${project} is not inside a Synapsis project (no config.nuc)")
    if id.startsWith("-") or id.isEmpty
      return refused("'${id}' is not a run's id")
    ~builderRun(["checks", id, "list", "--json"], "${root}")

  // Switch a check of a run on (on true) or off. Asks the user first (confirm: the token of a preview, when the client
  // cannot ask).
  checkSwitch(project: string, id: string, check: string, on: boolean, confirm: string = "", ctx: Context? = null) string
    root = projectOf(project)
    if root == null
      return refused("${project} is not inside a Synapsis project (no config.nuc)")
    bad = optionLike([id, check])
    if bad != null or id.isEmpty or check.isEmpty
      return refused("a run's id and a check are needed (neither starts with -)")
    ~builderChange(ctx, "check_switch", { "project": "${root}", "id": id, "check": check, "on": on }, "Switch the check `${check}` of the run `${id}` ${on ? "on" : "off"}.", confirm, ["checks", id, on ? "on" : "off", check, "--json"], "${root}")

  // Add a check to a run's plan: its title, its station, who runs it (user, or role: the station's role with prompt).
  // Asks the user first (confirm: the token of a preview, when the client cannot ask).
  checkAdd(project: string, id: string, title: string, station: string = "quality", by: string = "user", prompt: string = "", confirm: string = "", ctx: Context? = null) string
    root = projectOf(project)
    if root == null
      return refused("${project} is not inside a Synapsis project (no config.nuc)")
    if not (by in ["user", "role"])
      return refused("'${by}' is not who runs a check: user or role")
    bad = optionLike([id, title, station, prompt])
    if bad != null or id.isEmpty or title.isEmpty
      return refused("a run's id and a title are needed (no value starts with -)")
    args = ["checks", id, "add", "--title", title, "--station", station, "--by", by, ...(prompt.isEmpty ? [] as string[] : ["--prompt", prompt]), "--json"]
    ~builderChange(ctx, "check_add", { "project": "${root}", "id": id, "title": title, "station": station, "by": by, "prompt": prompt }, "Add the check \"${title}\" to the run `${id}` (station ${station}, run by the ${by}).", confirm, args, "${root}")

  // Mark a check of a run passed, failed or skipped. Asks the user first (confirm: the token of a preview, when the
  // client cannot ask).
  checkMark(project: string, id: string, check: string, status: string, confirm: string = "", ctx: Context? = null) string
    root = projectOf(project)
    if root == null
      return refused("${project} is not inside a Synapsis project (no config.nuc)")
    if not (status in ["passed", "failed", "skipped"])
      return refused("'${status}' is not a check's state: passed, failed or skipped")
    bad = optionLike([id, check])
    if bad != null or id.isEmpty or check.isEmpty
      return refused("a run's id and a check are needed (neither starts with -)")
    ~builderChange(ctx, "check_mark", { "project": "${root}", "id": id, "check": check, "status": status }, "Mark the check `${check}` of the run `${id}` ${status}.", confirm, ["checks", id, "mark", check, status, "--json"], "${root}")

  // ---------- more of the teams ----------

  // Copy a team under a new name (name: empty, the next free one). Asks the user first (confirm: the token of a
  // preview, when the client cannot ask).
  teamDuplicate(team: string, name: string = "", confirm: string = "", ctx: Context? = null) string
    bad = optionLike([team, name])
    if bad != null or team.isEmpty
      return refused("'${team}' is not a team's id")
    named = name.isEmpty ? "" : " as ${name}"
    ~builderChange(ctx, "team_duplicate", { "team": team, "name": name }, "Copy the team `${team}`${named}.", confirm, ["team", "duplicate", team, ...(name.isEmpty ? [] as string[] : ["--name", name]), "--json"])

  // Make a team the default one (the team of a project that names none). Asks the user first (confirm: the token of a
  // preview, when the client cannot ask).
  teamDefault(team: string, confirm: string = "", ctx: Context? = null) string
    if team.startsWith("-") or team.isEmpty
      return refused("'${team}' is not a team's id")
    ~builderChange(ctx, "team_default", { "team": team }, "Make `${team}` the default team.", confirm, ["team", "default", team])

  // Export a team to a JSON file (file: its path). Asks the user first (confirm: the token of a preview, when the
  // client cannot ask).
  teamExport(team: string, file: string, confirm: string = "", ctx: Context? = null) string
    bad = optionLike([team, file])
    if bad != null or team.isEmpty or file.isEmpty
      return refused("a team's id and a file are needed (neither starts with -)")
    target = Path(file).expanduser().resolve()
    ~builderChange(ctx, "team_export", { "team": team, "file": "${target}" }, "Export the team `${team}` to ${target}.", confirm, ["team", "export", team, "${target}"])

  // Import a team from a JSON file (an id in use gets the next free one). Asks the user first (confirm: the token of a
  // preview, when the client cannot ask).
  teamImport(file: string, confirm: string = "", ctx: Context? = null) string
    if file.startsWith("-") or not Path(file).expanduser().isFile()
      return refused("${file} is not a file")
    source = Path(file).expanduser().resolve()
    ~builderChange(ctx, "team_import", { "file": "${source}" }, "Import the team of ${source}.", confirm, ["team", "import", "${source}"])

  // Give a team a logo (image: a .png, .svg or .jpg of 1 MB at most) or take it away (clear true). Asks the user first
  // (confirm: the token of a preview, when the client cannot ask).
  teamLogo(team: string, image: string = "", clear: boolean = false, confirm: string = "", ctx: Context? = null) string
    if team.startsWith("-") or team.isEmpty
      return refused("'${team}' is not a team's id")
    if not clear and (image.startsWith("-") or not Path(image).expanduser().isFile())
      return refused("'${image}' is not an image file (or say clear)")
    picture = clear ? "" : "${Path(image).expanduser().resolve()}"
    change = clear ? "Take the logo of the team `${team}` away." : "Give the team `${team}` the logo ${picture}."
    ~builderChange(ctx, "team_logo", { "team": team, "image": picture, "clear": clear }, change, confirm, ["team", "logo", team, ...(clear ? ["--clear"] : [picture]), "--json"])

  // The employees of each role that fit a purpose and skills (library ids), each with why: who to hire.
  teamSuggest(purpose: string = "", skills: string[]? = null, lang: string = "en", limit: int = 0) string
    bad = optionLike([purpose, lang, ...(skills ?? [])])
    if bad != null
      return refused("'${bad}' starts with -")
    ~builderRun(["team", "suggest", ...(purpose.isEmpty ? [] as string[] : ["--purpose", purpose]), ...(skills == null ? [] as string[] : ["--skills", skills!.join(",")]), "--lang", lang, ...(limit > 0 ? ["--limit", "${limit}"] : [] as string[]), "--json"])

  // Five satirical names for a team with that purpose.
  teamNameSuggest(purpose: string = "", lang: string = "en") string
    bad = optionLike([purpose, lang])
    if bad != null
      return refused("'${bad}' starts with -")
    ~builderRun(["team", "name-suggest", ...(purpose.isEmpty ? [] as string[] : ["--purpose", purpose]), "--lang", lang, "--json"])

  // Whether a team has a member of each role a project's stations need.
  teamRunnable(project: string, team: string) string
    root = projectOf(project)
    if root == null
      return refused("${project} is not inside a Synapsis project (no config.nuc)")
    if team.startsWith("-") or team.isEmpty
      return refused("'${team}' is not a team's id")
    ~builderRun(["team", "runnable", team, "--json"], "${root}")

  // The roster: the employees of each role a member can be (their names, portraits, personalities).
  teamRoster(lang: string = "en") string
    if lang.startsWith("-")
      return refused("'${lang}' is not a language")
    ~builderRun(["team", "roster", "--lang", lang])

  // The temperaments a member can have (how it talks).
  teamTemperaments() string
    ~builderRun(["team", "temperaments", "--json"])

  // ---------- the skills library ----------

  // The library of skills and agents; with team, its skills and its own; with member, every skill it gets and where
  // each comes from.
  skillsList(team: string = "", member: string = "", lang: string = "en") string
    bad = optionLike([team, member, lang])
    if bad != null
      return refused("'${bad}' starts with -")
    ~builderRun(["skills", "list", ...(team.isEmpty ? [] as string[] : ["--team", team]), ...(member.isEmpty ? [] as string[] : ["--member", member]), "--lang", lang, "--json"])

  // A skill's SKILL.md as that place sees it (the member's own, the team's own, the library's), where it comes from
  // and whether it can be changed there.
  skillsShow(id: string, team: string = "", member: string = "", lang: string = "en") string
    bad = optionLike([id, team, member, lang])
    if bad != null or id.isEmpty
      return refused("a skill's id is needed (no value starts with -)")
    ~builderRun(["skills", "show", id, ...(team.isEmpty ? [] as string[] : ["--team", team]), ...(member.isEmpty ? [] as string[] : ["--member", member]), "--lang", lang, "--json"])

  // Copy a skill as the team's own (every member inherits it) or the member's, with the same id: it wins over the one
  // it came from (a library skill is read-only: clone it to change it). Asks the user first (confirm: the token of a
  // preview, when the client cannot ask).
  skillsClone(id: string, team: string, member: string = "", confirm: string = "", ctx: Context? = null) string
    bad = optionLike([id, team, member])
    if bad != null or id.isEmpty or team.isEmpty
      return refused("a skill's id and a team are needed (no value starts with -)")
    whose = member.isEmpty ? "the team `${team}`" : "the member `${member}` of the team `${team}`"
    ~builderChange(ctx, "skills_clone", { "id": id, "team": team, "member": member }, "Copy the skill `${id}` as ${whose}'s own.", confirm, ["skills", "clone", id, "--team", team, ...(member.isEmpty ? [] as string[] : ["--member", member]), "--json"])

  // Write a new own skill of a team (or of a member): text is its whole SKILL.md, with its front matter (name, title,
  // description, title_es, description_es, kind, tags). Asks the user first (confirm: the token of a preview, when the
  // client cannot ask).
  skillsCreate(team: string, text: string, member: string = "", confirm: string = "", ctx: Context? = null) string
    bad = optionLike([team, member])
    if bad != null or team.isEmpty or not text.trim().startsWith("---")
      return refused("a team is needed and text is a whole SKILL.md, from its front matter (---)")
    whose = member.isEmpty ? "the team `${team}`" : "the member `${member}` of the team `${team}`"
    ~builderChange(ctx, "skills_create", { "team": team, "text": text, "member": member }, "Write a new skill of ${whose} (${text.trim().split("\n").length} lines).", confirm, ["skills", "create", "--team", team, ...(member.isEmpty ? [] as string[] : ["--member", member]), "--json"], null, text)

  // Replace an own skill of a team (or of a member): text is its whole SKILL.md. Asks the user first (confirm: the
  // token of a preview, when the client cannot ask).
  skillsUpdate(id: string, team: string, text: string, member: string = "", confirm: string = "", ctx: Context? = null) string
    bad = optionLike([id, team, member])
    if bad != null or id.isEmpty or team.isEmpty or not text.trim().startsWith("---")
      return refused("a skill's id and a team are needed, and text is a whole SKILL.md, from its front matter (---)")
    whose = member.isEmpty ? "the team `${team}`" : "the member `${member}` of the team `${team}`"
    ~builderChange(ctx, "skills_update", { "id": id, "team": team, "text": text, "member": member }, "Replace the skill `${id}` of ${whose} (${text.trim().split("\n").length} lines).", confirm, ["skills", "update", id, "--team", team, ...(member.isEmpty ? [] as string[] : ["--member", member]), "--json"], null, text)

  // Delete an own skill of a team (or of a member). Asks the user first (confirm: the token of a preview, when the
  // client cannot ask).
  skillsDelete(id: string, team: string, member: string = "", confirm: string = "", ctx: Context? = null) string
    bad = optionLike([id, team, member])
    if bad != null or id.isEmpty or team.isEmpty
      return refused("a skill's id and a team are needed (no value starts with -)")
    whose = member.isEmpty ? "the team `${team}`" : "the member `${member}` of the team `${team}`"
    ~builderChange(ctx, "skills_delete", { "id": id, "team": team, "member": member }, "Delete the skill `${id}` of ${whose}.", confirm, ["skills", "delete", id, "--team", team, ...(member.isEmpty ? [] as string[] : ["--member", member]), "--json"])

  // ---------- the line, the CI file, the connections, the reports, who can work a member ----------

  // A project's line (.nuclear/builder.json) with its defaults: {line, own (the file's own keys), keys}.
  lineShow(project: string) string
    root = projectOf(project)
    if root == null
      return refused("${project} is not inside a Synapsis project (no config.nuc)")
    ~builderRun(["line", "show", "--json"], "${root}")

  // Set keys of a project's line (values: {key: its JSON value}; line_show lists the keys). Asks the user first
  // (confirm: the token of a preview, when the client cannot ask).
  lineSet(project: string, values: <string, any>, confirm: string = "", ctx: Context? = null) string
    root = projectOf(project)
    if root == null
      return refused("${project} is not inside a Synapsis project (no config.nuc)")
    if values.isEmpty or values.keys.any((k: string) => k.startsWith("-") or "=" in k)
      return refused("say which keys change: {key: value}")
    pairs = values.keys.map((k: string) => "${k}=${Json.encode(values[k])}")
    ~builderChange(ctx, "line_set", { "project": "${root}", "values": values }, "Set the line of ${root}: ${pairs.join("; ")}.", confirm, ["line", "set", ...pairs, "--json"], "${root}")

  // Write the CI file of a project that runs its line (host: github, gitlab or bitbucket). Asks the user first
  // (confirm: the token of a preview, when the client cannot ask).
  ciExport(project: string, host: string, confirm: string = "", ctx: Context? = null) string
    root = projectOf(project)
    if root == null
      return refused("${project} is not inside a Synapsis project (no config.nuc)")
    if not (host in ["github", "gitlab", "bitbucket"])
      return refused("'${host}' is not a CI host: github, gitlab or bitbucket")
    ~builderChange(ctx, "ci_export", { "project": "${root}", "host": host }, "Write the ${host} CI file of ${root}, which runs nuclear-builder ci.", confirm, ["export", host, "--json"], "${root}")

  // Check the connections of a team (empty: the project's): each member's agent or provider answers.
  connectionsCheck(project: string, team: string = "") string
    root = projectOf(project)
    if root == null
      return refused("${project} is not inside a Synapsis project (no config.nuc)")
    if team.startsWith("-")
      return refused("'${team}' is not a team's id")
    ~builderRun(["connections", ...(team.isEmpty ? [] as string[] : ["--team", team]), "--json"], "${root}")

  // The factory's reports from its ledger, every project of this machine: view one of bill, throughput, cycle,
  // burndown, flow, waiting, quality, people, indicators (empty: all); project a name or folder, team and member ids;
  // since and until dates YYYY-MM-DD; by day or week.
  metrics(view: string = "", project: string = "", team: string = "", member: string = "", since: string = "", until: string = "", by: string = "day") string
    flags: <string, string> = { "--view": view, "--project": project, "--team": team, "--member": member, "--from": since, "--to": until, "--by": by }
    given = flags.keys.filter((k) => not flags[k]!.isEmpty)
    bad = optionLike(given.map((k) => flags[k]!))
    if bad != null
      return refused("'${bad}' starts with -")
    args = ["metrics"]
    for k in given
      args = [...args, k, flags[k]!]
    ~builderRun([...args, "--json"])

  // The agents that can work a member or answer a conversation on this machine ({id, kind, provider, label, models,
  // defaultModel, available, why}).
  agentsList(project: string = "") string
    if project.startsWith("-")
      return refused("'${project}' is not a folder")
    ~builderRun(["agents", "--json", ...(project.isEmpty ? [] as string[] : ["--root", project])])

  // The models of each provider that can work here (provider: only one's).
  modelsList(provider: string = "", project: string = "") string
    bad = optionLike([provider, project])
    if bad != null
      return refused("'${bad}' starts with -")
    ~builderRun(["models", ...(provider.isEmpty ? [] as string[] : ["--provider", provider]), "--json", ...(project.isEmpty ? [] as string[] : ["--root", project])])

  // Every tool, in the order a client lists them.
  all() any[]
    [
      workspaceCreate, workspaceShow, workspaceEdit, workspaceDelete, appAdd, appRename, appRemove,
      projectMigrate, projectTest,
      specCreate, specList, specShow, specEdit,
      teamList, teamShow, teamCreate, teamEdit, teamDelete, memberAdd, memberEdit, memberRemove, skillsSet,
      specMove, specMigrate, specDelete, specAccept, specDiscard,
      runStart, runs, runFile, runJournal, runAnswer, runResume, runRetry, runRestart, runStop,
      checks, checkSwitch, checkAdd, checkMark,
      teamDuplicate, teamDefault, teamExport, teamImport, teamLogo, teamSuggest, teamNameSuggest, teamRunnable, teamRoster, teamTemperaments,
      skillsList, skillsShow, skillsClone, skillsCreate, skillsUpdate, skillsDelete,
      lineShow, lineSet, ciExport, connectionsCheck, metrics, agentsList, modelsList,
    ]

LOCAL_STANDBY = "no member of the local kind: the local models are on standby (ADR-platform-0013); a member is worked by an agent (kind agent) or an API provider (kind api)"

// How many tests passed and failed, read from what a target's runner prints: [passed, failed]. Each runner says it
// its own way (`3 passed, 1 failed` in pytest and vitest, `ℹ pass 3` / `ℹ fail 1` in node:test, `+3 -1:` in
// flutter test); a count it does not say is 0.
countsOfTests(output: string) int[]
  last = (pattern: string) int
    found = Regex(pattern).findAll(output)
    found.isEmpty ? 0 : ("${found.last[1]}".toInt() ?? 0)
  node = [last(r"ℹ pass (\d+)"), last(r"ℹ fail (\d+)")]
  if node[0] + node[1] > 0
    return node
  words = [last(r"(\d+) passed"), last(r"(\d+) failed") + last(r"(\d+) errors?\b")]
  if words[0] + words[1] > 0
    return words
  [last(r"\+(\d+)(?: ~\d+)?(?: -\d+)?: "), last(r"\+\d+(?: ~\d+)? -(\d+): ")]

// A JSON object of a command's answer, or null.
jsonOf(text: string) <string, any>?
  try
    found = json.loads(text)
    return isinstance(found, dict) ? found : null
  catch e
    return null
