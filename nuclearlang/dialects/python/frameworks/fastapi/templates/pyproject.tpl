# Generated by NuclearLang for Synapsis. Do not edit: it changes when the .nuc files change.
# The dependencies are the runtime and the plugins config.nuc enables (plugins(...)).
[project]
name = "{{project}}"
version = "{{app.version|toml}}"
{{#app.description}}
description = "{{app.description|toml}}"
{{/app.description}}
requires-python = ">=3.12"
dependencies = [
    "synapsis-py",
    "uvicorn>=0.30",
{{#plugins.packages}}
    "{{name|toml}}{{version|toml}}",
{{/plugins.packages}}
{{#dependencies}}
    "{{name|toml}}{{#path}} @ {{url|toml}}{{/path}}{{^path}}{{version|toml}}{{/path}}",
{{/dependencies}}
]

[project.optional-dependencies]
test = ["synapsis-py[test]"]

[tool.pytest.ini_options]
pythonpath = ["."]
python_files = ["*_test.py", "test_*.py"]
asyncio_mode = "auto"
asyncio_default_fixture_loop_scope = "function"

[tool.pyright]
typeCheckingMode = "strict"
pythonVersion = "3.12"
