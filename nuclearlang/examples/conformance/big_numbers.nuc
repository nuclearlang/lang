// The exact numbers: bigint (a whole number of any size) and bigdouble (an exact decimal), their literals,
// operators, division, conversions, parsing and text (ADR-lang-0015).
factorial(n: int) bigint
  total: bigint = 1
  for i in 1..n + 1
    total *= i.toBigInt()
  total

half(x: bigdouble) bigdouble = x / 2

zero() bigint = 0

fails(text: string) string
  try
    big: bigint = 1
    big ** text.toInt()!
    "no error"
  catch e
    "error"

main() void
  // bigint: no size limit, exact
  print("factorial", factorial(30))
  print("digits", factorial(50).toString().length)
  huge: bigint = 12345678901234567890
  print("huge", huge, huge + 1, huge * huge, -huge)
  two: bigint = 2
  print("power", two ** 100, two ** 0)
  print("intdiv", 7.toBigInt() ~/ 2, -7.toBigInt() ~/ 2, huge ~/ 1000)
  print("rem", 7.toBigInt() % 3, -7.toBigInt() % 3, huge % 97)
  print("compare", huge > two, huge == huge + 0, two < 3, huge.compareTo(two), two.compareTo(two), zero() == 0)
  print("abs sign", (-huge).abs(), (-huge).sign(), zero().sign(), two.sign())
  // bigdouble: exact decimals
  a: bigdouble = 0.1
  b: bigdouble = 0.2
  print("exact", a + b, a + b == 0.3, a * 3, a - b)
  price: bigdouble = 19.99
  print("money", price * 3, (price * 3).toFixed(2), price.roundTo(1), price.toFixed(0))
  print("div", half(1), a / 3, 1.toBigDouble() / 8, 2.toBigDouble() / 3)
  print("intdiv rem", price ~/ 2, price % 2, -price % 2)
  print("round", price.round(), price.floor(), price.ceil(), price.truncate(), (-price).floor(), (-price).round())
  print("power", a ** 3, price ** 2)
  print("text", 2.toBigDouble(), "${price}", (-a).toString(), 100.toBigDouble(), 1.5e-3.toBigDouble())
  // parsing
  print("parse", "123456789012345678901234567890".toBigInt(), " -42 ".toBigInt(), "1.5".toBigInt(), "abc".toBigInt())
  print("parse", "3.14159".toBigDouble(), "-0.5e2".toBigDouble(), "1e-3".toBigDouble(), "1.".toBigDouble(), "x".toBigDouble())
  parsed = "77".toBigInt() ?? 0
  print("fallback", parsed + 1, ("no".toBigInt() ?? 5) + 1)
  // conversions in and out
  print("toInt", two.toInt(), huge.toInt(), price.toInt(), 9007199254740991.toBigInt().toInt())
  print("toDouble", two.toDouble(), price.toDouble(), huge.toBigDouble(), price.toBigInt())
  print("from double", 0.1.toBigDouble(), 2.5.toBigInt(), -2.5.toBigInt())
  print("errors", fails("2"), fails("-1"))
  values: bigint[] = [3, 1, 2]
  print("list", values.sorted().map((v) => v.toString()).join(","), values.length)
  // collections compare values; a literal argument takes the exact type
  prices: bigdouble[] = [0.1, 0.2]
  same: bigdouble[] = [a, b]
  other: bigdouble[] = [a, a]
  print("lists", prices == same, prices != same, prices == other, 0.2 in prices, 0.3 in prices, a + b in [0.3])
  print("in", 2 in values, 5 in values, huge in [huge])
  totals: <string, bigdouble> = { "x": a + b }
  wanted: <string, bigdouble> = { "x": 0.3 }
  print("maps", totals == wanted, totals != wanted)
  print("args", huge.compareTo(5), two.compareTo(2), price.compareTo(20), price.compareTo(19.99), a.compareTo(0.05))
