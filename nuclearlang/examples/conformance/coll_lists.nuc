// Lists: literals, index, mutation, queries, transformations, sorting, slices, spread, nested lists,
// the empty list, equality, copies.
Item(name: string, price: double, qty: int)

main() void
  xs = [5, 3, 8, 1]
  empty: int[] = []
  print("basics", xs.length, xs.isEmpty, empty.isEmpty, xs.first, xs.last, xs[1], xs[xs.length - 1])
  xs.add(9)
  xs.addAll([2, 7])
  xs.insert(0, 4)
  xs[1] = 50
  print("mutate", xs.join(","))
  print("remove", xs.remove(50), xs.remove(99), xs.removeAt(0), xs.removeLast(), xs.join(","))
  print("search", xs.indexOf(8), xs.indexOf(99), 8 in xs, 99 in xs, [1, 2, 1].lastIndexOf(1), [1, 2, 1].indexOf(1))
  print("empty", empty.sum(), empty.min(), empty.max(), empty.join(","), empty.map((x) => x * 2).length, empty.find((x) => x > 0))
  print("empty-q", empty.any((x) => x > 0), empty.all((x) => x > 0), empty.count((x) => x > 0), empty.reduce(10, (a, b) => a + b))
  print("map", xs.map((x) => x * x).join(","), xs.map((x) => "<${x}>").join(""))
  print("filter", xs.filter((x) => x > 2).join(","), xs.filter((x) => x > 100).length)
  print("find", xs.find((x) => x > 5), xs.find((x) => x > 100), xs.findIndex((x) => x == 1), xs.findIndex((x) => x > 100))
  print("test", xs.any((x) => x == 8), xs.all((x) => x > 0), xs.all((x) => x > 2), xs.count((x) => x % 2 == 1))
  print("fold", xs.reduce(0, (a, b) => a + b), xs.reduce(1, (a, b) => a * b), xs.reduce("", (a, b) => "${a}${b}"), xs.sum(), xs.min(), xs.max())
  print("slice", xs.slice(1, 3).join(","), xs.slice(2).join(","), xs.take(2).join(","), xs.skip(2).join(","), xs.take(0).length, xs.take(99).length, xs.skip(99).length)
  print("order", xs.sorted().join(","), xs.reversed().join(","), xs.sorted().reversed().join(","), xs.join(","))
  ys = xs.copy()
  ys.sort()
  ys.reverse()
  print("in-place", ys.join(","), xs.join(","))
  words = ["pear", "fig", "banana", "kiwi"]
  print("sortBy", words.sortedBy((w) => w.length).join(","), words.sorted().join(","), words.sortedBy((w) => w[w.length - 1]).join(","))
  words.sortBy((w) => -w.length)
  print("sortBy-in-place", words.join(","))
  print("unique", [3, 1, 3, 2, 1].unique().join(","), ["a", "b", "a"].unique().length)
  print("flatten", [[1, 2], [], [3]].flatten().join(","), [[1], [2]].flatten().length)
  print("spread", [...xs, 0].length, [0, ...xs.take(2), ...[7, 7]].join(","), [...empty].length)
  on = xs.length > 2
  print("if-item", [1, if on 2, 3].join(","), [1, if not on 2, 3].join(","))
  grid = [[1, 2], [3, 4]]
  grid[1][0] = 30
  grid[0].add(9)
  print("nested", grid[1][0], grid[0].length, grid.map((row) => row.sum()).join(","))
  print("equal", [1, 2] == [1, 2], [1, 2] == [2, 1], [1, 2] != [1, 2, 3], xs.copy() == xs)
  items = [Item("pen", 1.5, 10), Item("book", 12.0, 2), Item("bag", 30.0, 1)]
  total = items.map((i) => i.price * i.qty).sum()
  cheap = items.filter((i) => i.price < 20).map((i) => i.name)
  print("objects", total, cheap.join(","), items.sortedBy((i) => i.price).last.name, items.find((i) => i.qty == 2)!.name)
  groups = [1, 2, 3, 4, 5, 6].groupBy((x) => x % 3)
  print("group", groups[0]!.join(","), groups[1]!.join(","), groups[2]!.join(","), groups.length)
  print("range", (0..4).join(","), (0..4).map((i) => i * i).sum(), (2..5).filter((i) => i % 2 == 0).length)
  [a, b, ...rest] = xs
  print("pattern", a, b, rest.length)
  doubles = [1.5, 2.5]
  print("doubles", doubles.sum(), doubles.max(), doubles.map((d) => d * 2).join(","))
  strings = ["b", "a", "c"]
  print("strings", strings.min(), strings.max(), strings.sorted().join(""), "a" in strings)
  matrix = (0..3).map((i) => (0..3).map((j) => i * j))
  print("matrix", matrix.map((row) => row.join(" ")).join(" / "))
