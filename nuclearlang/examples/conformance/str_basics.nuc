// Strings: literals, escapes, interpolation, multi-line text, raw text, concatenation, comparison, members.
User(name: string, age: int)

main() void
  name = "Ana"
  n = 3
  print("quotes", 'single', "double", 'it"s', "it's")
  print("escapes", "a\tb", "back\\slash", "quote\"in", 'quote\'in', "dollar\$x", "new\\n")
  print("lines", "one\ntwo".split("\n").length, "tab\there".indexOf("\t"))
  print("unicode", "\u{48}\u{49}", "ñandú", "日本".length, "é".length)
  print("interp", "Hi ${name}", "${n} + ${n} = ${n + n}", "${name.upper()}!", "${n > 2 ? "big" : "small"}")
  u = User("Luis", 30)
  print("member", "${u.name} is ${u.age}", "${u.name.length}", "[${[1, 2].join("-")}]")
  print("nested", "a${"b${"c"}"}d", "${"x".repeat(n)}")
  print("types", "${1.5}", "${true}", "${2 * 3}", "${10 / 4}")
  text = """
    first line
      indented
    last line
  """
  print("multi", text.trim().split("\n").length, text.trim().split("\n")[1])
  print("raw", r"\d+\n", r"\d+\n".length, r"${name}")
  print("concat", "a" + "b" + "c", name + " " + name, "n=" + n.toString())
  s = ""
  for i in 0..4
    s += "${i}"
  print("build", s, s.length, s.isEmpty, "".isEmpty)
  print("case", "Hello".upper(), "Hello".lower(), "hello world".upper())
  print("trim", "[${"  x  ".trim()}]", "[${"  x  ".trimStart()}]", "[${"  x  ".trimEnd()}]")
  print("search", "hello".indexOf("l"), "hello".lastIndexOf("l"), "hello".indexOf("z"), "ell" in "hello", "x" in "hello")
  print("edges", "hello".startsWith("he"), "hello".endsWith("lo"), "hello".startsWith("lo"), "hello".startsWith(""))
  print("sub", "hello".substring(1, 3), "hello".substring(2), "hello"[0], "hello"[4], "hello".substring(0, 0).isEmpty)
  print("clamp", "hello".substring(3, 99), "[${"hello".substring(9)}]", "[${"hello".substring(3, 1)}]", "hello".substring(-3), "hello".substring(1, -1))
  print("split", "a,b,c".split(",").join("|"), "a,b,,c".split(",").length, "abc".chars().join("-"), "abc".split(",").length)
  print("replace", "a-b-c".replace("-", "+"), "a-b-c".replaceAll("-", "+"), "aaa".replaceAll("a", "bb"), "abc".replace("x", "y"))
  print("pad", "7".padStart(3, "0"), "7".padEnd(3, "."), "[${"ab".padStart(5)}]", "abcdef".padStart(3, "0"))
  print("repeat", "ab".repeat(3), "ab".repeat(0).isEmpty, "-".repeat(5))
  print("codes", "A".codeAt(0), "abc".codeAt(2), String.fromCodes([72, 105]))
  print("parse", "42".toInt(), "-7".toInt(), "abc".toInt(), "3.5".toDouble(), "x".toDouble(), "12abc".toInt())
  print("compare", "a".compareTo("b"), "b".compareTo("a"), "a".compareTo("a"), u.name == "Luis", u.name != "luis")
  words = "the quick brown fox".split(" ")
  print("words", words.length, words.map((w) => w[0].upper() + w.substring(1)).join(" "), words.sorted().join(","))
  print("reverse", "hello".chars().reversed().join(""), "level".chars().reversed().join("") == "level")
