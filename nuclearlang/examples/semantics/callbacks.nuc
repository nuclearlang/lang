// A function type may name only the types of its parameters.
apply(xs: int[], f: (int) => int) int[] = xs.map((x) => f(x))

main() void
  print(apply([1, 2], (x) => x * 10).join(","))
  // a conditional body where the target writes a condition
  strict = false
  print([1, 2, 3, 4].filter((x) => strict ? x > 2 : x % 2 == 0).join(","))
